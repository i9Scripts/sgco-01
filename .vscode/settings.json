{
  "workbench.colorTheme": "Dracula Theme",
  "symbols.hidesExplorerArrows": false,
  "workbench.iconTheme": "symbols",
  "editor.fontFamily": "'Quicksand', monospace",

  "editor.fontLigatures": true,
  "editor.letterSpacing": 0.3,
  "editor.fontSize": 14,
  "editor.fontWeight": "400",
  "editor.lineHeight": 1.8,
  "editor.smoothScrolling": true,
  "editor.rulers": [80, 140],
  "editor.tabSize": 2,
  "extensions.ignoreRecommendations": true,
  "[prisma]": { "editor.formatOnSave": true },

  "editor.renderLineHighlight": "gutter",
  "editor.cursorStyle": "line",
  "editor.cursorBlinking": "expand",
  "editor.wordWrap": "on",
  "workbench.editor.labelFormat": "short",
  "explorer.compactFolders": false,
  "editor.minimap.enabled": false,
  "editor.semanticHighlighting.enabled": false,
  "breadcrumbs.enabled": false,
  "workbench.activityBar.location": "bottom",
  "editor.minimap.autohide": "none",
  "window.commandCenter": false,
  "window.title": " ", // sem barra de título
  "workbench.layoutControl.enabled": true,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
    "tailwind.config*": "tailwind.config*, postcss.config*",
    "vite.config*": "vite.config*, vite.config.*.js",
    ".env.local": ".env*",
    ".env": ".env*",
    ".gitignore": ".eslintrc*, .eslintignore*, .prettierrc*, .prettierignore*"
  },
  "[svg]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "terminal.integrated.fontFamily": "JetBrainsMono NerdFont, monospace",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontLigatures": true,
  //Format Settings
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "svg.preview.background": "editor", // set as true to run 'prettier' last not first
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  }
}
