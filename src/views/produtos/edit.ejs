<div class="max-w-4xl mx-auto">
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <form class="p-6 sm:p-8 space-y-8" action="/produtos/<%= produto.idProduto %>/edit" method="post" enctype="multipart/form-data">
      
      <div class="space-y-6">
        <h3 class="text-lg font-bold text-slate-800 flex items-center gap-2">
          <span class="material-symbols-outlined text-clinic-600">edit</span>
          Editar Produto
        </h3>

        <div class="relative">
          <input 
            type="text" 
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
            id="descricao" 
            name="descricao" 
            value="<%= produto.descricao %>" 
            placeholder="Descrição do Produto"
            autofocus 
            required 
            maxlength="100" 
          />
          <label for="descricao" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
            Descrição do Produto
          </label>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="relative">
            <input 
              type="number" 
              step="0.01" 
              min="0"
              class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
              id="valor" 
              name="valor" 
              value="<%= produto.valor %>" 
              placeholder="Valor Unitário (R$)"
              required
            />
            <label for="valor" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
              Valor Unitário (R$)
            </label>
          </div>
          <div class="relative">
            <input 
              type="number" 
              step="1" 
              min="0"
              class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
              id="quantidade" 
              name="quantidade" 
              value="<%= produto.quantidade %>" 
              placeholder="Quantidade em Estoque"
              required
            />
            <label for="quantidade" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
              Quantidade em Estoque
            </label>
          </div>
        </div>

        <div class="space-y-4">
          <% if (produto.imagem) { %>
            <div class="flex items-center gap-4 p-4 bg-slate-50 rounded-lg border border-slate-200">
              <div class="w-16 h-16 rounded overflow-hidden bg-white border border-slate-200">
                <img src="<%= produto.imagem %>" alt="Imagem atual" class="w-full h-full object-cover" />
              </div>
              <p class="text-xs text-slate-500">Imagem atual do produto</p>
            </div>
          <% } %>

          <div class="space-y-2">
            <label for="imagem" class="text-xs font-extrabold text-slate-700 uppercase tracking-wider ml-1">Substituir Imagem (opcional)</label>
            <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-slate-300 border-dashed rounded-lg hover:border-clinic-400 transition-colors">
              <div class="space-y-1 text-center">
                <span class="material-symbols-outlined text-4xl text-slate-400">upload_file</span>
                <div class="flex text-sm text-slate-600">
                  <label for="imagem" class="relative cursor-pointer bg-white rounded-md font-bold text-clinic-600 hover:text-clinic-500 focus-within:outline-none">
                    <span>Selecionar novo arquivo</span>
                    <input id="imagem" name="imagem" type="file" class="sr-only" accept="image/*">
                  </label>
                </div>
                <p class="text-xs text-slate-500">PNG, JPG, GIF até 10MB</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="pt-6 flex justify-end gap-4">
        <a href="/produtos" class="px-8 py-3 bg-slate-100 text-slate-700 rounded-lg font-bold hover:bg-slate-200 transition-all flex items-center gap-2">
          <span class="material-symbols-outlined">cancel</span>
          Cancelar
        </a>
        <button class="px-8 py-3 bg-clinic-500 text-white rounded-lg font-bold hover:bg-clinic-600 shadow-lg shadow-clinic-100 transition-all flex items-center gap-2" type="submit">
          <span class="material-symbols-outlined">save</span> 
          Salvar Alterações
        </button>
      </div>
    </form>
  </div>
</div>
