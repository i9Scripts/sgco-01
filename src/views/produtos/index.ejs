<div>
  <!-- Formulário de busca -->
  <form action="/produtos" method="get" class="mb-3">
    <div class="input-group">
      <input type="text" name="query" class="form-control" placeholder="Buscar por descrição..." value="<%= typeof query !== 'undefined' ? query : '' %>" />
      <button class="btn btn-secondary" type="submit">Buscar</button>
    </div>
  </form>

  <a href="/produtos/new" class="btn btn-primary mb-3">
    <span class="material-symbols-outlined icon-btn">add_shopping_cart</span>Novo Produto/Serviço
  </a>

  <% if (produtos && produtos.length > 0) { %>
    <div class="table-responsive">
      <table class="table table-striped table-hover">
        <thead>
          <tr>
            <th>Descrição</th>
            <th class="text-end">Valor (R$)</th>
            <th class="text-center">Estoque</th>
            <th class="text-center">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% produtos.forEach(produto => { %>
            <tr>
              <td><%= produto.descricao %></td>
              <td class="text-end"><%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(produto.valor) %></td>
              <td class="text-center"><%= produto.quantidade %></td>
              <td class="text-center">
                <!-- Botão para visualizar anamnese -->
                <button class="btn btn-round btn-sm btn-info" title="Ver Produto" onclick="abrirModalGenerico('/produtos/<%= produto.idProduto %>', 'Ver Produto')">
                  <span class="material-symbols-outlined icon-btn">visibility</span>
                </button>
          </form> 
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="alert alert-info">
      Nenhum produto ou serviço encontrado. 
      <a href="/produtos/new">Clique aqui para adicionar o primeiro.</a>
    </div>
  <% } %>
</div>
