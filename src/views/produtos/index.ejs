<div class="max-w-7xl mx-auto space-y-6">
  <!-- Cabeçalho e Ações -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-white p-4 rounded-xl shadow-sm border border-slate-200">
    <h2 class="text-xl font-bold text-slate-800 flex items-center gap-2">
      <span class="material-symbols-outlined text-clinic-600">inventory_2</span>
      Produtos
    </h2>
    <div class="flex flex-col md:flex-row w-full md:w-auto gap-4">
      <!-- Formulário de busca -->
      <form action="/produtos" method="get" class="flex gap-2 w-full md:w-80">
        <div class="flex-1 relative">
          <input 
            type="text" 
            name="query" 
            class="w-full h-10 pl-10 pr-4 text-sm font-medium border-2 border-slate-200 rounded-lg focus:border-clinic-500 focus:ring-0 outline-none transition-all" 
            placeholder="Buscar por descrição..." 
            value="<%= typeof query !== 'undefined' ? query : '' %>"
          />
          <span class="material-symbols-outlined absolute left-3 top-2 text-slate-400">search</span>
        </div>
        <button class="h-10 px-4 bg-slate-100 text-slate-700 rounded-lg font-bold hover:bg-slate-200 transition-colors" type="submit">
          Buscar
        </button>
      </form>
      <a href="/produtos/new" class="px-6 py-2 bg-clinic-500 text-white rounded-lg font-bold hover:bg-clinic-600 transition-all flex items-center justify-center gap-2 shadow-md shadow-clinic-100">
        <span class="material-symbols-outlined">add_shopping_cart</span>
        Novo Produto
      </a>
    </div>
  </div>

  <!-- Lista de produtos -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <% if (produtos && produtos.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200">
              <th class="px-6 py-4 text-[11px] font-bold text-slate-500 uppercase tracking-wider">Descrição</th>
              <th class="px-6 py-4 text-[11px] font-bold text-slate-500 uppercase tracking-wider text-right">Valor Unitário</th>
              <th class="px-6 py-4 text-[11px] font-bold text-slate-500 uppercase tracking-wider text-center">Estoque</th>
              <th class="px-6 py-4 text-[11px] font-bold text-slate-500 uppercase tracking-wider text-right">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% produtos.forEach(produto => { %>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-500">
                      <span class="material-symbols-outlined text-lg">package_2</span>
                    </div>
                    <span class="text-sm font-bold text-slate-800"><%= produto.descricao %></span>
                  </div>
                </td>
                <td class="px-6 py-4 text-sm font-bold text-slate-700 text-right">
                  <%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(produto.valor) %>
                </td>
                <td class="px-6 py-4 text-center">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold <%= produto.quantidade > 0 ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700' %>">
                    <%= produto.quantidade %> un
                  </span>
                </td>
                <td class="px-6 py-4 text-right">
                  <div class="flex justify-end gap-2">
                    <button onclick="abrirModalGenerico('/produtos/<%= produto.idProduto %>', 'Ver Produto')" 
                            class="p-2 text-clinic-600 hover:bg-clinic-50 rounded-lg transition-colors" 
                            title="Ver Detalhes">
                      <span class="material-symbols-outlined text-[20px]">visibility</span>
                    </button>
                    <a href="/produtos/<%= produto.idProduto %>/edit" 
                       class="p-2 text-amber-600 hover:bg-amber-50 rounded-lg transition-colors" 
                       title="Editar Produto">
                      <span class="material-symbols-outlined text-[20px]">edit</span>
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="p-12 text-center">
        <span class="material-symbols-outlined text-5xl text-slate-300 mb-4">inventory_2</span>
        <p class="text-slate-500 font-medium">Nenhum produto encontrado.</p>
        <a href="/produtos/new" class="mt-4 inline-flex items-center text-clinic-600 font-bold hover:underline gap-1">
          <span class="material-symbols-outlined text-sm">add</span>
          Cadastrar o primeiro produto
        </a>
      </div>
    <% } %>
  </div>
</div>
