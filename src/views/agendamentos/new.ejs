<div class="max-w-4xl mx-auto">
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    
    <div class="bg-clinic-500 p-6">
      <h2 class="text-xl font-bold text-white flex items-center">
        <span class="material-symbols-outlined mr-2">event_available</span>
        Novo Agendamento
      </h2>
      <p class="text-clinic-50 mt-1 text-sm">Preencha os dados para reservar um horário na agenda.</p>
    </div>

    <form action="/agendamentos" method="POST" class="p-6 sm:p-8 space-y-8">
      
      <!-- Seção Paciente -->
      <div class="space-y-6">
        <div class="flex items-center space-x-3 bg-slate-50 p-4 rounded-xl border border-slate-200">
          <input 
            type="checkbox" 
            class="w-5 h-5 text-clinic-600 rounded focus:ring-clinic-500 border-slate-300 transition-all cursor-pointer" 
            id="pacienteNaoCadastrado" 
            name="pacienteNaoCadastrado" 
            <% const isNewPatient = (locals.formData && formData.nome) || !(locals.formData && formData.pacienteId); %>
            <%= isNewPatient ? 'checked' : '' %>
          >
          <label class="text-sm font-bold text-slate-700 select-none cursor-pointer" for="pacienteNaoCadastrado">
            Paciente não cadastrado (Novo Paciente)
          </label>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
          <!-- Div para paciente JÁ CADASTRADO -->
          <div id="divPacienteCadastrado" class="md:col-span-12 relative">
            <select 
              class="peer w-full h-12 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all" 
              id="pacienteId" 
              name="pacienteId"
            >
              <option value="" disabled selected>Selecione um paciente cadastrado</option>
              <% pacientes.forEach(paciente => { %>
                <option value="<%= paciente.idPaciente %>" <%= (locals.formData && formData.pacienteId == paciente.idPaciente) ? 'selected' : '' %>><%= paciente.nome %></option>
              <% }); %>
            </select>
            <label for="pacienteId" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 rounded-full border border-clinic-500 md:border-none">
              Selecionar Paciente
            </label>
          </div>

          <!-- Div para paciente NÃO CADASTRADO -->
          <div id="divNomePacienteNaoCadastrado" class="md:col-span-12 relative" style="display: none;">
            <input 
              type="text" 
              class="peer w-full h-12 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
              id="nome" 
              name="nome" 
              value="<%= (locals.formData && formData.nome) || '' %>" 
              placeholder="Nome Completo"
              autofocus
            >
            <label for="nome" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-3 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
              Nome Completo do Paciente
            </label>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
        <!-- Convênio -->
        <div class="md:col-span-12 relative">
          <select 
            class="peer w-full h-12 px-4 text-sm font-semibold border-2 border-slate-200 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all" 
            id="parceiroId" 
            name="parceiroId"
          >
            <option value="">Particular (Sem convênio)</option>
            <% parceiros.forEach(parceiro => { %>
              <option value="<%= parceiro.idParceiro %>" <%= (locals.formData && formData.parceiroId == parceiro.idParceiro) ? 'selected' : '' %>><%= parceiro.nome %></option>
            <% }); %>
          </select>
          <label for="parceiroId" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-500 rounded-full">
            Convênio / Parceiro
          </label>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Data -->
        <div class="relative">
          <input 
            type="date" 
            class="peer w-full h-12 px-4 text-sm font-semibold border-2 border-slate-200 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all" 
            id="data" 
            name="data" 
            value="<%= (locals.formData && formData.data) || '' %>" 
            required 
          />
          <label for="data" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-500 rounded-full">
            Data da Consulta
          </label>
        </div>
        <!-- Hora -->
        <div class="relative">
          <input 
            type="time" 
            class="peer w-full h-12 px-4 text-sm font-semibold border-2 border-slate-200 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all" 
            id="hora" 
            name="hora" 
            value="<%= (locals.formData && formData.hora) || '' %>" 
            required 
          />
          <label for="hora" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-500 rounded-full">
            Horário
          </label>
        </div>
      </div>

      <!-- Observação -->
      <div class="relative">
        <textarea 
          class="peer w-full px-4 py-3 text-sm font-semibold border-2 border-slate-200 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
          id="observacao" 
          name="observacao" 
          rows="3" 
          placeholder="Observação"
        ><%= (locals.formData && formData.observacao) || '' %></textarea>
        <label for="observacao" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-500 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-3 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
          Observações Adicionais
        </label>
      </div>

      <!-- Ações -->
      <div class="pt-6 border-t border-slate-100 flex justify-end items-center space-x-4">
        <a href="/agendamentos" class="px-6 py-2 text-sm font-bold text-slate-500 hover:bg-slate-100 rounded-xl transition-all no-underline">
          Cancelar
        </a>
        <button type="submit" class="px-8 py-3 bg-clinic-600 text-white font-bold text-sm rounded-xl shadow-lg shadow-clinic-600/20 hover:scale-105 active:scale-95 transition-all flex items-center">
          <span class="material-symbols-outlined mr-2 text-sm">save</span>
          Confirmar Agendamento
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    const checkbox = document.getElementById('pacienteNaoCadastrado');
    const divCadastrado = document.getElementById('divPacienteCadastrado');
    const divNaoCadastrado = document.getElementById('divNomePacienteNaoCadastrado');
    const selectPaciente = document.getElementById('pacienteId');
    const inputNome = document.getElementById('nome');

    if (!checkbox) return;

    function alternarCampos() {
      if (checkbox.checked) {
        divCadastrado.style.display = 'none';
        divNaoCadastrado.style.display = 'block';
        selectPaciente.required = false;
        inputNome.required = true;
        selectPaciente.value = "";
        // Dar foco no campo de nome se estiver marcando
        setTimeout(() => inputNome.focus(), 50);
      } else {
        divCadastrado.style.display = 'block';
        divNaoCadastrado.style.display = 'none';
        selectPaciente.required = true;
        inputNome.required = false;
        inputNome.value = "";
      }
    }

    checkbox.addEventListener('change', alternarCampos);
    
    // Estado inicial
    alternarCampos();
  })();
</script>
