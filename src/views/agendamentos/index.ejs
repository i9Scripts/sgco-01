<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-3">

    <button
      class="btn btn-primary"
      onclick="abrirModalGenerico('/agendamentos/new', 'Novo Agendamento')"
    >
      <i class="ri-add-line"></i> Novo Agendamento
    </button>
  </div>
 
  <% if (agendamentos && agendamentos.length > 0) { %>
  <!-- Tabela -->
  <div class="table-responsive">
    <table class="table table-hover table-striped">
      <thead>
        <tr>
          <th>Data</th>
          <th>Horário</th>
          <th>Nome do Paciente</th>
          <th>Convênio</th>
          <th>Observações</th>
          <th>Status</th> 
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% agendamentos.forEach(agendamento => { %>
          <tr>
            <td><small><%= new Date(agendamento.dataHora).toLocaleDateString('pt-BR', {weekday: 'long', day:
              '2-digit', month: 'long'}) %></small></td>
            <td><strong><%= new Date(agendamento.dataHora).toLocaleTimeString('pt-BR', {hour: '2-digit', minute: '2-digit'}) %></strong></td>
            <td><%= agendamento.paciente ? agendamento.paciente.nome : agendamento.nome %></td>
            <td><%= agendamento.parceiro ? agendamento.parceiro.nome : 'Particular' %></td>
            <td><%= agendamento.observacao || 'N/A' %></td>
            <td><%= agendamento.status %></td> 
            <td>
              <button class="btn btn-sm btn-warning" title="Editar Agendamento" onclick="abrirModalGenerico('/agendamentos/<%= agendamento.id %>/edit', 'Editar Agendamento')">
                <span class="material-symbols-outlined icon-btn">edit</span>
              </button>
              <form action="/agendamentos/<%= agendamento.id %>?_method=DELETE" method="post" class="d-inline" title="Excluir Agendamento">
                <button type="submit" class="btn btn-round btn-sm btn-danger" onclick="return confirm('Tem certeza que deseja excluir?')">
                  <span class="material-symbols-outlined icon-btn">delete</span>
                </button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <div class="alert alert-info">Nenhum agendamento encontrado.</div>
  <% } %>
</div>


<%- include('../partials/_modal') %>
