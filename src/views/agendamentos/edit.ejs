<form action="/agendamentos/<%= formData.id %>?_method=PUT" method="POST">
  <% if (errors.message) { %>
    <div class="alert alert-danger"><%= errors.message %></div>
  <% } %>

  <div class="mb-3 form-check">
    <input type="checkbox" class="form-check-input" id="pacienteNaoCadastrado" <%= formData.nome ? 'checked' : '' %>>
    <label class="form-check-label" for="pacienteNaoCadastrado">Paciente não cadastrado</label>
  </div> 

  <div class="mb-3" id="divPacienteCadastrado">
    <label for="pacienteId" class="form-label">Paciente</label>
    <select class="form-select" id="pacienteId" name="pacienteId" <%= formData.nome ? 'disabled' : '' %> >
      <option value="" disabled <%= !formData.pacienteId ? 'selected' : '' %>>Selecione um paciente</option>
      <% pacientes.forEach(paciente => { %>
        <option value="<%= paciente.idPaciente %>" <%= formData.pacienteId == paciente.idPaciente ? 'selected' : '' %>><%= paciente.nome %></option>
      <% }); %>
    </select>
  </div>

  <div class="mb-3" id="nomePacienteNaoCadastrado" <%= formData.nome ? 'style="display: block;"' : 'style="display: none;"' %>>
    <label for="nome" class="form-label">Nome do Paciente</label>
    <input type="text" class="form-control" id="nome" name="nome" value="<%= formData.nome || '' %>" <%= formData.nome ? 'required' : '' %>>
  </div>

  <div class="mb-3">
    <label for="parceiroId" class="form-label">Convênio / Parceiro</label>
    <select class="form-select" id="parceiroId" name="parceiroId">
      <option value="" <%= !formData.parceiroId ? 'selected' : '' %>>Particular</option>
      <% parceiros.forEach(parceiro => { %>
        <option value="<%= parceiro.idParceiro %>" <%= formData.parceiroId == parceiro.idParceiro ? 'selected' : '' %>><%= parceiro.nome %></option>
      <% }); %>
    </select>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <label for="data" class="form-label">Data</label>
      <input type="date" class="form-control" id="data" name="data" value="<%= new Date(formData.dataHora).toISOString().split('T')[0] %>" required />
    </div>
    <div class="col-md-6 mb-3">
      <label for="hora" class="form-label">Hora</label>
      <input type="time" class="form-control" id="hora" name="hora" value="<%= new Date(formData.dataHora).toLocaleTimeString('pt-BR', {hour: '2-digit', minute: '2-digit'}) %>" required />
    </div>
  </div>

  <div class="mb-3">
    <label for="status" class="form-label">Status</label>
    <select class="form-select" id="status" name="status">
      <option value="Agendado" <%= formData.status === 'Agendado' ? 'selected' : '' %>>Agendado</option>
      <option value="EmAtendimento" <%= formData.status === 'EmAtendimento' ? 'selected' : '' %>>Em Atendimento</option>
      <option value="Finalizada" <%= formData.status === 'Finalizada' ? 'selected' : '' %>>Finalizado</option>
      <option value="NaoCompareceu" <%= formData.status === 'NaoCompareceu' ? 'selected' : '' %>>Nao Compareceu</option>
      <option value="Reagendado" <%= formData.status === 'Reagendado' ? 'selected' : '' %>>Reagendado</option>
      <option value="Cancelado" <%= formData.status === 'Cancelado' ? 'selected' : '' %>>Cancelado</option>
      <option value="Realizado" <%= formData.status === 'Realizado' ? 'selected' : '' %>>Realizado</option>
    </select>
  </div>

  <div class="mb-3">
    <label for="observacao" class="form-label">Observação</label>
    <textarea class="form-control" id="observacao" name="observacao" rows="3"><%= formData.observacao || '' %></textarea>
  </div>

  <div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
      Fechar
    </button>
    <button type="submit" class="btn btn-primary">Salvar Alterações</button>
  </div>
</form>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const pacienteNaoCadastradoCheckbox = document.getElementById('pacienteNaoCadastrado');
    const divPacienteCadastrado = document.getElementById('divPacienteCadastrado');
    const pacienteIdSelect = document.getElementById('pacienteId');
    const nomePacienteNaoCadastradoDiv = document.getElementById('nomePacienteNaoCadastrado');
    const nomeInput = document.getElementById('nome');

    // Initial state based on formData
    if (pacienteNaoCadastradoCheckbox.checked) {
      divPacienteCadastrado.style.display = 'none';
      pacienteIdSelect.disabled = true;
      pacienteIdSelect.required = false;
      nomePacienteNaoCadastradoDiv.style.display = 'block';
      nomeInput.required = true;
    } else {
      divPacienteCadastrado.style.display = 'block';
      pacienteIdSelect.disabled = false;
      pacienteIdSelect.required = true;
      nomePacienteNaoCadastradoDiv.style.display = 'none';
      nomeInput.required = false;
    }

    pacienteNaoCadastradoCheckbox.addEventListener('change', function () {
      if (this.checked) {
        divPacienteCadastrado.style.display = 'none';
        pacienteIdSelect.disabled = true;
        pacienteIdSelect.required = false;
        nomePacienteNaoCadastradoDiv.style.display = 'block';
        nomeInput.required = true;
      } else {
        divPacienteCadastrado.style.display = 'block';
        pacienteIdSelect.disabled = false;
        pacienteIdSelect.required = true;
        nomePacienteNaoCadastradoDiv.style.display = 'none';
        nomeInput.required = false;
      }
    });
  });
</script>
