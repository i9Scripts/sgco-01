<form action="/agendamentos/<%= formData.id %>?_method=PUT" method="POST" class="space-y-6 p-2">
  <div class="bg-slate-50 p-4 rounded-xl border border-slate-100 mb-6">
    <div class="flex items-center space-x-3 mb-4">
      <input type="checkbox" class="w-4 h-4 text-clinic-600 rounded focus:ring-clinic-500 border-slate-300 transition-all" id="pacienteNaoCadastrado" name="pacienteNaoCadastrado" <%= formData.nome ? 'checked' : '' %>>
      <label class="text-sm font-semibold text-slate-700" for="pacienteNaoCadastrado">Paciente não cadastrado</label>
    </div> 

    <div id="divPacienteCadastrado" class="space-y-1">
      <label for="pacienteId" class="text-xs font-bold text-slate-500 uppercase tracking-wider">Paciente</label>
      <select class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-clinic-500 focus:border-transparent transition-all" id="pacienteId" name="pacienteId" <%= formData.nome ? 'disabled' : '' %> >
        <option value="" disabled <%= !formData.pacienteId ? 'selected' : '' %>>Selecione um paciente</option>
        <% pacientes.forEach(paciente => { %>
          <option value="<%= paciente.idPaciente %>" <%= formData.pacienteId == paciente.idPaciente ? 'selected' : '' %>><%= paciente.nome %></option>
        <% }); %>
      </select>
    </div>

    <div id="nomePacienteNaoCadastrado" class="space-y-1 mt-4" style="<%= formData.nome ? 'display: block;' : 'display: none;' %>">
      <label for="nome" class="text-xs font-bold text-slate-500 uppercase tracking-wider">Nome do Paciente</label>
      <input type="text" class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-clinic-500 focus:border-transparent transition-all" id="nome" name="nome" value="<%= formData.nome || '' %>" <%= formData.nome ? 'required' : '' %> placeholder="Nome completo do paciente">
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="space-y-1">
        <label for="parceiroId" class="text-xs font-bold text-slate-500 uppercase tracking-wider">Convênio / Parceiro</label>
        <select class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-clinic-500 focus:border-transparent transition-all" id="parceiroId" name="parceiroId">
          <option value="" <%= !formData.parceiroId ? 'selected' : '' %>>Particular</option>
          <% parceiros.forEach(parceiro => { %>
            <option value="<%= parceiro.idParceiro %>" <%= formData.parceiroId == parceiro.idParceiro ? 'selected' : '' %>><%= parceiro.nome %></option>
          <% }); %>
        </select>
      </div>
    
      <div class="space-y-1">
        <label for="status" class="text-xs font-bold text-slate-500 uppercase tracking-wider">Status</label>
        <select class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-clinic-500 focus:border-transparent transition-all" id="status" name="status">
          <option value="Agendado" <%= formData.status === 'Agendado' ? 'selected' : '' %>>Agendado</option>
          <option value="EmAtendimento" <%= formData.status === 'EmAtendimento' ? 'selected' : '' %>>Em Atendimento</option>
          <option value="Finalizada" <%= formData.status === 'Finalizada' ? 'selected' : '' %>>Finalizado</option>
          <option value="NaoCompareceu" <%= formData.status === 'NaoCompareceu' ? 'selected' : '' %>>Não Compareceu</option>
          <option value="Reagendado" <%= formData.status === 'Reagendado' ? 'selected' : '' %>>Reagendado</option>
          <option value="Cancelado" <%= formData.status === 'Cancelado' ? 'selected' : '' %>>Cancelado</option>
        </select>
      </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="space-y-1">
      <label for="data" class="text-xs font-bold text-slate-500 uppercase tracking-wider">Data</label>
      <input type="date" class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-clinic-500 focus:border-transparent transition-all" id="data" name="data" value="<%= new Date(formData.dataHora).toISOString().split('T')[0] %>" required />
    </div>
    <div class="space-y-1">
      <label for="hora" class="text-xs font-bold text-slate-500 uppercase tracking-wider">Hora</label>
      <input type="time" class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-clinic-500 focus:border-transparent transition-all" id="hora" name="hora" value="<%= new Date(formData.dataHora).toLocaleTimeString('pt-BR', {hour: '2-digit', minute: '2-digit'}) %>" required />
    </div>
  </div>

  <div class="space-y-1">
    <label for="observacao" class="text-xs font-bold text-slate-500 uppercase tracking-wider">Observação</label>
    <textarea class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-clinic-500 focus:border-transparent transition-all" id="observacao" name="observacao" rows="3" placeholder="Informações adicionais..."><%= formData.observacao || '' %></textarea>
  </div>

  <div class="flex justify-end items-center space-x-3 pt-6 border-t border-slate-100">
    <button type="button" class="px-6 py-2.5 text-sm font-bold text-slate-500 hover:bg-slate-100 rounded-xl transition-all" data-bs-dismiss="modal">
      Cancelar
    </button>
    <button type="submit" class="px-6 py-2.5 bg-clinic-600 text-white font-bold text-sm rounded-xl shadow-lg shadow-clinic-600/20 hover:scale-105 active:scale-95 transition-all">
      Salvar Alterações
    </button>
  </div>
</form>

<script>
  (function () {
    const pacienteNaoCadastradoCheckbox = document.getElementById('pacienteNaoCadastrado');
    const divPacienteCadastrado = document.getElementById('divPacienteCadastrado');
    const pacienteIdSelect = document.getElementById('pacienteId');
    const nomePacienteNaoCadastradoDiv = document.getElementById('nomePacienteNaoCadastrado');
    const nomeInput = document.getElementById('nome');

    function toggleFields() {
      if (pacienteNaoCadastradoCheckbox.checked) {
        divPacienteCadastrado.style.display = 'none';
        pacienteIdSelect.disabled = true;
        pacienteIdSelect.required = false;
        nomePacienteNaoCadastradoDiv.style.display = 'block';
        nomeInput.required = true;
      } else {
        divPacienteCadastrado.style.display = 'block';
        pacienteIdSelect.disabled = false;
        pacienteIdSelect.required = true;
        nomePacienteNaoCadastradoDiv.style.display = 'none';
        nomeInput.required = false;
      }
    }

    pacienteNaoCadastradoCheckbox.addEventListener('change', toggleFields);
    toggleFields(); // Initial call
  })();
</script>
