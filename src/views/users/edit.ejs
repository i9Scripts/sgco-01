<div>
  <form action="/users/<%= user.idUser %>?_method=PUT" method="post">
    <input type="hidden" name="idConsultorio" value="<%= consultorio && consultorio.idConsultorio %>" />

    <div class="row form-group">
      <div class="col-md-6 mb-3">
        <input type="text" class="form-control" id="nome" name="nome" value="<%= user.nome %>" required maxlength="60" />
        <label for="nome">Nome</label>
      </div>
      <div class="col-md-6 mb-3">
        <input type="email" class="form-control" id="email" name="email" value="<%= user.email %>" required maxlength="30" />
        <label for="email">Email</label>
      </div>
    </div>

    <div class="row form-group">
      <div class="col-md-6 mb-3">
        <input type="text" class="form-control" id="celular" name="celular" value="<%= user.celular %>" required maxlength="15" />
        <label for="celular">Celular</label>
      </div>
      <div class="col-md-6 mb-3">
        <input type="password" class="form-control" id="password" name="password" placeholder="Deixe em branco para não alterar" maxlength="20" />
        <label for="password">Senha</label>
      </div>
    </div>

    <!-- Campo para alterar o status do usuário -->
    <div class="row form-group">
      <div class="col-md-6 mb-3">
        <select class="form-control" id="isActive" name="isActive" required>
          <option value="true" <%= user.isActive ? 'selected' : '' %>>Ativo</option>
          <option value="false" <%= !user.isActive ? 'selected' : '' %>>Inativo</option>
        </select>
        <label for="isActive">Status</label>
      </div>
    </div>

    <div class="fixed-buttons">
      <button class="btn btn-success btn-hover-outline" type="submit" title="Salvar alterações">
        <span class="material-symbols-outlined icon-btn">save</span> Salvar
      </button>
    </div>
  </form>
</div>
<div><%- include('../partials/_modal') %></div>