<div>

  <% if (users && users.length > 0) { %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Nome</th>
        <th>Email</th>
        <th>Celular</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(user => { %>
      <tr>
        <td><%= user.nome %></td>
        <td><%= user.email %></td>
        <td><%= user.celular %></td>
        <td>
          <!-- Botão para adicionar novo paciente -->
          <a href="/users/new" class="btn btn-sm btn-primary btn-hover-outline" title="Adicionar Novo Usuário">
            <span class="material-symbols-outlined icon-btn">person_add</span>
          </a>
          <!-- Botão para visualizar paciente -->
          <a href="/users/<%= user.idUser %>" class="btn btn-sm btn-info" title="Ver Usuário">
            <span class="material-symbols-outlined icon-btn">visibility</span>
          </a>
          <!-- Botão para editar Users -->
          <a href="/users/<%= user.idUser %>/edit" class="btn btn-sm btn-warning" title="Editar Usuário">
            <span class="material-symbols-outlined icon-btn">edit</span>
          </a>
          <!-- Botão para excluir Users -->
          <form action="/users/<%= user.idUser %>?_method=DELETE" method="post" class="d-inline" title="Excluir Usuário">
            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Tem certeza que deseja excluir?')">
              <span class="material-symbols-outlined icon-btn">delete</span>
            </button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } else { %>
  <p>Nenhum usuário encontrado.</p>
  <% } %>
</div>