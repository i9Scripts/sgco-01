<div>
  <% if (users && users.length > 0) { %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Nome</th>
        <th>Email</th>
        <th>Celular</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(user => { %>
      <tr>
        <td><%= user.nome %></td>
        <td><%= user.email %></td>
        <td><%= user.celular %></td>
        <td>
          <!-- Botão para adicionar novo usuário -->
          <button class="btn btn-sm btn-primary btn-hover-outline" onclick="abrirModalGenerico('/users/new', 'Novo Usuário')" title="Adicionar Novo Usuário">
            <span class="material-symbols-outlined icon-btn">person_add</span>
          </button>
          <!-- Botão para visualizar usuário -->
          <button class="btn btn-sm btn-info" onclick="abrirModalGenerico('/users/<%= user.idUser %>', 'Dados do Usuário')" title="Ver Usuário">
            <span class="material-symbols-outlined icon-btn">visibility</span>
          </button>
          <!-- Botão para editar usuário -->
          <button class="btn btn-sm btn-warning" onclick="abrirModalGenerico('/users/<%= user.idUser %>/edit', 'Editar Dados')" title="Editar Usuário">
            <span class="material-symbols-outlined icon-btn">edit</span>
          </button>
          <!-- Botão para excluir usuário -->
          <form action="/users/<%= user.idUser %>?_method=DELETE" method="post" class="d-inline" title="Excluir Usuário">
            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Tem certeza que deseja excluir?')">
              <span class="material-symbols-outlined icon-btn">delete</span>
            </button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } else { %>
  <p class="text-white">Nenhum Usuário encontrado.</p>
  <a class="btn btn-secondary btn-hover-outline" href="/users/new" title="Voltar">
    <span class="material-symbols-outlined icon-btn">arrow_back</span> Voltar
  </a>
  <% } %>
</div>
<div><%- include('../partials/_modal') %></div>