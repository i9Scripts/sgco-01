<div class="alert alert-secondary mb-4 card mb-4 shadow-sm">
  <div class="card-header bg-secondary text-white d-flex align-items-center">
    <span class="material-symbols-outlined me-2 icon-relat">patient_list</span>
    <h5 class="mb-0">Dados do Usuário</h5>
  </div>

  <div>
    <p><strong>Nome:</strong> <%= user.nome %> | <strong> Celular:</strong> <%= user.celular %></p>
    <hr>
    <p><strong>Email:</strong> <%= user.email %></p>
    <p><strong>Ativo:</strong> <%= user.isActive ? 'Sim' : 'Não' %></p>
    <hr>
    <p><strong>Criado em:</strong> <%= user.createdAt.toLocaleDateString() %> | <strong> Atualizado em:</strong> <%= user.updatedAt.toLocaleDateString() %></p>
  </div>

  <div>
    <a href="/users" class="btn btn-secondary btn-hover-outline" title="Voltar">
      <span class="material-symbols-outlined icon-btn">arrow_back</span> Voltar
    </a>
    <a href="/users/<%= user.idUser %>/edit" class="btn btn-warning btn-hover-outline" title="Editar Usuário">
      <span class="material-symbols-outlined icon-btn">edit</span> Editar.
    </a>
  </div>
</div>