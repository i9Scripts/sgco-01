<div class="max-w-5xl mx-auto space-y-6">
  <!-- Cabeçalho / Resumo do Usuário -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="bg-slate-50 border-b border-slate-200 p-6 flex items-center space-x-4">
      <div class="bg-clinic-100 p-3 rounded-full text-clinic-600">
        <span class="material-symbols-outlined text-3xl">account_circle</span>
      </div>
      <div>
        <h3 class="text-sm font-bold text-slate-500 uppercase tracking-wider">Perfil do Usuário</h3>
        <p class="text-xl font-extrabold text-slate-800">
          <%= user.nome %> 
          <span class="mx-2 text-slate-300">|</span> 
          <span class="text-slate-600 text-lg"><%= user.email %></span>
        </p>
      </div>
    </div>

    <div class="p-6 sm:p-8 space-y-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Conta e Contato -->
        <div class="space-y-4">
          <h4 class="text-xs font-black text-clinic-600 uppercase tracking-widest flex items-center">
            <span class="material-symbols-outlined mr-2 text-sm">manage_accounts</span> Detalhes da Conta
          </h4>
          <div class="bg-slate-50 rounded-xl p-4 space-y-3">
            <div>
              <p class="text-[10px] font-bold text-slate-400 uppercase">E-mail de Acesso</p>
              <p class="text-sm font-bold text-slate-700"><%= user.email %></p>
            </div>
            <div>
              <p class="text-[10px] font-bold text-slate-400 uppercase">Celular</p>
              <p class="text-sm font-bold text-slate-700 font-mono"><%= user.celular || 'Não informado' %></p>
            </div>
            <div>
              <p class="text-[10px] font-bold text-slate-400 uppercase">Status da Conta</p>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-black <%= user.isActive ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700' %> uppercase">
                <%= user.isActive ? 'Ativo' : 'Inativo' %>
              </span>
            </div>
          </div>
        </div>

        <!-- Sistema -->
        <div class="space-y-4">
          <h4 class="text-xs font-black text-clinic-600 uppercase tracking-widest flex items-center">
            <span class="material-symbols-outlined mr-2 text-sm">history</span> Histórico
          </h4>
          <div class="bg-slate-50 rounded-xl p-4 space-y-3">
            <div>
              <p class="text-[10px] font-bold text-slate-400 uppercase">Usuário desde</p>
              <p class="text-sm font-bold text-slate-700"><%= user.createdAt.toLocaleDateString('pt-BR') %></p>
            </div>
            <div>
              <p class="text-[10px] font-bold text-slate-400 uppercase">Última atualização de perfil</p>
              <p class="text-sm font-bold text-slate-700"><%= user.updatedAt.toLocaleDateString('pt-BR') %></p>
            </div>
          </div>
        </div>
      </div>

      <div class="pt-6 border-t border-slate-100 flex justify-end space-x-4">
        <a href="/users/<%= user.idUser %>/edit" class="px-6 py-2 bg-amber-50 text-amber-700 rounded-lg font-bold hover:bg-amber-100 transition-all no-underline flex items-center">
          <span class="material-symbols-outlined mr-2 text-lg">edit_note</span> Editar Perfil
        </a>
        <a href="/users" class="px-6 py-2 border-2 border-slate-200 text-slate-600 rounded-lg font-bold hover:bg-slate-50 transition-all no-underline flex items-center">
          <span class="material-symbols-outlined mr-2 text-lg">group</span> Ver Todos
        </a>
      </div>
    </div>
  </div>
</div>
