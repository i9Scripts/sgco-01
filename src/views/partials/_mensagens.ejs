<!-- PARTIAL: Mensagens Globais -->
<div>
  <% const normalize = (v) => { if (!v) return []; return Array.isArray(v) ? v : [v]; }; %>

  <% const welcomeMsgs = normalize(messages?.welcome); %>
  <% welcomeMsgs.forEach(msg => { %>
    <div class="alert alert-info mb-2"><%= msg %></div>
  <% }); %>

  <% const errorMsgs = normalize(messages?.error); %>
  <% errorMsgs.forEach(msg => { %>
    <div class="alert alert-danger mb-2"><%= msg %></div>
  <% }); %>

  <% const successMsgs = normalize(messages?.success); %>
  <% successMsgs.forEach(msg => { %>
    <div class="alert alert-success mb-2"><%= msg %></div>
  <% }); %>
</div>
