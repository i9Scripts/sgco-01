<link rel="stylesheet" href="/css/footer.css" />
<footer>
  <div>
    <div class="profile_content">
      <div class="profile">
        <div class="profile_details">
          <img src="/img/default_profile_avatar.svg" alt="" />
          <div class="name_job">
            <div class="name"><%= messages.userName || 'Profissional' %></div>
            <div class="job">Optometrista</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div>
    <% if (messages && messages.welcome) { %>
    <div class="text-white"><%= messages.welcome %></div>
    <% } %> <% if (messages && messages.error) { %>
    <div class="bg-danger text-white"><%= messages.error %></div>
    <% } %> <% if (messages && messages.success) { %>
    <div class="bg-success text-white"><%= messages.success %></div>
    <% } %> <% if (messages && messages.consultorioId) { %>
    <div class="text-white">Consultório ID: <%= messages.consultorioId %></div>
    <% } %>
  </div>
  <div><%- include('../partials/relogio.ejs') %></div>
</footer>
