  <!-- Main Content Area -->
  <main class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <!-- Modern Header -->
    <header class="bg-medical-navy h-16 border-b flex items-center justify-between px-8 shadow-sm">
        <div class="flex items-center space-x-4">
            <i class="<%= pageIcon %> text-white text-clinic-600 text-xl"><%= locals.iconName ? iconName : '' %></i>
            <h1 class="text-white font-semibold text-lg flex items-center"><%= pageTitle %></h1>
        </div>
        
        <div class="flex items-center space-x-4">
            <!-- User Info or Quick Actions -->
            <div class="text-right hidden sm:block">
                <p class="text-sm font-medium text-slate-700 leading-none"><%= locals.consultorio ? locals.consultorio.nome : 'Consultório' %></p>
                <p class="text-white text-xs text-slate-500">Sistema Ativo</p>
            </div>
        </div>
    </header>

    <!-- Scrollable Content -->
    <div class="flex-1 overflow-y-auto p-4 sm:p-8">
        <%- body %>
    </div>
  </main>