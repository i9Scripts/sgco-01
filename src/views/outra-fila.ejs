<div class="container mt-5">
  <h1>Fila de Espera</h1>

  <% if (pacientes.length > 0) { %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Nome</th>
        <th>Data de Cadastro</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% pacientes.forEach(paciente => { %>
      <tr>
        <td><%= paciente.nome %></td>
        <td><%= new Date(paciente.createdAt).toLocaleString() %></td>
        <td>
          <!-- Botão para abrir o modal -->
          <button class="btn btn-info btn-sm" onclick="abrirModal({
                nome: '<%= paciente.nome %>',
                cpf: '<%= paciente.cpf %>',
                createdAt: '<%= new Date(paciente.createdAt).toLocaleString() %>',
                responsavel: '<%= paciente.responsavel || "Não informado" %>',
                contato: '<%= paciente.contato || "Não informado" %>'
              })">
            Ver Ficha
          </button>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } else { %>
  <p>Nenhum paciente na fila.</p>
  <% } %>
</div>

<!-- Modal personalizado -->
<div id="modalPaciente" class="modal">
  <div class="modal-content">
    <span class="close-btn" onclick="fecharModal()">×</span>
    <h3>Ficha do Paciente</h3>
    <div id="modal-body"></div>
  </div>
</div>

<!-- Scripts -->
<script src="/js/modal.js"></script>