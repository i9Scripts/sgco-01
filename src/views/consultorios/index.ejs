<div>
  <!-- Formulário de busca -->
  <form action="/consultorios/search" method="get" class="mb-3">
    <div class="form-group">
      <input type="text" class="form-control" name="termo" />
      <label for="termo">Buscar por nome ou responsável</label>
      <button class="btn btn-outline-secondary" type="submit">Buscar</button>
    </div>
  </form>

  <!-- Lista de consultórios -->
  <% if (consultorios && consultorios.length> 0) { %>
  <table class="table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Nome</th>
        <th>Responsável</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% consultorios.forEach(consultorio=> { %>
      <tr>
        <td><%= consultorio.idConsultorio %></td>
        <td><%= consultorio.nome %></td>
        <td><%= consultorio.responsavel || 'N/A' %></td>
        <td>
          <a href="/consultorios/<%= consultorio.idConsultorio %>" class="btn btn-sm btn-info">Ver Detalhes</a>
          <a href="/consultorios/<%= consultorio.idConsultorio %>/edit" class="btn btn-sm btn-warning">Editar</a>
          <form action="/consultorios/<%= consultorio.idConsultorio %>?_method=DELETE" method="post" class="d-inline">
            <button
type="submit"
class="btn btn-sm btn-danger"
              onclick="return confirm('Tem certeza que deseja excluir?')"
            >
              Excluir
            </button>
          </form>
          <form action="/consultorios/selecionar/<%= consultorio.idConsultorio %>" method="post" style="display:inline;">
            <button type="submit" class="btn btn-primary btn-sm">Selecionar</button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } else { %>
  <p>Nenhum consultório encontrado.</p>
  <% } %>
</div>
