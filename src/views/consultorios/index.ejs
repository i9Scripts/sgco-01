<div>
  <!-- Formulário de busca -->
  <form action="/consultorios/search" method="get" class="mb-3">
    <div class="form-group">
      <input type="text" class="form-control" name="termo" />
      <label for="termo">Buscar por nome ou responsável</label>
      <button class="btn btn-outline-secondary" type="submit">Buscar</button>
    </div>
  </form>

  <!-- Lista de consultórios -->
  <% if (consultorios && consultorios.length> 0) { %>
  <table class="table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Nome</th>
        <th>Responsável</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% consultorios.forEach(consultorio=> { %>
      <tr>
        <td><%= consultorio.idConsultorio %></td>
        <td><%= consultorio.nome %></td>
        <td><%= consultorio.responsavel || 'N/A' %></td>
        <td>
          <!-- Botão para adicionar novo consultório -->
          <a class="btn btn-sm btn-primary btn-hover-outline" href="/consultorios/new" title="Adicionar Novo Consultório">
            <span class="material-symbols-outlined icon-btn">folder_shared</span>
          </a>
          <!-- Botão para visualizar consultório -->
          <a href="/consultorios/<%= consultorio.idConsultorio %>" class="btn btn-sm btn-info" title="Ver Consultório">
            <span class="material-symbols-outlined icon-btn">visibility</span>
          </a>
          <!-- Botão para editar consultório -->
          <a href="/consultorios/<%= consultorio.idConsultorio %>/edit" class="btn btn-sm btn-warning" title="Editar Consultório">
            <span class="material-symbols-outlined icon-btn">edit</span>
          </a>
          <!-- Botão para excluir consultório -->
          <form action="/consultorios/<%= consultorio.idConsultorio %>?_method=DELETE" method="post" class="d-inline" title="Excluir Consultório">
            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Tem certeza que deseja excluir?')">
              <span class="material-symbols-outlined icon-btn">delete</span>
            </button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } else { %>
  <p>Nenhum consultório encontrado.</p>
  <% } %>
</div>