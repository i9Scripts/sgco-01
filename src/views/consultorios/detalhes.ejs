<div class="ver-cadastro mb-4 card mb-4 shadow-sm">
  <p>
    <strong>ID:</strong> <%= consultorio.idConsultorio %> | <strong>Nome:</strong> <%= consultorio?.nome || 'N/D' %> |
    <strong>Telefone:</strong> <%= consultorio?.celular || 'N/D' %>
  </p>
  <hr />
  <div class="row">
    <div class="col-md-6">
      <p><strong>Responsável:</strong> <%= consultorio.responsavel || 'Não informado' %></p>
      <p>
        <strong>CPF:</strong> <%= consultorio.cpf || 'Não informado' %> | <strong>Profissão:</strong> <%=
        consultorio.profissao || 'Não informado' %>
      </p>
    </div>

      <p>
        <strong>Endereço:</strong>
        <%= consultorio.endereco || 'Não informado' %>,
        <strong></strong>
        <%= typeof consultorio.numero !== 'undefined' ? consultorio.numero : 'N/D' %> |
        <strong>Complemento:</strong> <%= consultorio.complemento || 'Não informado' %>
      </p>
      <p>
        <strong>CEP:</strong> <%= consultorio?.cep || 'N/D' %> | <strong>Bairro:</strong> <%= consultorio.bairro || 'Não informado' %> | <strong>Cidade:</strong> <%= consultorio.cidade || 'Não informado' %>
      </p>
    <p><strong>Nº Série:</strong> <%= consultorio.numeroSerie || 'N/D' %></p>
    <hr />

    <p>
      <span class="material-symbols-outlined me-2 icon-relat">event</span>
      Criado em: <%= consultorio.createdAt ? consultorio.createdAt.toLocaleDateString() : 'Não informado' %> |
      Atualizado em: <%= consultorio.updatedAt ? consultorio.updatedAt.toLocaleDateString() : 'Não informado' %>
    </p>
  </div>

  <div class="form-group mb-2">
    <a class="btn btn-secondary btn-hover-outline" href="/consultorios" title="Voltar">
      <span class="material-symbols-outlined icon-btn">chevron_left</span> Voltar
    </a>
  </div>
</div>
