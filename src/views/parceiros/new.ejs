<div class="max-w-4xl mx-auto">
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <form class="p-6 sm:p-8 space-y-8" action="/parceiros" method="post">
      <input type="hidden" name="idConsultorio" value="<%= consultorio && consultorio.idConsultorio %>" />
      
      <div class="space-y-6">
        <h3 class="text-lg font-bold text-slate-800 flex items-center gap-2">
          <span class="material-symbols-outlined text-clinic-600">person_add</span>
          Novo Parceiro
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
          <div class="md:col-span-8 relative">
            <input 
              type="text" 
              class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
              id="nome" 
              name="nome" 
              placeholder="Nome do Parceiro"
              autofocus 
              required 
              maxlength="60" 
            />
            <label for="nome" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
              Nome do Parceiro
            </label>
          </div>
          <div class="md:col-span-4 relative">
            <input 
              type="text" 
              class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
              id="telefone" 
              name="telefone" 
              oninput="mascaraCelular(this)"
              placeholder="Telefone"
              required 
              maxlength="15" 
            />
            <label for="telefone" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
              Telefone
            </label>
          </div>
        </div>

        <div class="relative">
          <input 
            type="text" 
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
            id="endereco" 
            name="endereco" 
            placeholder="Endereço"
            maxlength="60" 
          />
          <label for="endereco" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
            Endereço
          </label>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="relative">
            <input 
              type="text" 
              class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
              id="contato" 
              name="contato" 
              placeholder="Pessoa de Contato"
              maxlength="30" 
            />
            <label for="contato" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
              Pessoa de Contato
            </label>
          </div>
          <div class="relative">
            <input 
              type="number" 
              step="0.01" 
              class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
              id="credito" 
              name="credito" 
              placeholder="Crédito"
            />
            <label for="credito" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
              Crédito
            </label>
          </div>
        </div>
      </div>

      <div class="pt-6 flex justify-end">
        <button class="px-8 py-3 bg-clinic-500 text-white rounded-lg font-bold hover:bg-clinic-600 shadow-lg shadow-clinic-100 transition-all flex items-center gap-2" type="submit">
          <span class="material-symbols-outlined">save</span> 
          Salvar Parceiro
        </button>
      </div>
    </form>
  </div>
</div>
