<h1>Novo Parceiro</h1>
<form action="/parceiros" method="post">
  <div class="form-group">
    <input type="text" id="nome" name="nome" class="form-control" autofocus tabindex="1" maxlength="60" required />
    <label for="nome">Nome</label>
  </div>
  <div class="form-group">
    <input
      type="text"
      id="telefone"
      name="telefone"
      class="form-control"
      oninput="mascaraCelular(this)"
      tabindex="2"
      maxlength="15"
      required
    />
    <label for="telefone">Telefone</label>
  </div>
  <div class="form-group">
    <input type="text" id="endereco" name="endereco" class="form-control" tabindex="3" maxlength="60" />
    <label for="endereco">Endereço</label>
  </div>
  <div class="form-group">
    <input type="text" id="contato" name="contato" class="form-control" tabindex="4" maxlength="30" />
    <label for="contato">Contato</label>
  </div>
  <div class="form-group">
    <input type="number" id="credito" name="credito" class="form-control" step="0.01" tabindex="5" />
    <label for="credito">Crédito</label>
  </div>
  <button type="submit" class="btn btn-primary">Salvar</button>
</form>
