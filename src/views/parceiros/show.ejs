<div class="alert alert-secondary mb-4 card mb-4 shadow-sm">
  <div class="alert alert-secondary mb-4">

    <p><strong>ID:</strong> <%= parceiro.idParceiro %> | <strong> Nome:</strong> <%= parceiro.nome %></p>
    <p><strong>Telefone:</strong> <%= parceiro.telefone %></p>
    <p><strong>Endereço:</strong> <%= parceiro.endereco || 'Não informado' %></p>
    <p><strong>Contato:</strong> <%= parceiro.contato || 'Não informado' %></p>
    <p><strong>Crédito:</strong> <%= parceiro.credito || '0.00' %></p>
  </div>
  <p>
    <span class="material-symbols-outlined me-2 icon-relat">event</span>
    Criado em: <%= parceiro.createdAt.toLocaleDateString() || 'Não informado' %> |
    Atualizado em: <%= parceiro.updatedAt.toLocaleDateString() || 'Não informado' %>
  </p>
</div>