<div class="max-w-5xl mx-auto space-y-6">
  <!-- Cabeçalho / Resumo do Parceiro -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="bg-slate-50 border-b border-slate-200 p-6 flex items-center space-x-4">
      <div class="bg-indigo-100 p-3 rounded-full text-indigo-600">
        <span class="material-symbols-outlined text-3xl">handshake</span>
      </div>
      <div>
        <h3 class="text-sm font-bold text-slate-500 uppercase tracking-wider">Dados do Parceiro</h3>
        <p class="text-xl font-extrabold text-slate-800">
          <%= parceiro.nome %> 
          <span class="mx-2 text-slate-300">|</span> 
          <span class="text-slate-600 text-lg">ID: #<%= parceiro.idParceiro %></span>
        </p>
      </div>
    </div>

    <div class="p-6 sm:p-8 space-y-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Contato e Localização -->
        <div class="space-y-4">
          <h4 class="text-xs font-black text-clinic-600 uppercase tracking-widest flex items-center">
            <span class="material-symbols-outlined mr-2 text-sm">contact_phone</span> Contato e Localização
          </h4>
          <div class="bg-slate-50 rounded-xl p-4 space-y-3">
            <div>
              <p class="text-[10px] font-bold text-slate-400 uppercase">Telefone</p>
              <p class="text-sm font-bold text-slate-700 font-mono"><%= parceiro.telefone %></p>
            </div>
            <div>
              <p class="text-[10px] font-bold text-slate-400 uppercase">Contato / Responsável</p>
              <p class="text-sm font-bold text-slate-700"><%= parceiro.contato || 'Não informado' %></p>
            </div>
            <div>
              <p class="text-[10px] font-bold text-slate-400 uppercase">Endereço</p>
              <p class="text-sm font-bold text-slate-700"><%= parceiro.endereco || 'Não informado' %></p>
            </div>
          </div>
        </div>

        <!-- Financeiro e Sistema -->
        <div class="space-y-4">
          <h4 class="text-xs font-black text-clinic-600 uppercase tracking-widest flex items-center">
            <span class="material-symbols-outlined mr-2 text-sm">account_balance_wallet</span> Informações Financeiras
          </h4>
          <div class="bg-slate-50 rounded-xl p-4 space-y-3">
            <div>
              <p class="text-[10px] font-bold text-slate-400 uppercase">Crédito Disponível</p>
              <p class="text-lg font-black text-emerald-600 font-mono">R$ <%= parseFloat(parceiro.credito || 0).toFixed(2) %></p>
            </div>
            <div class="grid grid-cols-2 gap-4 pt-2 border-t border-slate-200">
              <div>
                <p class="text-[9px] font-bold text-slate-400 uppercase">Cadastrado em</p>
                <p class="text-[11px] font-bold text-slate-600"><%= parceiro.createdAt.toLocaleDateString('pt-BR') %></p>
              </div>
              <div>
                <p class="text-[9px] font-bold text-slate-400 uppercase">Última Atualização</p>
                <p class="text-[11px] font-bold text-slate-600"><%= parceiro.updatedAt.toLocaleDateString('pt-BR') %></p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="pt-6 border-t border-slate-100 flex justify-end space-x-4">
        <a href="/parceiros/<%= parceiro.idParceiro %>/edit" class="px-6 py-2 bg-amber-50 text-amber-700 rounded-lg font-bold hover:bg-amber-100 transition-all no-underline flex items-center">
          <span class="material-symbols-outlined mr-2 text-lg">edit</span> Editar
        </a>
        <a href="/parceiros" class="px-6 py-2 border-2 border-slate-200 text-slate-600 rounded-lg font-bold hover:bg-slate-50 transition-all no-underline flex items-center">
          <span class="material-symbols-outlined mr-2 text-lg">arrow_back</span> Voltar
        </a>
      </div>
    </div>
  </div>
</div>
