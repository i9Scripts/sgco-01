<table class="table">
  <thead>
    <tr>
      <th>ID</th>
      <th>Paciente</th>
      <th>Último Exame</th>
      <th>Motivo</th>
    </tr>
  </thead>
  <tbody>
    <% anamneses.forEach(anamnese => { %>
    <tr>
      <td><%= anamnese.idAnam %></td>
      <td><%= anamnese.paciente.nome %></td>
      <td><%= anamnese.ultimoExame || 'Não informado' %></td>
      <td><%= anamnese.motivo %></td>
      <td>
        <!-- Botão para adicionar nova anamnese -->
        <a class="btn btn-sm btn-primary btn-hover-outline" href="/pacientes" title="Adicionar Nova Anamnese">
          <span class="material-symbols-outlined icon-btn">person_add</span>
        </a>
        <!-- Botão para visualizar anamnese -->
        <a href="/anamneses/<%= anamnese.idAnam %>" class="btn btn-sm btn-info" title="Ver anamnese">
          <span class="material-symbols-outlined icon-btn">visibility</span>
        </a>
        <!-- Botão para editar anamnese -->
        <a href="/anamneses/<%= anamnese.idAnam %>/edit" class="btn btn-sm btn-warning" title="Editar anamnese">
          <span class="material-symbols-outlined icon-btn">edit</span>
        </a>
      </td>
    </tr>
    <% }); %>
  </tbody>
</table>