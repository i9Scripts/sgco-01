<h1>Lista de Anamneses</h1>
<table class="table">
  <thead>
    <tr>
      <th>ID</th>
      <th>Motivo</th>
      <th>Último Exame</th>
      <th>Ações</th>
    </tr>
  </thead>
  <tbody>
    <% anamneses.forEach(anamnese => { %>
    <tr>
      <td><%= anamnese.idAnam %></td>
      <td><%= anamnese.motivo %></td>
      <td><%= anamnese.ultimoExame || 'Não informado' %></td>
      <td>
        <a href="/anamneses/<%= anamnese.idAnam %>" class="btn btn-info btn-sm">Ver</a>
        <a href="/anamneses/<%= anamnese.idAnam %>/edit" class="btn btn-warning btn-sm">Editar</a>
        <form action="/anamneses/<%= anamnese.idAnam %>?_method=DELETE" method="post" style="display:inline;">
          <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
        </form>
      </td>
    </tr>
    <% }); %>
  </tbody>
</table>
<a href="/anamneses/new" class="btn btn-primary">Adicionar Nova Anamnese</a>