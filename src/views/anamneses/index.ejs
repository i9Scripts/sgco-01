<div>
  <!-- Lista de anamneses -->
  <% if (anamneses && anamneses.length > 0) { %>
  <table class="table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Data</th>
        <th>Paciente</th>
        <th>Último Exame</th>
        <th>Motivo</th>
      </tr>
    </thead>
    <tbody>
      <% anamneses.forEach(anamnese => { %>
      <tr>
        <td><%= anamnese.idAnam %></td>
        <td><%= anamnese.dataCreatedAt %></td>
        <td><%= anamnese.paciente.nome %></td>
        <td><%= anamnese.ultimoExame || 'Não informado' %></td>
        <td><%= anamnese.motivo %></td>
        <td>
          <!-- Botão para adicionar nova anamnese -->
         <button class="btn btn-round btn-sm btn-primary btn-hover-outline" title="Adicionar Novo Paciente" onclick="abrirModalGenerico('/pacientes/new','Novo Paciente')">
    <span class="material-symbols-outlined icon-btn">person_add</span> 
  </button>
          <!-- Botão para visualizar anamnese -->
          <button class="btn btn-round btn-sm btn-info" onclick="abrirModalGenerico('/anamneses/<%= anamnese.idAnam %>', 'Dados da Anamnese')" title="Ver anamnese">
            <span class="material-symbols-outlined icon-btn">visibility</span>
          </button>
          <!-- Botão para editar anamnese -->
          <button class="btn btn-round btn-sm btn-warning" onclick="abrirModalGenerico('/anamneses/<%= anamnese.idAnam %>/edit', 'Editar Dados')" title="Editar anamnese">
            <span class="material-symbols-outlined icon-btn">edit</span>
          </button>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } else { %>
  <p class="text-white">Nenhuma Anamnese encontrada.</p>
  <a class="btn btn-round btn-secondary btn-hover-outline" href="/pacientes" title="Voltar">
    <span class="material-symbols-outlined icon-btn">arrow_back</span> Voltar
  </a>
  <% } %>
</div>
<div><%- include('../partials/_modal') %></div>