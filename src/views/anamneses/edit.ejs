<div class="max-w-6xl mx-auto">
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <form class="p-6 sm:p-8 space-y-8 ajax-remote" action="/anamneses/<%= anamnese.idAnam %>?_method=PUT" method="post">
      <input type="hidden" name="idPaciente" value="<%= anamnese.pacienteId %>" />
      <input type="hidden" name="idConsultorio" value="<%= anamnese.consultorioId %>" />

      <!-- Cabeçalho / Resumo do Paciente -->
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 flex items-center space-x-4">
        <div class="bg-clinic-100 p-3 rounded-full text-clinic-600">
          <span class="material-symbols-outlined text-3xl">person</span>
        </div>
        <div>
          <h3 class="text-sm font-bold text-slate-500 uppercase tracking-wider">Paciente Selecionado</h3>
          <p class="text-lg font-extrabold text-slate-800">
            <%= paciente?.nome || 'N/D' %> 
            <span class="mx-2 text-slate-300">|</span> 
            <span class="text-slate-600"><%= typeof idadePaciente !== 'undefined' && idadePaciente !== null ? idadePaciente : 'N/D' %> anos</span>
          </p>
        </div>
      </div>

      <!-- Nº da Ficha, Motivo e Último Exame -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
        <div class="md:col-span-2 relative">
          <input
            type="number"
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent"
            id="nFicha"
            name="nFicha"
            placeholder="Nº da Ficha"
            value="<%= anamnese.nFicha %>" 
            onblur="validarNFicha(this, '<%= anamnese.pacienteId %>')"
          />
          <label for="nFicha" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
            Nº da Ficha
          </label>
          <div id="ficha-feedback" class="hidden absolute -bottom-5 left-0 text-[10px] font-bold"></div>
        </div>
        <div class="md:col-span-7 relative">
          <input
            type="text"
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent"
            id="motivo"
            name="motivo"
            value="<%= anamnese.motivo %>"
            placeholder="Motivo"
            autofocus
            required
            maxlength="100"
          />
          <label for="motivo" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
            Motivo da Consulta
          </label>
        </div>
        <div class="md:col-span-3 relative">
          <input
            type="text"
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent"
            id="ultimoExame"
            name="ultimoExame"
            value="<%= anamnese.ultimoExame %>"
            placeholder="Último Exame"
            maxlength="20"
          />
          <label for="ultimoExame" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
            Último Exame
          </label>
        </div>
      </div>

      <!-- Sintomas e Traumas -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
        <div class="md:col-span-6 relative">
          <input
            type="text"
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent"
            id="sintomas"
            name="sintomas"
            value="<%= anamnese.sintomas %>"
            placeholder="Sintomas"
            maxlength="50"
          />
          <label for="sintomas" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
            Sintomas
          </label>
        </div>
        <div class="md:col-span-6 relative">
          <input
            type="text"
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent"
            id="trauma"
            name="trauma"
            value="<%= anamnese.trauma %>"
            placeholder="Trauma, Cirurgia ou Doença Ocular"
            maxlength="50"
          />
          <label for="trauma" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
            Trauma, Cirurgia ou Doença Ocular
          </label>
        </div>
      </div>

      <!-- Condições Sistêmicas (Selects) -->
      <div class="grid grid-cols-2 md:grid-cols-5 gap-6">
        <div class="relative">
          <select class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-800 outline-none transition-all" id="usuarioOculos" name="usuarioOculos">
            <option value="true" <%= anamnese.usuarioOculos ? 'selected' : '' %>>Sim</option>
            <option value="false" <%= !anamnese.usuarioOculos ? 'selected' : '' %>>Não</option>
          </select>
          <label for="usuarioOculos" class="absolute left-3 -top-2.5 px-2 bg-white peer-focus:text-xs peer-focus:text-clinic-600 text-xs font-extrabold text-slate-700 rounded-full">
            Usa Óculos?
          </label>
        </div>
        <div class="relative">
          <select class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-800 outline-none transition-all" id="usuarioLC" name="usuarioLC">
            <option value="true" <%= anamnese.usuarioLC ? 'selected' : '' %>>Sim</option>
            <option value="false" <%= !anamnese.usuarioLC ? 'selected' : '' %>>Não</option>
          </select>
          <label for="usuarioLC" class="absolute left-3 -top-2.5 px-2 bg-white  peer-focus:text-xs peer-focus:text-clinic-600 text-xs font-extrabold text-slate-700 rounded-full">
            Usa LC?
          </label>
        </div>
        <div class="relative">
          <select class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-800 outline-none transition-all" id="dm" name="dm">
            <option value="true" <%= anamnese.dm ? 'selected' : '' %>>Sim</option>
            <option value="false" <%= !anamnese.dm ? 'selected' : '' %>>Não</option>
          </select>
          <label for="dm" class="absolute left-3 -top-2.5 px-2 bg-white peer-focus:text-xs peer-focus:text-clinic-600 text-xs font-extrabold text-slate-700 rounded-full">
            Diabetes?
          </label>
        </div>
        <div class="relative">
          <select class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-800 outline-none transition-all" id="has" name="has">
            <option value="true" <%= anamnese.has ? 'selected' : '' %>>Sim</option>
            <option value="false" <%= !anamnese.has ? 'selected' : '' %>>Não</option>
          </select>
          <label for="has" class="absolute left-3 -top-2.5 px-2 bg-white peer-focus:text-xs peer-focus:text-clinic-600 text-xs font-extrabold text-slate-700 rounded-full">
            Pressão Alta?
          </label>
        </div>
        <div class="relative">
          <select class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-800 outline-none transition-all" id="glauc" name="glauc">
            <option value="true" <%= anamnese.glauc ? 'selected' : '' %>>Sim</option>
            <option value="false" <%= !anamnese.glauc ? 'selected' : '' %>>Não</option>
          </select>
          <label for="glauc" class="absolute left-3 -top-2.5 px-2 bg-white peer-focus:text-xs peer-focus:text-clinic-600 text-xs font-extrabold text-slate-700 rounded-full">
            Glaucoma?
          </label>
        </div>
      </div>

      <!-- Histórico Familiar -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="relative">
          <input
            type="text"
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent"
            id="dmFam"
            name="dmFam"
            value="<%= anamnese.dmFam %>"
            placeholder="Diabetes na Família"
            maxlength="50"
          />
          <label for="dmFam" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
            Diabetes na Família
          </label>
        </div>
        <div class="relative">
          <input
            type="text"
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent"
            id="hasFam"
            name="hasFam"
            value="<%= anamnese.hasFam %>"
            placeholder="Pressão Alta na Família"
            maxlength="50"
          />
          <label for="hasFam" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
            Pressão Alta na Família
          </label>
        </div>
        <div class="relative">
          <input
            type="text"
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent"
            id="glaucFam"
            name="glaucFam"
            value="<%= anamnese.glaucFam %>"
            placeholder="Glaucoma na Família"
            maxlength="50"
          />
          <label for="glaucFam" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
            Glaucoma na Família
          </label>
        </div>
      </div>

      <!-- Remédios -->
      <div class="relative">
        <input
          type="text"
          class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent"
          id="remedio"
          name="remedio"
          value="<%= anamnese.remedio %>"
          placeholder="Remédio"
          maxlength="50"
        />
        <label for="remedio" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
          Uso de Medicamentos
        </label>
      </div>

      <!-- Cefaleia e Antecedentes Pessoais -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Cefaleia -->
        <div class="space-y-3">
          <label class="text-xs font-black text-clinic-600 uppercase tracking-widest pointer-events-auto">Cefaleia</label>
          <div class="flex flex-wrap gap-3">
              <% 
                const cefaleiaOpts = (anamnese.cefaleia || '').split(',').map(o => o.trim().toLowerCase()).filter(Boolean);
                const cefaleiaChoices = ['frontal', 'occipital', 'temporal', 'parietal', 'manhã', 'tarde', 'noite'];
                cefaleiaChoices.forEach(opt => { 
              %>
                <label class="flex items-center space-x-2 cursor-pointer group pointer-events-auto">
                  <input type="checkbox" name="cefaleia" value="<%= opt %>" <%= cefaleiaOpts.includes(opt.toLowerCase()) ? 'checked' : '' %> class="w-4 h-4 text-clinic-600 border-2 border-slate-300 rounded focus:ring-clinic-500">
                  <span class="text-sm font-bold text-slate-600 group-hover:text-clinic-600 capitalize"><%= opt %></span>
                </label>
              <% }) %>
          </div>
        </div>

        <!-- Antecedentes Pessoais -->
        <div class="space-y-3">
          <label class="text-xs font-black text-clinic-600 uppercase tracking-widest pointer-events-auto">Antecedentes Pessoais</label>
          <div class="flex flex-wrap gap-3">
            <% 
              const antOpts = (anamnese.antecedentesPessoais || '').split(',').map(o => o.trim().toLowerCase()).filter(Boolean);
              const antChoices = ['Piterígio', 'Ceratocone', 'Hiperemia', 'Cirurgia Ocular'];
              antChoices.forEach(opt => { 
            %>
              <label class="flex items-center space-x-2 cursor-pointer group pointer-events-auto">
                <input type="checkbox" name="antecedentesPessoais" value="<%= opt %>" <%= antOpts.includes(opt.toLowerCase()) ? 'checked' : '' %> class="w-4 h-4 text-clinic-600 border-2 border-slate-300 rounded focus:ring-clinic-500">
                <span class="text-sm font-bold text-slate-600 group-hover:text-clinic-600"><%= opt %></span>
              </label>
            <% }) %>
          </div>
        </div>
      </div>

      <!-- Lensometria OD -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        <div class="relative">
          <input type="text" class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" id="esfOD" name="esfOD" value="<%= anamnese.esfOD %>" placeholder="Esf OD" maxlength="6" />
          <label for="esfOD" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">Lens. OD Esf.</label>
        </div>
        <div class="relative">
          <input type="text" class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" id="cilOD" name="cilOD" value="<%= anamnese.cilOD %>" placeholder="Cil OD" maxlength="6" />
          <label for="cilOD" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">Lens. OD Cil.</label>
        </div>
        <div class="relative">
          <input type="text" class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" id="eixoOD" name="eixoOD" value="<%= anamnese.eixoOD %>" placeholder="Eixo OD" maxlength="4" />
          <label for="eixoOD" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">Lens. OD Eixo</label>
        </div>
        <div class="relative">
          <input type="text" class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" id="avSCOD" name="avSCOD" value="<%= anamnese.avSCOD %>" placeholder="AV SC OD" maxlength="8" />
          <label for="avSCOD" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">AV sem Corr. OD</label>
        </div>
      </div>

      <!-- Lensometria OE -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        <div class="relative">
          <input type="text" class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" id="esfOE" name="esfOE" value="<%= anamnese.esfOE %>" placeholder="Esf OE" maxlength="6" />
          <label for="esfOE" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">Lens. OE Esf.</label>
        </div>
        <div class="relative">
          <input type="text" class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" id="cilOE" name="cilOE" value="<%= anamnese.cilOE %>" placeholder="Cil OE" maxlength="6" />
          <label for="cilOE" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">Lens. OE Cil.</label>
        </div>
        <div class="relative">
          <input type="text" class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" id="eixoOE" name="eixoOE" value="<%= anamnese.eixoOE %>" placeholder="Eixo OE" maxlength="4" />
          <label for="eixoOE" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">Lens. OE Eixo</label>
        </div>
        <div class="relative">
          <input type="text" class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" id="avSCOE" name="avSCOE" value="<%= anamnese.avSCOE %>" placeholder="AV SC OE" maxlength="8" />
          <label for="avSCOE" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">AV sem Corr. OE</label>
        </div>
      </div>

      <!-- Adição e Observações -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
        <div class="md:col-span-3 relative">
          <input type="text" class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" id="adicao" name="adicao" value="<%= anamnese.adicao %>" placeholder="Adição" maxlength="6" />
          <label for="adicao" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">Adição</label>
        </div>
        <div class="md:col-span-9 relative">
          <input type="text" class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" id="obsGerais" name="obsGerais" value="<%= anamnese.obsGerais %>" placeholder="Observações Gerais" maxlength="255" />
          <label for="obsGerais" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">Observações Gerais</label>
        </div>
      </div>

      <div class="pt-6 flex justify-end space-x-4">
        <button class="px-8 py-3 bg-clinic-500 text-white rounded-lg font-bold hover:bg-clinic-600 shadow-md transition-all flex items-center" type="submit">
          <span class="material-symbols-outlined mr-2">save</span> Salvar Alterações
        </button>
      </div>
    </form>
    <script src="/js/mascaraLens.js"></script>
