<div>
  <form action="/anamneses/<%= anamnese.idAnam %>?_method=PUT" method="post">
    <input type="hidden" name="idPaciente" value="<%= anamnese.pacienteId %>" />
    <input type="hidden" name="idConsultorio" value="<%= anamnese.consultorioId %>" />

    <!-- Resumo do paciente -->
    <div class="alert alert-secondary mb-4">
      <h5 class="mb-1">
        <i class="ri-user-line"></i> Paciente selecionado:
      </h5>
      <p class="mb-0">
        <strong>Nome:</strong> <%= paciente?.nome || 'N/D' %> |
        <strong>Idade:</strong> <%= paciente?.idade || 'N/D' %> anos |
      </p>
    </div>

    <!-- Campos do formulário -->
    <div class="row form-group">
      <div class="col-md-12 mb-3">
        <input type="text" class="form-control" id="motivo" name="motivo" value="<%= anamnese.motivo %>" required maxlength="100" />
        <label for="motivo">Motivo</label>
      </div>
    </div>
    <div class="row form-group">
      <div class="col-md-12 mb-3">
        <input type="text" class="form-control" id="ultimoExame" name="ultimoExame" value="<%= anamnese.ultimoExame %>" maxlength="20" />
        <label for="ultimoExame">Último Exame</label>
      </div>
    </div>
    <div class="row form-group">
      <div class="col-md-6 mb-3">
        <select class="form-control" id="usuarioOculos" name="usuarioOculos">
          <option value="true" <%= anamnese.usuarioOculos ? 'selected' : '' %>>Sim</option>
          <option value="false" <%= !anamnese.usuarioOculos ? 'selected' : '' %>>Não</option>
        </select>
        <label for="usuarioOculos">Usa Óculos?</label>
      </div>
      <div class="col-md-6 mb-3">
        <select class="form-control" id="usuarioLC" name="usuarioLC">
          <option value="true" <%= anamnese.usuarioLC ? 'selected' : '' %>>Sim</option>
          <option value="false" <%= !anamnese.usuarioLC ? 'selected' : '' %>>Não</option>
        </select>
        <label for="usuarioLC">Usou Lente de Contato?</label>
      </div>
    </div>
    <div class="row form-group">
      <div class="col-md-12 mb-3">
        <input type="text" class="form-control" id="trauma" name="trauma" value="<%= anamnese.trauma %>" maxlength="50" />
        <label for="trauma">Trauma</label>
      </div>
    </div>
    <div class="row form-group">
      <div class="col-md-6 mb-3">
        <select class="form-control" id="dm" name="dm">
          <option value="true" <%= anamnese.dm ? 'selected' : '' %>>Sim</option>
          <option value="false" <%= !anamnese.dm ? 'selected' : '' %>>Não</option>
        </select>
        <label for="dm">Tem Diabetes?</label>
      </div>
      <div class="col-md-6 mb-3">
        <select class="form-control" id="has" name="has">
          <option value="true" <%= anamnese.has ? 'selected' : '' %>>Sim</option>
          <option value="false" <%= !anamnese.has ? 'selected' : '' %>>Não</option>
        </select>
        <label for="has">Tem Pressão Alta?</label>
      </div>
    </div>
    <div class="row form-group">
      <div class="col-md-6 mb-3">
        <select class="form-control" id="glauc" name="glauc">
          <option value="true" <%= anamnese.glauc ? 'selected' : '' %>>Sim</option>
          <option value="false" <%= !anamnese.glauc ? 'selected' : '' %>>Não</option>
        </select>
        <label for="glauc">Tem Glaucoma?</label>
      </div>
      <div class="col-md-6 mb-3">
        <input type="text" class="form-control" id="dmFam" name="dmFam" value="<%= anamnese.dmFam %>" maxlength="50" />
        <label for="dmFam">Diabetes na Família</label>
      </div>
    </div>
    <div class="row form-group">
      <div class="col-md-6 mb-3">
        <input type="text" class="form-control" id="hasFam" name="hasFam" value="<%= anamnese.hasFam %>" maxlength="50" />
        <label for="hasFam">Pressão Alta na Família</label>
      </div>
      <div class="col-md-6 mb-3">
        <input type="text" class="form-control" id="glaucFam" name="glaucFam" value="<%= anamnese.glaucFam %>" maxlength="50" />
        <label for="glaucFam">Glaucoma na Família</label>
      </div>
    </div>
    <div class="row form-group">
      <div class="col-md-12 mb-3">
        <input type="text" class="form-control" id="sintomas" name="sintomas" value="<%= anamnese.sintomas %>" maxlength="50" />
        <label for="sintomas">Sintomas</label>
      </div>
    </div>
    <div class="row form-group">
      <div class="col-md-12 mb-3">
        <input type="text" class="form-control" id="remedio" name="remedio" value="<%= anamnese.remedio %>" maxlength="50" />
        <label for="remedio">Remédio</label>
      </div>
    </div>
    <div class="row form-group">
      <div class="col-md-4 mb-3">
        <input type="text" class="form-control" id="lesEsfOD" name="esfOD" value="<%= anamnese.esfOD %>" maxlength="6" />
        <label for="esfOD">Lesometria OD Esférico</label>
      </div>
      <div class="col-md-4 mb-3">
        <input type="text" class="form-control" id="lesCilOD" name="cilOD" value="<%= anamnese.cilOD %>" maxlength="6" />
        <label for="cilOD">Lesometria OD Cilíndrico</label>
      </div>
      <div class="col-md-4 mb-3">
        <input type="text" class="form-control" id="lesEixoOD" name="eixoOD" value="<%= anamnese.eixoOD %>" maxlength="4" />
        <label for="eixoOD">Lesometria OD Eixo</label>
      </div>
    </div>
    <div class="row form-group">
      <div class="col-md-4 mb-3">
        <input type="text" class="form-control" id="esfOE" name="esfOE" value="<%= anamnese.esfOE %>" maxlength="6" />
        <label for="esfOE">Lesometria OE Esférico</label>
      </div>
      <div class="col-md-4 mb-3">
        <input type="text" class="form-control" id="cilOE" name="cilOE" value="<%= anamnese.cilOE %>" maxlength="6" />
        <label for="cilOE">Lesometria OE Cilíndrico</label>
      </div>
      <div class="col-md-4 mb-3">
        <input type="text" class="form-control" id="eixoOE" name="eixoOE" value="<%= anamnese.eixoOE %>" maxlength="4" />
        <label for="eixoOE">Lesometria OE Eixo</label>
      </div>
    </div>
    <div class="row form-group">
      <div class="col-md-4 mb-3">
        <input type="text" class="form-control" id="adicao" name="adicao" value="<%= anamnese.adicao %>" maxlength="6" />
        <label for="adicao">Lesometria Adição</label>
      </div>
      <div class="col-md-8 mb-3">
        <input type="text" class="form-control" id="obsGerais" name="obsGerais" value="<%= anamnese.obsGerais %>" maxlength="255" />
        <label for="obsGerais">Observações Gerais</label>
      </div>
    </div>
    <div class="form-group mb-2">
      <a href="/anamneses" class="btn btn-secondary" title="Voltar">
        <i class="ri-arrow-left-line"></i> Voltar
      </a>
      <a href="/anamneses/<%= anamnese.idAnam %>" class="btn btn-primary" title="Ver anamnese">
        <i class="ri-file-search-line"></i> Ver
      </a>
      <button class="btn btn-primary" type="submit" title="Salvar alterações">
        <i class="ri-save-line"></i> Salvar
      </button>
    </div>
  </form>
</div>