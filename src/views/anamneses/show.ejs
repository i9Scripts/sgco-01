<div class="alert alert-secondary mb-4 card mb-4 shadow-sm">
  <div class="card-body">
    <p>
      <strong>ID:</strong> <%= anamnese.idAnam %> |
      <strong>Nome:</strong> <%= paciente?.nome || 'N/D' %> |
      <strong>Idade:</strong> <%= paciente?.idade || 'N/D' %> anos
    </p>

    <hr>
    <div class="row">
      <div class="col-md-6">
        <p><strong>Motivo:</strong> <%= anamnese.motivo || 'Não informado' %></p>
        <p><strong>Último Exame:</strong> <%= anamnese.ultimoExame || 'Não informado' %></p>
        <p><strong>Usuário de Óculos:</strong> <%= anamnese.usuarioOculos ? 'Sim' : 'Não' %></p>
        <p><strong>Usuário de Lentes de Contato:</strong> <%= anamnese.usuarioLC ? 'Sim' : 'Não' %></p>
        <p><strong>Trauma:</strong> <%= anamnese.trauma || 'Não informado' %></p>
        <p><strong>Sintomas:</strong> <%= anamnese.sintomas || 'Não informado' %></p>
        <p><strong>Remédios:</strong> <%= anamnese.remedio || 'Não informado' %></p>
        <p><strong>Observações Gerais:</strong> <%= anamnese.obsGerais || 'Não informado' %></p>
      </div>
      <div class="col-md-6">
        <p><strong>DM:</strong> <%= anamnese.dm ? 'Sim' : 'Não' %> | <strong>HAS:</strong> <%= anamnese.has ? 'Sim' : 'Não' %> | <strong>Glaucoma:</strong> <%= anamnese.glauc ? 'Sim' : 'Não' %></p>
        <p><strong>DM Familiar:</strong> <%= anamnese.dmFam || 'Não informado' %> | <strong>HAS Familiar:</strong> <%= anamnese.hasFam || 'Não informado' %> | <strong>Glaucoma Familiar:</strong> <%= anamnese.glaucFam || 'Não informado' %></p>
        <div class="row">
          <hr>
          <p><strong>Esférico OD:</strong> <%= anamnese.esfOD || '00,00' %> | <strong>Cilindro OD:</strong> <%= anamnese.cilOD || '00,00' %> | <strong>Eixo OD:</strong> <%= anamnese.eixoOD || '00,00' %></p>
        </div>
        <div class="row">
          <p><strong>Esférico OE:</strong> <%= anamnese.esfOE || '00,00' %> | <strong>Cilindro OE:</strong> <%= anamnese.cilOE || '00,00' %> | <strong>Eixo OE:</strong> <%= anamnese.eixoOE || '00,00' %></p>
          <p><strong>Adição:</strong> <%= anamnese.adicao || '00,00' %></p>
        </div>
      </div>
      <hr>
      <p>
        <span class="material-symbols-outlined me-2 icon-relat">event</span>
        Criado em: <%= anamnese.createdAt.toLocaleDateString() || 'Não informado' %> |
        Atualizado em: <%= anamnese.updatedAt.toLocaleDateString() || 'Não informado' %>
      </p>
    </div>
  </div>
</div>