<h1>Detalhes da Anamnese</h1>
<ul>
  <li><strong>ID:</strong> <%= anamnese.idAnam %></li>
  <li><strong>Motivo:</strong> <%= anamnese.motivo %></li>
  <li><strong>Último Exame:</strong> <%= anamnese.ultimoExame || 'Não informado' %></li>
  <li><strong>Usuário de Óculos:</strong> <%= anamnese.usuarioOculos ? 'Sim' : 'Não' %></li>
  <li><strong>Usuário de Lentes de Contato:</strong> <%= anamnese.usuarioLC ? 'Sim' : 'Não' %></li>
  <li><strong>Trauma:</strong> <%= anamnese.trauma || 'Não informado' %></li>
  <li><strong>DM:</strong> <%= anamnese.dm || 'Não informado' %></li>
  <li><strong>HAS:</strong> <%= anamnese.has || 'Não informado' %></li>
  <li><strong>Glaucoma:</strong> <%= anamnese.glauc || 'Não informado' %></li>
</ul>
