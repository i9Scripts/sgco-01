<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Receita Optometrista</title>
  <link rel="stylesheet" href="style.css">
</head>

<body>
  <div class="pagina">
    <div class="container">
      <header>
        <div class="logos">
          <img src="/src/public/img/LogotipoAC.png" alt="Logotipo Consultório" class="logo-consultorio">
        </div>
        <div class="header-info">
          <h3><%= consultorio.nome %></h3>
          <p>Cuidados Primários da Visão</p>
        </div>
      </header>

      <main>
        <section class="patient-details">
          <div class="nodia">
            <p><strong>Data:</strong> <%= diagnostico.updatedAt %></p>
          </div>
          <div class="dados">
            <p><strong>Nome:</strong> <%= paciente.nome %></p>
            <p><strong>Idade:</strong> <%= paciente.idade %></p>
          </div>
        </section>

        <section class="prescription">
          <h3>Prescrição de Lentes</h3>
          <table>
            <thead>
              <tr>
                <th></th>
                <th>ESF</th>
                <th>CIL</th>
                <th>EIXO</th>
                <th>DNP</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Longe OD</strong></td>
                <td><%= prescription.longe.od.esf %></td>
                <td><%= prescription.longe.od.cil %></td>
                <td><%= prescription.longe.od.eixo %></td>
                <td><%= prescription.longe.od.dnp %></td>
              </tr>
              <tr>
                <td><strong>Longe OE</strong></td>
                <td><%= prescription.longe.oe.esf %></td>
                <td><%= prescription.longe.oe.cil %></td>
                <td><%= prescription.longe.oe.eixo %></td>
                <td><%= prescription.longe.oe.dnp %></td>
              </tr>
              <tr>
                <td><strong>Perto OD</strong></td>
                <td><%= prescription.perto.od.esf %></td>
                <td><%= prescription.perto.od.cil %></td>
                <td><%= prescription.perto.od.eixo %></td>
                <td><%= prescription.perto.od.dnp %></td>
              </tr>
              <tr>
                <td><strong>Perto OE</strong></td>
                <td><%= prescription.perto.oe.esf %></td>
                <td><%= prescription.perto.oe.cil %></td>
                <td><%= prescription.perto.oe.eixo %></td>
                <td><%= prescription.perto.oe.dnp %></td>
              </tr>
            </tbody>
          </table>
        </section>
        <div class="assinatura">
          <hr>
          <p><%= profissional.nome %></p>
        </div>
      </main>
    </div>
    <footer>
      <img src="/src/public/img/optometria_simbolo-420x420.png" alt="Logotipo Optometria" class="logo-optometria">
      <p>Slogan do consultorio</p>
    </footer>
  </div>
</body>

</html>