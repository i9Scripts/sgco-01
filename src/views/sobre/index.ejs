  <h2>Benefícios Principais:</h2>
  <ul>
      <li>Redução do tempo de espera e melhor organização da recepção.</li>
      <li>Comunicação eficiente entre recepção e profissionais.</li>
      <li>Acesso fácil ao histórico completo do paciente.</li>
      <li>Visão clara da situação financeira do consultório.</li>
      <li>Otimização do tempo dos profissionais.</li>
  </ul>

  <hr>

  <%# Seção de Informações do Consultório - Dados vindos do Backend %>
  <div class="contact-info mt-4 p-3 mb-4" style="background-color: #f8f9fa; border-radius: 5px;">
      <h3>Informações do Consultório</h3>

      <%# Verifica se a variável 'nomeClinica' foi passada e não está vazia %>
      <% if (typeof nomeClinica !== 'undefined' && nomeClinica) { %>
          <p><strong>Nome:</strong> <%= nomeClinica %></p>
      <% } %>

      <%# Verifica se a variável 'enderecoClinica' foi passada e não está vazia %>
      <% if (typeof enderecoClinica !== 'undefined' && enderecoClinica) { %>
          <p><strong>Endereço:</strong> <%= enderecoClinica %></p>
      <% } else { %>
          <p><strong>Endereço:</strong> <span class="text-muted">Não informado</span></p>
      <% } %>

      <%# Verifica se a variável 'telefoneClinica' foi passada e não está vazia %>
      <% if (typeof telefoneClinica !== 'undefined' && telefoneClinica) { %>
           <p><strong>Telefone:</strong> <%= telefoneClinica %></p>
      <% } else { %>
          <p><strong>Telefone:</strong> <span class="text-muted">Não informado</span></p>
      <% } %>
  </div>

</div>