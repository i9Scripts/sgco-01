<div class="container">
  <% if (pacientes.length > 0) { %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Nome</th>
        <th>Data de Cadastro</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% pacientes.forEach(paciente => { %>
      <tr>
        <td><%= paciente.nome %></td>
        <td><%= new Date(paciente.createdAt).toLocaleString() %></td>
        <td class="d-flex gap-2">
          <!-- Botão para abrir o modal com a ficha do paciente -->
          <!-- Botão para abrir o modal de visualização -->
          <button class="btn btn-info btn-sm" onclick="abrirModalGenerico('/pacientes/<%= paciente.idPaciente %>', 'Dados do Paciente')">
            <span class="material-symbols-outlined icon-btn">visibility</span>
          </button>

          <!-- Botão para abrir o modal de edição -->
          <button class="btn btn-warning btn-sm" title="Editar Paciente" onclick="abrirModalGenerico('/pacientes/<%= paciente.idPaciente %>/edit', 'Editar Paciente')">
            <span class="material-symbols-outlined icon-btn">edit</span>
          </button>

          <% if (paciente.anamneses && paciente.anamneses.length > 0) { %>
          <!-- Botão para marcar como atendido -->
          <form action="/paciente/<%= paciente.idPaciente %>/atendido?_method=PUT" method="post" class="d-inline">
            <button type="submit" class="btn btn-success btn-sm" title="Marcar como Atendido">
              <span class="material-symbols-outlined icon-btn">check_circle</span>
            </button>
          </form>
          <% } else { %>
          <!-- Mensagem ou botão desabilitado -->
          <button class="btn btn-secondary btn-sm" title="Na fila de atendimento">
            <span class="material-symbols-outlined icon-btn">block</span> Sem Anamnese
          </button>
          <% } %>

          <!-- Botões para anamnese -->
          <% if (paciente.anamneses && paciente.anamneses.length > 0) { 
            const anamnese = paciente.anamneses[0]; %>
          <!-- ver anamnese -->
          <button class="btn btn-info btn-sm" title="Editar Paciente" onclick="abrirModalGenerico('/anamneses/<%= anamnese.idAnam %>', 'Ver Anamnese')">
            <span class="material-symbols-outlined icon-btn">visibility</span>
          </button>
          <button class="btn btn-warning btn-sm" title="Editar Paciente" onclick="abrirModalGenerico('/anamneses/<%= anamnese.idAnam %>/edit', 'Editar Anamnese')">
            <span class="material-symbols-outlined icon-btn">edit</span>
          </button>
          <% } else { %>
          <button class="btn btn-info btn-sm" title="Editar Paciente" onclick="abrirModalGenerico('/pacientes/<%= paciente.idPaciente %>/selecionar', 'Nova Anamnese')">
            <span class="material-symbols-outlined icon-btn">add</span>
          </button>
          <% } %>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } else { %>
  <p class="text-center">Nenhum paciente na fila de espera.</p>
  <% } %>
</div>

<!-- Modal genérico -->
<div><%- include('./partials/_modal') %></div>