<div>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <a href="/servicos/new" class="btn btn-primary">Novo Serviço</a>

  </div>
  <% if (servicos && servicos.length) { %>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Descrição</th>
          <th>Valor</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% servicos.forEach(function(s) { %>
          <tr>
            <td><%= s.descricao %></td>
            <td>R$ <%= s.valor.toFixed(2) %></td>
            <td class="text-end">
              <a href="/servicos/<%= s.idServico %>/edit" class="btn btn-sm btn-warning" title=" Editar Serviço">
                <span class="material-symbols-outlined icon-btn">edit</span>
              </a>
              <form action="/servicos/<%= s.idServico %>/delete" method="post" style="display:inline-block" onsubmit="return confirm('Confirmar exclusão?')">
                <button type="submit" class="btn btn-round btn-sm btn-danger" title="Excluir Serviço" onclick="return confirm('Tem certeza que deseja excluir?')">
              <span class="material-symbols-outlined icon-btn">delete</span>
            </button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p>Nenhum serviço cadastrado.</p>
  <% } %>
</div>
