<div class="max-w-6xl mx-auto space-y-6">
  <!-- Cabeçalho e Ações -->
  <div class="flex justify-between items-center bg-white p-4 rounded-xl shadow-sm border border-slate-200">
    <h2 class="text-xl font-bold text-slate-800 flex items-center gap-2">
      <span class="material-symbols-outlined text-clinic-600">medical_services</span>
      Serviços
    </h2>
    <a href="/servicos/new" class="px-6 py-2.5 bg-clinic-500 text-white rounded-lg font-bold hover:bg-clinic-600 transition-all flex items-center gap-2 shadow-md shadow-clinic-100">
      <span class="material-symbols-outlined">add_circle</span>
      Novo Serviço
    </a>
  </div>

  <!-- Lista de serviços -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <% if (servicos && servicos.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200">
              <th class="px-6 py-4 text-[11px] font-bold text-slate-500 uppercase tracking-wider">Descrição do Serviço</th>
              <th class="px-6 py-4 text-[11px] font-bold text-slate-500 uppercase tracking-wider text-right">Valor (R$)</th>
              <th class="px-6 py-4 text-[11px] font-bold text-slate-500 uppercase tracking-wider text-right">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% servicos.forEach(servico => { %>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-clinic-50 flex items-center justify-center text-clinic-600">
                      <span class="material-symbols-outlined text-lg">medical_information</span>
                    </div>
                    <span class="text-sm font-bold text-slate-800"><%= servico.descricao %></span>
                  </div>
                </td>
                <td class="px-6 py-4 text-sm font-bold text-slate-700 text-right">
                  <%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(servico.valor) %>
                </td>
                <td class="px-6 py-4 text-right">
                  <div class="flex justify-end gap-2">
                    <a href="/servicos/<%= servico.idServico %>/edit" 
                       class="p-2 text-amber-600 hover:bg-amber-50 rounded-lg transition-colors" 
                       title="Editar Serviço">
                      <span class="material-symbols-outlined text-[20px]">edit</span>
                    </a>
                    <form action="/servicos/<%= servico.idServico %>/delete" method="post" class="inline" onsubmit="return confirm('Tem certeza que deseja excluir este serviço?')">
                      <button type="submit" class="p-2 text-rose-600 hover:bg-rose-50 rounded-lg transition-colors" title="Excluir Serviço">
                        <span class="material-symbols-outlined text-[20px]">delete</span>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="p-12 text-center">
        <span class="material-symbols-outlined text-5xl text-slate-300 mb-4">medical_services</span>
        <p class="text-slate-500 font-medium">Nenhum serviço cadastrado.</p>
        <a href="/servicos/new" class="mt-4 inline-flex items-center text-clinic-600 font-bold hover:underline gap-1">
          <span class="material-symbols-outlined text-sm">add</span>
          Cadastrar o primeiro serviço
        </a>
      </div>
    <% } %>
  </div>
</div>
