<div class="max-w-5xl mx-auto space-y-6">
  <!-- Cabeçalho / Resumo do Profissional -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="bg-slate-50 border-b border-slate-200 p-6 flex items-center space-x-4">
      <div class="bg-blue-100 p-3 rounded-full text-blue-600">
        <span class="material-symbols-outlined text-3xl">medical_services</span>
      </div>
      <div>
        <h3 class="text-sm font-bold text-slate-500 uppercase tracking-wider">Dados do Profissional</h3>
        <p class="text-xl font-extrabold text-slate-800">
          <%= profissional.nome %> 
          <span class="mx-2 text-slate-300">|</span> 
          <span class="text-slate-600 text-lg"><%= profissional.especialidade %></span>
        </p>
      </div>
    </div>

    <div class="p-6 sm:p-8 space-y-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Qualificações e Contato -->
        <div class="space-y-4">
          <h4 class="text-xs font-black text-clinic-600 uppercase tracking-widest flex items-center">
            <span class="material-symbols-outlined mr-2 text-sm">badge</span> Identificação e Contato
          </h4>
          <div class="bg-slate-50 rounded-xl p-4 space-y-3">
            <div>
              <p class="text-[10px] font-bold text-slate-400 uppercase">CBOO / Registro</p>
              <p class="text-sm font-bold text-slate-700"><%= profissional.cboo %></p>
            </div>
            <div>
              <p class="text-[10px] font-bold text-slate-400 uppercase">Celular</p>
              <p class="text-sm font-bold text-slate-700 font-mono"><%= profissional.celular %></p>
            </div>
          </div>
        </div>

        <!-- Sistema -->
        <div class="space-y-4">
          <h4 class="text-xs font-black text-clinic-600 uppercase tracking-widest flex items-center">
            <span class="material-symbols-outlined mr-2 text-sm">database</span> Registro no Sistema
          </h4>
          <div class="bg-slate-50 rounded-xl p-4 space-y-3">
            <div>
              <p class="text-[10px] font-bold text-slate-400 uppercase">ID Interno</p>
              <p class="text-sm font-bold text-slate-700">#<%= profissional.idProfissional %></p>
            </div>
            <div class="grid grid-cols-2 gap-4 pt-2 border-t border-slate-200">
              <div>
                <p class="text-[9px] font-bold text-slate-400 uppercase">Cadastrado em</p>
                <p class="text-[11px] font-bold text-slate-600"><%= profissional.createdAt.toLocaleDateString('pt-BR') %></p>
              </div>
              <div>
                <p class="text-[9px] font-bold text-slate-400 uppercase">Última Atualização</p>
                <p class="text-[11px] font-bold text-slate-600"><%= profissional.updatedAt.toLocaleDateString('pt-BR') %></p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="pt-6 border-t border-slate-100 flex justify-end space-x-4">
        <a href="/profissionais/<%= profissional.idProfissional %>/edit" class="px-6 py-2 bg-amber-50 text-amber-700 rounded-lg font-bold hover:bg-amber-100 transition-all no-underline flex items-center">
          <span class="material-symbols-outlined mr-2 text-lg">edit</span> Editar
        </a>
        <a href="/profissionais" class="px-6 py-2 border-2 border-slate-200 text-slate-600 rounded-lg font-bold hover:bg-slate-50 transition-all no-underline flex items-center">
          <span class="material-symbols-outlined mr-2 text-lg">arrow_back</span> Voltar
        </a>
      </div>
    </div>
  </div>
</div>
