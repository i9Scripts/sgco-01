<div class="container-fluid py-4">
    <% if (messages.error) { %>
        <div class="alert alert-danger" role="alert"><%= messages.error %></div>
    <% } %>
    <% if (messages.success) { %>
        <div class="alert alert-success" role="alert"><%= messages.success %></div>
    <% } %>

    <div class="row">
        <!-- Left: Fila de Espera (maior) -->
        <div class="col-lg-8 mb-4">
            <div class="card shadow h-100">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Fila de Espera dos Pacientes</h6>
                </div>
                <div class="card-body">
                    <div id="fila-de-espera-profissional">
                        <%- include('../partials/_filaEspera.ejs', { pacientes: pacientesNaFila, isProfissional: true }) %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Ações rápidas e relatórios (barra lateral) -->
        <div class="col-lg-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Ações Rápidas</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-3">
                        <a href="/anamneses" class="btn btn-primary btn-block custom-dashboard-btn-small" title="Gerenciar Anamneses">
                            <i class="bi bi-journal-medical"></i> Anamneses
                        </a>
                        <a href="/diagnosticos" class="btn btn-success btn-block custom-dashboard-btn-small" title="Gerenciar Diagnósticos">
                            <i class="bi bi-prescription2"></i> Diagnósticos
                        </a>
                        <a href="/pacientes" class="btn btn-secondary btn-block custom-dashboard-btn-small" title="Gerenciar Pacientes">
                            <i class="bi bi-search"></i> Paciente
                        </a>
                        <a href="/agendamentos" class="btn btn-warning btn-block" title="Ver Agenda"><span class="bi bi-calendar-event"></span> Agenda
                        </a>
                        <a href="/financeiro/selecionar-paciente" class="btn btn-info btn-block custom-dashboard-btn-small" title="Registrar Pagamentos">
                            <i class="bi bi-cash-coin"></i> Pagamentos
                        </a>
                        <a href="/produtos" class="btn btn-success btn-block" title="Buscar Produtos"><span class="bi bi-basket"></span> Produtos</a>
                        <a href="/parceiros" class="btn btn-secondary btn-block" title="Gerenciar Parceiros"><span class="bi bi-people"></span> Parceiros</a>
                    </div>
                </div>
            </div>

            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Relatórios Financeiros</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/financeiro/extrato" class="btn btn-warning btn-block custom-dashboard-btn-small" title="Extrato Financeiro">
                            <i class="bi bi-receipt"></i> Financeiro
                        </a>
                        <a href="/financeiro/relatorios" class="btn btn-info btn-block custom-dashboard-btn-small" title="Gerenciar Relatórios">
                            <i class="bi bi-bar-chart-line"></i> Relatórios
                        </a>
                        <a href="/financeiro/relatorios/vendas-dia" class="btn btn-outline-primary btn-block custom-dashboard-btn-small" title="Vendas do Dia">
                            <i class="bi bi-calendar-day"></i> Vendas
                        </a>
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>