
<div class="grid grid-cols-1 lg:grid-cols-4 gap-6 mb-8 bg-white/70 p-6 rounded-xl shadow-sm">
    <div class="lg:col-span-1 flex flex-col justify-center">
        <h2 class="font-headline text-2xl font-extrabold text-primary leading-tight">Olá, <%= usuario ? usuario.nome : 'Doutor' %></h2>
        <p class="text-secondary text-sm mt-2">Você tem <%= agendamentosHoje.length %> consultas agendadas para hoje.</p>
    </div>
    
    <!-- Quick Stats Counters -->
    <div class="bg-white p-6 rounded-xl shadow-sm flex items-center gap-4 border-l-4 border-clinic-500">
        <div class="w-12 h-12 rounded-full bg-clinic-100 flex items-center justify-center text-clinic-600">
            <span class="material-symbols-outlined">how_to_reg</span>
        </div>
        <div>
            <p class="text-[10px] font-label uppercase tracking-wider text-slate-500">Atendimentos</p>
            <p class="text-2xl font-headline font-bold text-slate-800"><%= atendimentosHoje %> <span class="text-xs font-normal text-slate-400">/ <%= agendamentosHoje.length %></span></p>
        </div>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm flex items-center gap-4 border-l-4 border-medical-teal">
        <div class="w-12 h-12 rounded-full bg-teal-50 flex items-center justify-center text-medical-teal">
            <span class="material-symbols-outlined">timer</span>
        </div>
        <div>
            <p class="text-[10px] font-label uppercase tracking-wider text-slate-500">Na Fila</p>
            <p class="text-2xl font-headline font-bold text-slate-800"><%= pacientesNaFila.length %></p>
        </div>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm flex items-center gap-4 border-l-4 border-orange-400">
        <div class="w-12 h-12 rounded-full bg-orange-50 flex items-center justify-center text-orange-500">
            <span class="material-symbols-outlined">event_repeat</span>
        </div>
        <div>
            <p class="text-[10px] font-label uppercase tracking-wider text-slate-500">Reservados</p>
            <p class="text-2xl font-headline font-bold text-slate-800"><%= pacientesReservados.length %></p>
        </div>
    </div>
</div>

<!-- Dashboard Body Layout -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Column Left: Daily Schedule (5 cols) -->
    <div class="lg:col-span-5 space-y-6 bg-medical-navy/80 p-6 rounded-xl shadow-sm">
        <div class="flex items-center justify-between">
            <h3 class="font-headline font-bold text-white text-lg text-slate-800">Agenda do Dia</h3>
            <a href="/agendamentos" class="text-xs font-label text-white-50 font-bold hover:underline">Ver Calendário Completo</a>
        </div>
        
        <div class="space-y-4">
            <% if (agendamentosHoje && agendamentosHoje.length > 0) { %>
                <% agendamentosHoje.forEach(agendamento => { %>
                    <div class="bg-white p-4 rounded-xl flex items-center gap-4 group hover:bg-slate-50 transition-all shadow-sm">
                        <div class="flex flex-col items-center justify-center w-16 h-16 rounded-lg bg-slate-100 text-slate-600 group-hover:bg-clinic-100 group-hover:text-clinic-600 transition-colors">
                            <span class="text-xs font-bold"><%= new Date(agendamento.dataHora).toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'}) %></span>
                        </div>
                        <div class="flex-1">
                            <h4 class="font-bold text-sm text-slate-800"><%= agendamento.paciente ? agendamento.paciente.nome : agendamento.nome %></h4>
                            <p class="text-xs text-slate-500"><%= agendamento.observacao || 'Consulta de rotina' %></p>
                        </div>
                        <span class="material-symbols-outlined text-slate-300 group-hover:text-clinic-600 transition-colors">chevron_right</span>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="bg-white p-8 rounded-xl text-center shadow-sm">
                    <p class="text-slate-500 text-sm">Nenhum agendamento para hoje.</p>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Column Right: Current Patient & Waiting Room (7 cols) -->
    <div class="lg:col-span-7 space-y-8">
        <!-- Patient Overview Card (Featured) -->
        <% if (pacientesNaFila && pacientesNaFila.length > 0) { %>
            <% const proximo = pacientesNaFila[0]; %>
            <div class="bg-gradient-to-br from-medical-navy to-clinic-700 p-8 rounded-xl text-white shadow-xl relative overflow-hidden group">
                <div class="absolute top-0 right-0 p-12 opacity-10 scale-150 group-hover:rotate-12 transition-transform duration-700">
                    <span class="material-symbols-outlined text-[120px]">visibility</span>
                </div>
                <div class="relative z-10">
                    <span class="inline-block px-3 py-1 bg-white/20 backdrop-blur-md rounded-full text-[10px] font-bold uppercase tracking-widest mb-4">Próximo Atendimento</span>
                    <div class="flex items-start gap-6">
                        <div class="w-20 h-20 rounded-xl border-4 border-white/30 bg-white/10 flex items-center justify-center text-3xl font-bold">
                            <%= proximo.nome.charAt(0) %>
                        </div>
                        <div>
                            <h2 class="text-2xl font-headline font-extrabold"><%= proximo.nome %></h2>
                            <p class="text-white/80 text-sm"><%= proximo.idade %> anos • CPF: <%= proximo.cpf || 'Não informado' %></p>
                            <div class="flex gap-4 mt-4">
                                <div class="bg-black/10 px-3 py-1 rounded-lg">
                                    <p class="text-[9px] uppercase opacity-60">Ficha nº</p>
                                    <p class="text-xs font-bold"><%= proximo.nFicha || 'N/D' %></p>
                                </div>
                                <div class="bg-black/10 px-3 py-1 rounded-lg">
                                    <p class="text-[9px] uppercase opacity-60">Chegada</p>
                                    <p class="text-xs font-bold"><%= new Date(proximo.createdAt).toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'}) %></p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-8 flex flex-wrap gap-3">
                        <a href="/pacientes/<%= proximo.idPaciente %>/ficha" class="bg-white text-clinic-700 px-8 py-3 rounded-full font-bold text-lg shadow-lg hover:bg-clinic-50 transition-colors flex items-center gap-2">
                            <span class="material-symbols-outlined text-lg">play_circle</span>
                            Iniciar Consulta
                        </a>
                    </div>
                </div>
            </div>
        <% } %>

        <!-- Waiting Room (Fila de Espera) -->
        <div class="space-y-4 bg-medical-navy/80 p-6 rounded-xl shadow-sm">
            <div class="flex items-center justify-between">
                <h3 class="font-headline font-bold text-white text-lg text-slate-800">Fila de Espera</h3>
                <div class="flex gap-2 items-center">
                    <span class="w-2 h-2 rounded-full bg-clinic-500 animate-pulse"></span>
                    <span class="text-[10px] text-white font-bold text-slate-500 uppercase tracking-widest"><%= pacientesNaFila.length %> Pacientes aguardando</span>
                </div>
            </div>
            
            <div class="bg-white rounded-xl overflow-hidden shadow-sm">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-slate-50">
                        <tr>
                            <th class="px-6 py-4 text-[11px] font-bold text-slate-500 uppercase tracking-wider">Paciente</th>
                            <th class="px-6 py-4 text-[11px] font-bold text-slate-500 uppercase tracking-wider">Ficha</th>
                            <th class="px-6 py-4 text-[11px] font-bold text-slate-500 uppercase tracking-wider">Horário</th>
                            <th class="px-6 py-4 text-right">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% if (pacientesNaFila && pacientesNaFila.length > 0) { %>
                            <% pacientesNaFila.forEach((paciente, index) => { %>
                                <tr class="hover:bg-clinic-50/30 transition-colors">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center font-bold text-xs text-slate-500">
                                                <%= paciente.nome.split(' ').map(n => n[0]).join('').substring(0,2).toUpperCase() %>
                                            </div>
                                            <span class="text-sm font-bold text-slate-800"><%= paciente.nome %></span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-slate-600"><%= paciente.nFicha || 'N/D' %></td>
                                    <td class="px-6 py-4 text-sm text-slate-500">
                                        <%= new Date(paciente.createdAt).toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'}) %>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="flex justify-end gap-2">
                                            <a href="/pacientes/<%= paciente.idPaciente %>/ficha" class="text-clinic-600 hover:bg-clinic-100 p-2 rounded-full transition-colors" title="Iniciar Atendimento">
                                                <span class="material-symbols-outlined">play_arrow</span>
                                            </a>
                                            <button onclick="abrirModalGenerico('/pacientes/<%= paciente.idPaciente %>', 'Dados do Paciente')" class="text-slate-400 hover:bg-slate-100 p-2 rounded-full transition-colors">
                                                <span class="material-symbols-outlined">visibility</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="px-6 py-8 text-center text-slate-500 text-sm">
                                    Nenhum paciente na fila no momento.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .font-headline { font-family: 'Manrope', sans-serif; }
    .font-label { font-family: 'Inter', sans-serif; }
</style>
