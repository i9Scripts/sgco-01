
<div class="bg-white/70 p-4 rounded-xl grid grid-cols-1 lg:grid-cols-4 gap-6 mb-8">
    <div class="lg:col-span-1 flex flex-col justify-center">
        <h2 class="font-headline text-2xl font-extrabold text-primary leading-tight">Olá, <%= profissional ? profissional.nome : 'Doutor' %></h2>
        <p class="text-secondary text-sm mt-2">Você tem <%= agendamentosHoje.length %> consultas agendadas para hoje.</p>
    </div>
    
    <!-- Quick Stats Counters -->
    <div class="bg-white p-6 rounded-xl shadow-sm flex items-center gap-4 border-l-4 border-clinic-500">
        <div class="w-12 h-12 rounded-full bg-clinic-100 flex items-center justify-center text-clinic-600">
            <span class="material-symbols-outlined">groups</span>
        </div>
        <div>
            <p class="text-[10px] font-label uppercase tracking-wider text-slate-500">Cadastrados</p>
            <p class="text-2xl font-headline font-bold text-slate-800"><%= stats.totalPacientes %></p>
        </div>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm flex items-center gap-4 border-l-4 border-medical-teal">
        <div class="w-12 h-12 rounded-full bg-teal-50 flex items-center justify-center text-medical-teal">
            <span class="material-symbols-outlined">visibility</span>
        </div>
        <div>
            <p class="text-[10px] font-label uppercase tracking-wider text-slate-500">% Miopia</p>
            <p class="text-2xl font-headline font-bold text-slate-800"><%= stats.percMiopia %><span class="text-sm">%</span></p>
        </div>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm flex items-center gap-4 border-l-4 border-orange-400">
        <div class="w-12 h-12 rounded-full bg-orange-50 flex items-center justify-center text-orange-500">
            <span class="material-symbols-outlined">visibility</span>
        </div>
        <div>
            <p class="text-[10px] font-label uppercase tracking-wider text-slate-500">% Hipermetropia</p>
            <p class="text-2xl font-headline font-bold text-slate-800"><%= stats.percHipermetropia %><span class="text-sm">%</span></p>
        </div>
    </div>
    
</div>

<!-- Dashboard Body Layout -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Column Left: Daily Schedule (5 cols) -->
    <div class="bg-white/70 p-4 rounded-xl lg:col-span-5 space-y-6">
        <div class="flex items-center justify-between">
            <h3 class="font-headline font-bold text-lg text-on-surface">Agenda do Dia</h3>
            <a href="/agendamentos" class="text-xs font-label text-primary font-bold hover:underline">Ver Calendário Completo</a>
        </div>
        <div class="space-y-4">
            <% if (agendamentosHoje && agendamentosHoje.length > 0) { %>
                <% agendamentosHoje.forEach(agendamento => { %>
                    <div class="bg-white p-4 rounded-xl flex items-center gap-4 group hover:bg-slate-50 transition-all shadow-sm">
                        <div class="flex flex-col items-center justify-center w-16 h-16 rounded-lg bg-slate-100 text-slate-600 group-hover:bg-clinic-100 group-hover:text-clinic-600 transition-colors">
                            <span class="text-xs font-bold"><%= new Date(agendamento.dataHora).toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'}) %></span>
                        </div>
                        <div class="flex-1">
                            <h4 class="font-bold text-sm text-slate-800"><%= agendamento.paciente ? agendamento.paciente.nome : agendamento.nome %></h4>
                            <p class="text-xs text-secondary truncate"><%= agendamento.observacao || 'Consulta de rotina' %></p>
                        </div>
                        <span class="material-symbols-outlined text-slate-300 group-hover:text-clinic-600 transition-colors">chevron_right</span>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="bg-white p-8 rounded-xl text-center shadow-sm">
                    <p class="text-secondary text-sm">Nenhum agendamento para hoje.</p>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Column Right: Current Patient & Waiting Room (7 cols) -->
    <div class="lg:col-span-7 space-y-8">
        <!-- Patient Overview Card (Featured) -->
        <% if (pacientesNaFila && pacientesNaFila.length > 0) { %>
            <% const proximo = pacientesNaFila[0]; %>
            <div class="refraction-gradient p-8 rounded-xl text-white shadow-xl relative overflow-hidden group">
                <div class="absolute top-0 right-0 p-12 opacity-10 scale-150 group-hover:rotate-12 transition-transform duration-700">
                    <span class="material-symbols-outlined text-[120px]">visibility</span>
                </div>
                <div class="relative z-10">
                    <span class="inline-block px-3 py-1 bg-white/20 backdrop-blur-md rounded-full text-[10px] font-bold uppercase tracking-widest mb-4">Próximo Atendimento</span>
                    <div class="flex items-start gap-6">
                        <div class="w-20 h-20 rounded-xl border-4 border-white/30 bg-white/10 flex items-center justify-center text-3xl font-bold">
                            <%= proximo.nome.charAt(0) %>
                        </div>
                        <div>
                            <h2 class="text-2xl font-headline font-extrabold"><%= proximo.nome %></h2>
                            <p class="text-white/80 text-sm"><%= proximo.idade %> anos • CPF: <%= proximo.cpf || 'Não informado' %></p>
                            <div class="flex gap-4 mt-4">
                                <div class="bg-black/10 px-3 py-1 rounded-lg">
                                    <p class="text-[9px] uppercase opacity-60">Ficha nº</p>
                                    <p class="text-xs font-bold"><%= (proximo.anamneses && proximo.anamneses.length > 0) ? proximo.anamneses[0].nFicha : 'N/D' %></p>
                                </div>
                                <div class="bg-black/10 px-3 py-1 rounded-lg">
                                    <p class="text-[9px] uppercase opacity-60">Entrada</p>
                                    <p class="text-xs font-bold"><%= new Date(proximo.createdAt).toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'}) %></p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-8 flex gap-3">
                        <a href="/pacientes/<%= proximo.idPaciente %>/ficha" class="bg-white text-primary px-6 py-3 rounded-full font-bold text-sm shadow-lg hover:bg-clinic-50 transition-colors flex items-center gap-2">
                            <span class="material-symbols-outlined text-lg">history</span>
                            Abrir Prontuário
                        </a>
                    </div>
                </div>
            </div>
        <% } %>

    </div>
</div>
        <!-- Waiting Room (Fila de Espera) -->
        <div class="lg:col-span-12 space-y-6 p-4">
            <div class="bg-medical-navy/60 flex items-center justify-between rounded-xl p-4">
                <div class="flex items-center gap-3">
                    <div class="w-2 h-8 bg-clinic-500 rounded-full"></div>
                    <h3 class="text-white font-headline font-extrabold text-xl tracking-tight">Fila de Espera</h3>
                </div>
                <div class="px-4 py-1.5 bg-emerald-100 text-emerald-700 rounded-full text-[10px] font-black uppercase tracking-widest border border-emerald-200 animate-pulse">
                    <%= pacientesNaFila.length %> Aguardando
                </div>
            </div>
            <div id="fila-de-espera-profissional" class="transition-all duration-500">
                <%- include('../partials/_filaEspera.ejs', { pacientes: pacientesNaFila, isProfissional: true }) %>
            </div>
        </div>



<style>
    .font-headline { font-family: 'Manrope', sans-serif; }
    .font-label { font-family: 'Inter', sans-serif; }
    .refraction-gradient {
        background: linear-gradient(135deg, #006573 0%, #50e1f9 100%);
    }
</style>
