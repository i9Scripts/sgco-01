<div class="container-fluid py-4">


    <% if (messages.error) { %>
        <div class="alert alert-danger" role="alert"><%= messages.error %></div>
    <% } %>
    <% if (messages.success) { %>
        <div class="alert alert-success" role="alert"><%= messages.success %></div>
    <% } %>

    <div class="row text-center mb-5">
        <div class="col-md-4 mb-3">
            <!-- Botão para adicionar novo paciente -->
          <button class="btn btn-primary btn-lg btn-block custom-dashboard-btn" title="Adicionar Novo Paciente" onclick="abrirModalGenerico('/pacientes/new','Novo Paciente')">
            <span class="bi bi-person-plus-fill icon-large"></span>
          </button>
        </div>
        <div class="col-md-4 mb-3">
            <button class="btn btn-success btn-lg btn-block custom-dashboard-btn" title="Buscar Paciente / Anamnese" onclick="abrirModalGenerico('/pacientes','Novo Paciente')">
            <span class="bi bi-search icon-large"></span>
          </button>
        </div>
        <div class="col-md-4 mb-3">
            <button class="btn btn-info btn-lg btn-block custom-dashboard-btn" title="Registrar Pagamento" onclick="abrirModalGenerico('/financeiro/cobrar','Novo Paciente')">
            <span class="bi bi-cash-coin icon-large"></span>
          </button>
        </div>
        
    </div>

    <hr>

    <h2 class="text-center mb-4">Fila de Espera</h2>
    <div id="fila-de-espera-recepcao">
        <%- include('./partials/_filaEspera.ejs', { pacientes: pacientesNaFila }) %>
    </div>
</div>
<div><%- include('./partials/_modal') %></div>
<style>
    /* Estilos básicos para os botões do dashboard */
    .custom-dashboard-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100px; /* Altura fixa para todos os botões */
        font-size: 1.1rem;
        border-radius: 10px;
        transition: all 0.3s ease;
        text-decoration: none;
        color: white; /* Garante que o texto seja branco para todos os botões */
    }
    .custom-dashboard-btn .icon-large {
        font-size: 3rem; /* Tamanho maior para o ícone */
        margin-bottom: 10px;
    }
    .custom-dashboard-btn:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.2);
    }
</style>


<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
