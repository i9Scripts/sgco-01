<div class="container-fluid py-4">
    <% if (messages.error) { %>
        <div class="alert alert-danger" role="alert"><%= messages.error %></div>
    <% } %>
    <% if (messages.success) { %>
        <div class="alert alert-success" role="alert"><%= messages.success %></div>
    <% } %>

    <div class="row">
        <!-- Left: Fila de Espera -->
        <div class="col-lg-8 mb-4">
            <div class="card shadow h-100">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Fila de Espera</h6>
                </div>
                <div class="card-body">
                    <div id="fila-de-espera-recepcao">
                        <%- include('./partials/_filaEspera.ejs', { pacientes: pacientesNaFila }) %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Ações rápidas -->
        <div class="col-lg-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Ações Rápidas</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-3">
                        <button class="btn btn-primary btn-block" title="Adicionar Novo Paciente" onclick="abrirModalGenerico('/pacientes/new','Novo Paciente')">
                            <span class="bi bi-person-plus-fill"></span>Paciente
                        </button>
                        <a href="/pacientes" class="btn btn-success btn-block" title="Buscar Paciente"><span class="bi bi-search"></span> Paciente</a>
                        <a href="/agendamentos" class="btn btn-warning btn-block" title="Ver Agenda"><span class="bi bi-calendar-event"></span> Agenda</a>
                        <button class="btn btn-info btn-block" title="Registrar Pagamento" onclick="abrirModalGenerico('/financeiro/selecionar-paciente','Novo Paciente')">
                            <span class="bi bi-cash-coin"></span> Pagamento
                        </button>
                        <a href="/produtos" class="btn btn-success btn-block" title="Buscar Produtos"><span class="bi bi-basket"></span> Produtos</a>
                        <a href="/parceiros" class="btn btn-secondary btn-block" title="Ver Parceiros"><span class="bi bi-people"></span> Parceiros</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div><%- include('./partials/_modal') %></div>
</div>