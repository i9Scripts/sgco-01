<div class="container-fluid py-4">


    <% if (messages.error) { %>
        <div class="alert alert-danger" role="alert"><%= messages.error %></div>
    <% } %>
    <% if (messages.success) { %>
        <div class="alert alert-success" role="alert"><%= messages.success %></div>
    <% } %>

    <div class="row text-center mb-5">
        <div class="col-md-4 mb-3">
            <!-- Botão para adicionar novo paciente -->
          <button class="btn btn-primary btn-lg btn-block custom-dashboard-btn" title="Adicionar Novo Paciente" onclick="abrirModalGenerico('/pacientes/new','Novo Paciente')">
            <span class="bi bi-person-plus-fill icon-large"></span>
          </button>
        </div>
        <div class="col-md-4 mb-3">

          <a href="/pacientes" class="btn btn-success btn-lg btn-block custom-dashboard-btn" title="Buscar Paciente"><span class="bi bi-search icon-large"></span></a>
        </div>
        <div class="col-md-4 mb-3">
            <button class="btn btn-info btn-lg btn-block custom-dashboard-btn" title="Registrar Pagamento" onclick="abrirModalGenerico('/financeiro/selecionar-paciente','Novo Paciente')">
            <span class="bi bi-cash-coin icon-large"></span>
          </button>
        </div>
        
    </div>

    <hr>

    <h2 class="text-center mb-4">Fila de Espera</h2>
    <div id="fila-de-espera-recepcao">
        <%- include('./partials/_filaEspera.ejs', { pacientes: pacientesNaFila }) %>
    </div>
    
</div>
<div><%- include('./partials/_modal') %></div>