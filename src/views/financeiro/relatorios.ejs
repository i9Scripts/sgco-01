<div class="container-fluid py-4">
    <% if (messages.error) { %>
        <div class="alert alert-danger" role="alert"><%= messages.error %></div>
    <% } %>
    <% if (messages.success) { %>
        <div class="alert alert-success" role="alert"><%= messages.success %></div>
    <% } %>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Relatórios Financeiros</h6>
        </div>
        <div class="card-body">
            <div class="row text-center">
                <div class="col-md-6 mb-3">
                    <a href="/financeiro/relatorios/vendas-dia" class="btn btn-outline-primary btn-lg btn-block">
                        <i class="bi bi-calendar-day" style="font-size:2rem"></i>
                        <div>Vendas do Dia</div>
                    </a>
                </div>
                <div class="col-md-6 mb-3">
                    <a href="/financeiro/extrato" class="btn btn-outline-secondary btn-lg btn-block">
                        <i class="bi bi-receipt" style="font-size:2rem"></i>
                        <div>Extrato Completo</div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
