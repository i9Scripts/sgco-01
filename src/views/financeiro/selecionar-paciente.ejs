<div class="max-w-6xl mx-auto space-y-6">
  <!-- Cabeçalho e Busca -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="flex-1 max-w-2xl">
      <form action="/financeiro/selecionar-paciente" method="get" class="relative group">
        <input
          type="text"
          name="search"
          placeholder="Buscar paciente por nome..."
          value="<%= query || '' %>"
          class="w-full h-12 pl-12 pr-4 text-sm font-semibold border-2 border-slate-200 rounded-xl bg-white focus:ring-0 focus:border-clinic-500 outline-none transition-all shadow-sm"
        />
        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-clinic-500 transition-colors">
          search
        </span>
        <button type="submit" class="hidden">Buscar</button>
      </form>
    </div>

    <div class="flex items-center gap-3">
      <h2 class="text-xl font-black text-slate-800 hidden md:block">
        Cobrança
      </h2>
    </div>
  </div>

  <!-- Lista de Pacientes -->
  <div class="bg-white/80 rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="bg-slate-50 px-6 py-4 border-b border-slate-200">
        <h3 class="text-xs font-extrabold text-slate-500 uppercase tracking-widest">Selecione um paciente para iniciar o faturamento</h3>
    </div>

    <% if (pacientes.length === 0) { %>
    <div class="p-12 text-center">
      <div class="bg-slate-50 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
        <span class="material-symbols-outlined text-3xl text-slate-300">person_search</span>
      </div>
      <h3 class="text-lg font-bold text-slate-800">Nenhum paciente encontrado</h3>
      <p class="text-slate-500 text-sm mb-6">Tente ajustar sua busca ou verifique se o paciente está cadastrado.</p>
      <a
        href="/pacientes/new"
        class="inline-flex items-center px-6 py-2.5 bg-clinic-500 text-white rounded-xl font-bold hover:bg-clinic-600 shadow-lg shadow-clinic-100 transition-all"
      >
        <span class="material-symbols-outlined mr-2">person_add</span>
        Cadastrar Novo Paciente
      </a>
    </div>
    <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200">
            <th class="px-6 py-4 text-xs font-extrabold text-slate-500 uppercase tracking-wider">Paciente</th>
            <th class="px-6 py-4 text-xs font-extrabold text-slate-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-4 text-xs font-extrabold text-slate-500 uppercase tracking-wider text-right">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% pacientes.forEach(p => { %>
          <tr class="hover:bg-slate-50/50 transition-colors group">
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-clinic-50 flex items-center justify-center text-clinic-600 font-black text-sm">
                  <%= p.nome.charAt(0).toUpperCase() %>
                </div>
                <div>
                  <p class="text-sm font-bold text-slate-800"><%= p.nome %></p>
                  <% if (p.anamneses && p.anamneses.length > 0) { %>
                    <p class="text-[12px] font-bold text-slate-600 uppercase tracking-tighter">Ficha: <%= p.anamneses[0].nFicha %></p>
                  <% } %>
                </div>
              </div>
            </td>
            <td class="px-6 py-4">
              <% if (p.naFila) { %>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-black uppercase bg-emerald-100 text-emerald-700 border border-emerald-200">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                  Na Fila
                </span>
              <% } else { %>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-black uppercase bg-slate-100 text-slate-500 border border-slate-200">
                  Fora da Fila
                </span>
              <% } %>
            </td>
            <td class="px-6 py-4 text-right">
              <a 
                href="/financeiro/cobrar/<%= p.idPaciente %>?parceiroId=" 
                class="inline-flex items-center gap-2 px-4 py-2 bg-clinic-500 text-white rounded-lg font-bold text-xs hover:bg-clinic-600 shadow-md shadow-clinic-100 transition-all transform group-hover:scale-105"
                title="Iniciar Cobrança"
              >
                <span class="material-symbols-outlined text-sm">payments</span>
                Cobrar
              </a>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>
