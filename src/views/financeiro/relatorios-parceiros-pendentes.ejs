<div class="max-w-6xl mx-auto p-6">
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden p-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xl font-bold">Parceiros com Pagamentos Pendentes</h2>
      <div class="text-sm text-slate-500">Relatório imprimível</div>
    </div>

    <form method="GET" action="/financeiro/relatorios/parceiros-pendentes" class="flex gap-3 items-end mb-6">
      <div>
        <label class="text-xs font-bold text-slate-500">Início</label>
        <input type="date" name="startDate" value="<%= startDate %>" class="border p-2 rounded" />
      </div>
      <div>
        <label class="text-xs font-bold text-slate-500">Fim</label>
        <input type="date" name="endDate" value="<%= endDate %>" class="border p-2 rounded" />
      </div>
      <div>
        <button type="submit" class="px-4 py-2 bg-clinic-500 text-white rounded">Filtrar</button>
      </div>
      <div>
        <button type="button" onclick="window.print()" class="px-4 py-2 bg-slate-200 rounded">Imprimir</button>
      </div>
    </form>

    <% if (!parceiros || parceiros.length === 0) { %>
      <div class="p-6 text-center text-slate-500">Nenhum parceiro com pagamentos pendentes no período selecionado.</div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full table-auto border-collapse">
          <thead>
            <tr class="bg-slate-50">
              <th class="px-4 py-2 text-left">Parceiro</th>
              <th class="px-4 py-2 text-right">Total Devido (R$)</th>
              <th class="px-4 py-2 text-center">Quantidade de Consultas</th>
            </tr>
          </thead>
          <tbody>
            <% parceiros.forEach(function(p){ %>
              <tr class="border-t">
                <td class="px-4 py-3"><%= p.nome %></td>
                <td class="px-4 py-3 text-right"><%= (p.total || 0).toFixed(2) %></td>
                <td class="px-4 py-3 text-center"><%= p.count %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<style>
  @media print { .no-print { display: none !important } }
</style>
