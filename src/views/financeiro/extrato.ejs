<!-- Cabeçalho e Título -->
<div class="bg-white/80 rounded-2xl mb-8 p-5">
    <div class="flex items-center gap-3 mb-2">
        <span class="material-symbols-outlined text-clinic-500 text-3xl">receipt_long</span>
        <h2 class="text-2xl font-black text-slate-800 tracking-tight">Extrato Financeiro</h2>
    </div>
    <p class="text-slate-500 font-medium">Histórico completo de lançamentos e movimentações do consultório.</p>
</div>

<!-- Filtros e Resumo -->
<div class="flex flex-col lg:flex-row gap-6 mb-8">
    <!-- Card de Filtro -->
    <div class="flex-1 bg-white/80 rounded-2xl shadow-sm border border-slate-200 p-5">
        <form action="/financeiro/extrato" method="get" class="flex flex-col md:flex-row items-end gap-4">
            <div class="flex-1 grid grid-cols-1 md:grid-cols-2 gap-4 w-full">
                <div class="space-y-1.5">
                    <label class="text-xs font-black text-slate-500 uppercase tracking-widest ml-1">Data Inicial</label>
                    <div class="relative">
                        <input type="date" name="startDate" value="<%= startDate || '' %>" 
                            class="w-full h-11 pl-4 pr-4 text-sm font-bold border-2 border-slate-100 rounded-xl bg-slate-50/50 focus:ring-0 focus:border-clinic-500 focus:bg-white outline-none transition-all" />
                    </div>
                </div>
                <div class="space-y-1.5">
                    <label class="text-xs font-black text-slate-500 uppercase tracking-widest ml-1">Data Final</label>
                    <div class="relative">
                        <input type="date" name="endDate" value="<%= endDate || '' %>" 
                            class="w-full h-11 pl-4 pr-4 text-sm font-bold border-2 border-slate-100 rounded-xl bg-slate-50/50 focus:ring-0 focus:border-clinic-500 focus:bg-white outline-none transition-all" />
                    </div>
                </div>
            </div>
            <div class="flex gap-2 w-full md:w-auto">
                <button type="submit" class="flex-1 md:flex-none h-11 px-6 bg-clinic-500 text-white rounded-xl font-bold hover:bg-clinic-600 shadow-lg shadow-clinic-100 transition-all flex items-center justify-center whitespace-nowrap group">
                    <span class="material-symbols-outlined mr-2 group-hover:scale-110 transition-transform">filter_list</span>
                    Filtrar
                </button>
                <a href="/financeiro/extrato" class="flex-1 md:flex-none h-11 px-4 bg-slate-100 text-slate-600 rounded-xl font-bold hover:bg-slate-200 transition-all flex items-center justify-center">
                    <span class="material-symbols-outlined">restart_alt</span>
                </a>
            </div>
        </form>
    </div>

    <!-- Cards de Resumo -->
    <div class="flex gap-4">
        <% 
            const totalLancamentos = (lancamentos && lancamentos.length) ? lancamentos.length : 0; 
            const totalValor = (lancamentos && lancamentos.length) ? lancamentos.reduce((s, l) => s + (Number(l?.valorTotal) || 0), 0).toFixed(2) : '0.00'; 
        %>
        <div class="bg-clinic-500 rounded-2xl shadow-lg shadow-clinic-100 p-5 min-w-[160px] text-white">
            <p class="text-[10px] font-black uppercase tracking-[0.2em] opacity-80 mb-1">Registros</p>
            <div class="flex items-end gap-2">
                <span class="text-3xl font-black"><%= totalLancamentos %></span>
                <span class="text-xs font-bold mb-1.5 opacity-80 uppercase">itens</span>
            </div>
        </div>
        <div class="bg-slate-800 rounded-2xl shadow-lg shadow-slate-200 p-5 min-w-[200px] text-white">
            <p class="text-[10px] font-black uppercase tracking-[0.2em] opacity-60 mb-1 text-slate-400">Total Período</p>
            <div class="flex items-end gap-1">
                <span class="text-xs font-bold mb-1.5 text-slate-400">R$</span>
                <span class="text-3xl font-black text-clinic-400 leading-none"><%= totalValor %></span>
            </div>
        </div>
    </div>
</div>

<!-- Tabela de Lançamentos -->
<div class="bg-white/80 rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <% if (lancamentos && lancamentos.length > 0) { %>
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-200">
                    <th class="px-6 py-4 text-xs font-extrabold text-slate-500 uppercase tracking-wider">Data</th>
                    <th class="px-6 py-4 text-xs font-extrabold text-slate-500 uppercase tracking-wider">Paciente</th>
                    <th class="px-6 py-4 text-xs font-extrabold text-slate-500 uppercase tracking-wider">Descrição</th>
                    <th class="px-6 py-4 text-xs font-extrabold text-slate-500 uppercase tracking-wider">Parceiro</th>
                    <th class="px-6 py-4 text-xs font-extrabold text-slate-500 uppercase tracking-wider text-right">Valor Total</th>
                    <th class="px-6 py-4 text-xs font-extrabold text-slate-500 uppercase tracking-wider text-center">Pagamento</th>
                    <th class="px-6 py-4 text-xs font-extrabold text-slate-500 uppercase tracking-wider text-center">Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                <% lancamentos.forEach(lancamento => { %>
                    <tr class="hover:bg-slate-50/50 transition-colors group">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="text-sm font-bold text-slate-600">
                                <%= new Date(lancamento.createdAt).toLocaleDateString('pt-BR', { timeZone: 'UTC' }) %>
                            </span>
                        </td>
                        <td class="px-6 py-4">
                            <p class="text-sm font-black text-slate-800 group-hover:text-clinic-600 transition-colors"><%= lancamento.paciente?.nome || '---' %></p>
                        </td>
                        <td class="px-6 py-4">
                            <p class="text-sm text-slate-500 font-medium italic"><%= lancamento.observacao || 'Atendimento' %></p>
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-[18px] text-slate-400">handshake</span>
                                <span class="text-sm text-slate-600 font-bold"><%= lancamento.parceiro?.nome || 'Particular' %></span>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex flex-col items-end">
                                <span class="text-sm font-black text-slate-800">R$ <%= (Number(lancamento.valorTotal) || 0).toFixed(2) %></span>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[10px] font-black uppercase bg-slate-100 text-slate-600 border border-slate-200">
                                <%= (lancamento.pagamentos && lancamento.pagamentos.length > 0) ? lancamento.pagamentos[0].formaPagamento : '---' %>
                            </span>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <% if (lancamento.status === 'PAGO') { %>
                                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[10px] font-black uppercase bg-emerald-100 text-emerald-700 border border-emerald-200">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>
                                    Pago
                                </span>
                            <% } else if (lancamento.status === 'PENDENTE') { %>
                                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[10px] font-black uppercase bg-amber-100 text-amber-700 border border-amber-200">
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-1.5"></span>
                                    Pendente
                                </span>
                            <% } else { %>
                                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[10px] font-black uppercase bg-slate-100 text-slate-700 border border-slate-200">
                                    <%= lancamento.status %>
                                </span>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <% } else { %>
        <div class="p-16 text-center">
            <div class="bg-slate-50 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6 border border-slate-100">
                <span class="material-symbols-outlined text-4xl text-slate-300 font-light">receipt_long</span>
            </div>
            <h3 class="text-xl font-black text-slate-800 mb-2 tracking-tight">Nenhum lançamento encontrado</h3>
            <p class="text-slate-500 font-medium mb-8">Não encontramos registros financeiros para o período selecionado.</p>
            <a href="/financeiro/selecionar-paciente" class="inline-flex items-center px-6 py-3 bg-clinic-500 text-white rounded-xl font-bold hover:bg-clinic-600 shadow-lg shadow-clinic-100 transition-all">
                <span class="material-symbols-outlined mr-2">add_circle</span>
                Registrar Nova Cobrança
            </a>
        </div>
    <% } %>
</div>
