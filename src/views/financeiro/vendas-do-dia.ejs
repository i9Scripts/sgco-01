<div class="max-w-6xl mx-auto p-6">
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-6 flex items-center justify-between border-b">
            <div>
                <h2 class="text-xl font-bold">Vendas do Dia</h2>
                <p class="text-sm text-slate-500">Resumo das vendas realizadas hoje</p>
            </div>
            <div class="text-right">
                <div class="text-xs text-slate-500">Total</div>
                <div class="text-2xl font-black">R$ <%= total %></div>
            </div>
        </div>

        <div class="p-6">
            <form method="GET" action="/financeiro/relatorios/vendas-dia" class="flex flex-wrap gap-3 mb-4">
                <input type="text" name="q" placeholder="Pesquisar paciente, parceiro ou observação" value="<%= q || '' %>" class="px-3 py-2 border rounded w-full sm:w-1/2" />
                <select name="status" class="px-3 py-2 border rounded">
                    <option value="">Todos os status</option>
                    <% (statuses || []).forEach(function(s){ %>
                        <option value="<%= s %>" <%= statusFilter === s ? 'selected' : '' %>><%= s %></option>
                    <% }) %>
                </select>
                <select name="pageSize" class="px-3 py-2 border rounded">
                    <option value="10" <%= pageSize==10 ? 'selected' : '' %>>10</option>
                    <option value="15" <%= pageSize==15 ? 'selected' : '' %>>15</option>
                    <option value="25" <%= pageSize==25 ? 'selected' : '' %>>25</option>
                    <option value="50" <%= pageSize==50 ? 'selected' : '' %>>50</option>
                </select>
                <button type="submit" class="px-4 py-2 bg-clinic-500 text-white rounded">Aplicar</button>
            </form>

            <% if (!vendas || vendas.length === 0) { %>
                <div class="p-6 text-center text-slate-500">Nenhuma venda registrada hoje.</div>
            <% } else { %>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50 text-sm text-slate-600">
                                <th class="px-4 py-3">Hora</th>
                                <th class="px-4 py-3">Paciente</th>
                                <th class="px-4 py-3">Parceiro</th>
                                <th class="px-4 py-3">Observação</th>
                                <th class="px-4 py-3 text-right">Valor (R$)</th>
                                <th class="px-4 py-3 text-center">Forma</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% vendas.forEach(function(v){ %>
                                <tr class="border-t">
                                    <td class="px-4 py-3 text-sm text-slate-500"><%= new Date(v.createdAt).toLocaleTimeString('pt-BR') %></td>
                                    <td class="px-4 py-3 font-bold text-slate-700"><%= v.paciente ? v.paciente.nome : '—' %></td>
                                    <td class="px-4 py-3 text-sm"><%= v.parceiro ? v.parceiro.nome : 'Particular' %></td>
                                    <td class="px-4 py-3 text-xs text-slate-500 italic"><%= v.observacao || '—' %></td>
                                    <td class="px-4 py-3 text-right font-mono font-bold">R$ <%= (Number(v.valorTotal) || 0).toFixed(2) %></td>
                                    <td class="px-4 py-3 text-center text-xs">
                                        <span class="px-2 py-1 bg-slate-100 rounded-md">
                                            <%= (v.pagamentos && v.pagamentos.length > 0) ? v.pagamentos[0].formaPagamento : '—' %>
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Paginação -->
                <div class="mt-4 flex items-center justify-between">
                    <div class="text-sm text-slate-500">Página <%= page %> de <%= pageCount %></div>
                    <div class="flex items-center gap-2">
                        <% const prevPage = page > 1 ? page - 1 : 1; %>
                        <% const nextPage = page < pageCount ? page + 1 : pageCount; %>
                        <a href="?q=<%= encodeURIComponent(q || '') %>&status=<%= encodeURIComponent(statusFilter || '') %>&pageSize=<%= pageSize %>&page=<%= prevPage %>" class="px-3 py-2 bg-slate-100 rounded hover:bg-slate-200">Anterior</a>
                        <a href="?q=<%= encodeURIComponent(q || '') %>&status=<%= encodeURIComponent(statusFilter || '') %>&pageSize=<%= pageSize %>&page=<%= nextPage %>" class="px-3 py-2 bg-slate-100 rounded hover:bg-slate-200">Próxima</a>
                    </div>
                </div>
            <% } %>
        </div>

        <div class="p-6 border-t flex justify-between items-center">
            <a href="/financeiro/relatorios" class="px-4 py-2 bg-slate-200 rounded no-underline text-slate-700 font-bold">Voltar</a>
            <button onclick="window.print()" class="px-4 py-2 bg-clinic-500 text-white rounded font-bold">Imprimir Relatório</button>
        </div>
    </div>
</div>
