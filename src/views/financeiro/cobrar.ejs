<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">PDV para Paciente: <%= paciente.nome %></h6>
                </div>
                <div class="card-body">
                    <% if (messages.error) { %>
                        <div class="alert alert-danger" role="alert"><%= messages.error %></div>
                    <% } %>
                    <% if (messages.success) { %>
                        <div class="alert alert-success" role="alert"><%= messages.success %></div>
                    <% } %>

                    <form action="/financeiro/registrar" method="POST">
                        <input type="hidden" name="pacienteId" value="<%= paciente.idPaciente %>">
                        <input type="hidden" name="parceiroId" id="parceiroIdField" value="<%= parceiro ? parceiro.idParceiro : '' %>">

                        <div class="form-group row mb-3">
                            <label class="col-sm-4 col-form-label">Paciente:</label>
                            <div class="col-sm-8">
                                <p class="form-control-plaintext"><%= paciente.nome %></p>
                            </div>
                        </div>

                        <div class="form-group row mb-3">
                            <label for="produtoSelect" class="col-sm-4 col-form-label">Produto/Serviço:</label>
                            <div class="col-sm-8">
                                <select class="form-control" id="produtoSelect" name="produtoId" required>
                                    <option value="">Selecione um produto</option>
                                    <% produtos.forEach(produto => { %>
                                        <option value="<%= produto.idProduto %>" data-valor="<%= produto.valor %>">
                                            <%= produto.descricao %> - R$ <%= produto.valor %>
                                        </option>
                                    <% }); %>
                                </select>
                            </div>
                        </div>

                        <div class="form-group row mb-3">
                            <label for="parceiroSelect" class="col-sm-4 col-form-label">Parceiro:</label>
                            <div class="col-sm-8">
                                <select class="form-control" id="parceiroSelect" name="parceiroSelect">
                                    <option value="">Particular</option>
                                    <% parceiros.forEach(p => { %>
                                        <option value="<%= p.idParceiro %>" data-desconto="<%= p.desconto %>" <%= (parceiro && parceiro.idParceiro === p.idParceiro) ? 'selected' : '' %>>
                                            <%= p.nome %>
                                        </option>
                                    <% }); %>
                                </select>
                            </div>
                        </div>

                        <div class="form-group row mb-3">
                            <label class="col-sm-4 col-form-label">Valor Bruto (R$):</label>
                            <div class="col-sm-8">
                                <input type="text" class="form-control-plaintext" id="valorBruto" name="valorBruto" value="0.00" readonly>
                            </div>
                        </div>

                        <div class="form-group row mb-3">
                            <label class="col-sm-4 col-form-label">Desconto (R$):</label>
                            <div class="col-sm-8">
                                <input type="text" class="form-control" id="valorDesconto" name="valorDesconto" value="<%= valorDesconto %>">
                            </div>
                        </div>

                        <div class="form-group row mb-3">
                            <label class="col-sm-4 col-form-label font-weight-bold">Valor Final (R$):</label>
                            <div class="col-sm-8">
                                <input type="text" class="form-control-plaintext font-weight-bold text-success" id="valorFinal" name="valorFinal" value="0.00" readonly>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label for="formaPagamento">Forma de Pagamento:</label>
                            <select class="form-control" id="formaPagamento" name="formaPagamento" required>
                                <% formasPagamento.forEach(forma => { %>
                                    <option value="<%= forma %>"><%= forma %></option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="form-group mb-3">
                            <label for="observacao">Observações (opcional):</label>
                            <textarea class="form-control" id="observacao" name="observacao" rows="3"></textarea>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">Registrar Pagamento</button>
                            <a href="/" class="btn btn-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const produtoSelect = document.getElementById('produtoSelect');
        const parceiroSelect = document.getElementById('parceiroSelect');
        const parceiroIdField = document.getElementById('parceiroIdField');
        const valorBrutoInput = document.getElementById('valorBruto');
        const valorDescontoInput = document.getElementById('valorDesconto');
        const valorFinalInput = document.getElementById('valorFinal');

        function calcularValorFinal() {
            const valorBruto = parseFloat(valorBrutoInput.value) || 0;
            const valorDesconto = parseFloat(valorDescontoInput.value) || 0;
            const valorFinal = valorBruto - valorDesconto;
            valorFinalInput.value = valorFinal.toFixed(2);
        }

        produtoSelect.addEventListener('change', function() {
            const selectedOption = this.options[this.selectedIndex];
            const valor = selectedOption.dataset.valor || 0;
            valorBrutoInput.value = parseFloat(valor).toFixed(2);
            calcularValorFinal();
        });

        parceiroSelect.addEventListener('change', function() {
            const selectedOption = this.options[this.selectedIndex];
            const desconto = selectedOption.dataset.desconto || 0;
            const parceiroId = selectedOption.value;

            parceiroIdField.value = parceiroId;
            valorDescontoInput.value = parseFloat(desconto).toFixed(2);
            calcularValorFinal();
        });

        valorDescontoInput.addEventListener('input', function() {
            calcularValorFinal();
        });

        // Initial calculation on page load
        calcularValorFinal();
    });
</script>
