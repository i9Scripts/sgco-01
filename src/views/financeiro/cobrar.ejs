<div class="max-w-7xl mx-auto h-[calc(100vh-120px)] flex flex-col">
  <!-- Top Bar: Paciente & Contexto -->
  <div class="bg-white p-4 rounded-xl shadow-sm mb-6 flex items-center justify-between border border-slate-200">
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 rounded-full bg-[#006573]/10 flex items-center justify-center text-[#006573]">
        <span class="material-symbols-outlined">person</span>
      </div>
      <div>
        <h2 class="text-lg font-bold text-slate-800"><%= paciente.nome %></h2>
        <div class="flex gap-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">
          <span>Ficha: <%= (paciente.anamneses && paciente.anamneses.length > 0) ? paciente.anamneses[0].nFicha : 'N/D' %></span>
          <span class="text-slate-300">|</span>
          <span>CPF: <%= paciente.cpf || 'N/D' %></span>
        </div>
      </div>
    </div>
    <div class="flex items-center gap-6">
      <div class="text-right">
        <p class="text-[10px] uppercase font-bold text-slate-400">Data da Operação</p>
        <p class="font-bold text-slate-700"><%= new Date().toLocaleDateString('pt-BR') %></p>
      </div>
      <a href="/financeiro/selecionar-paciente" class="p-2 text-slate-400 hover:text-error transition-colors">
        <span class="material-symbols-outlined">cancel</span>
      </a>
    </div>
  </div>

  <form id="cobrarForm" action="/financeiro/registrar" method="POST" class="flex flex-col lg:flex-row gap-6 flex-1 min-h-0 overflow-hidden">
    <!-- Hidden Fields -->
    <input type="hidden" name="pacienteId" value="<%= paciente.idPaciente %>">
    <input type="hidden" name="parceiroId" id="parceiroIdField" value="<%= (typeof parceiro !== 'undefined' && parceiro) ? parceiro.idParceiro : '' %>">
    <input type="hidden" name="items" id="itemsField" value="[]">
    <input type="hidden" name="valorBruto" id="valorBrutoField" value="0.00">
    <input type="hidden" name="valorFinal" id="valorFinalField" value="0.00">
    <input type="hidden" name="valorDesconto" id="valorDescontoField" value="<%= valorDesconto %>">
    <input type="hidden" name="tipoItem" id="tipoItemValue" value="servico">
    <input type="hidden" name="formaPagamento" id="formaPagamentoValue" value="<%= (typeof formasPagamento !== 'undefined' && formasPagamento.length > 0) ? formasPagamento[0] : '' %>">

    <!-- Left Column: Search & Item Grid -->
    <div class="lg:w-2/3 flex flex-col gap-6 min-h-0">
      <!-- Search & Filters -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
        <div class="flex flex-col md:flex-row gap-4 justify-between items-center mb-6">
          <div class="flex bg-slate-100 p-1 rounded-xl w-full md:w-auto">
            <button type="button" onclick="setTipoItem('servico', this)" class="tipo-btn flex-1 md:flex-none px-6 py-2 rounded-lg font-bold text-xs transition-all bg-white text-[#006573] shadow-sm">
              Serviços
            </button>
            <button type="button" onclick="setTipoItem('produto', this)" class="tipo-btn flex-1 md:flex-none px-6 py-2 rounded-lg font-bold text-xs transition-all text-slate-500 hover:text-slate-700">
              Produtos
            </button>
          </div>
          
          <div class="relative w-full md:max-w-xs">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm">search</span>
            <input type="text" id="itemSearch" oninput="filterGrid()" class="w-full bg-slate-50 border-none rounded-xl py-2 pl-10 pr-4 text-xs font-medium focus:ring-2 focus:ring-[#006573]" placeholder="Buscar item...">
          </div>
        </div>

        <!-- Scrollable Grid Area -->
        <div id="itemGrid" class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4 overflow-y-auto max-h-[500px] pr-2 custom-scrollbar">
          <!-- Populated via JS -->
        </div>
      </div>

      <!-- Settings & Metadata -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-4">
        <h3 class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Configurações do Lançamento</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="relative">
            <select id="parceiroSelect" class="w-full h-11 px-4 pt-2 text-xs font-semibold border-2 border-slate-100 rounded-xl bg-slate-50 focus:ring-0 focus:border-[#006573] outline-none transition-all appearance-none">
              <option value="">Nenhum Parceiro</option>
              <% (parceiros || []).forEach(function(p){ %>
                <option value="<%= p.idParceiro %>" data-credito="<%= p.credito || 0 %>" <%= (typeof parceiro !== 'undefined' && parceiro && parceiro.idParceiro === p.idParceiro) ? 'selected' : '' %>><%= p.nome %></option>
              <% }) %>
            </select>
            <label class="absolute left-3 -top-2 px-1 bg-white text-[9px] font-bold text-slate-400 uppercase">Parceiro / Convênio</label>
          </div>
          <div class="relative">
            <input type="date" name="dataPagamento" id="dataPagamento" class="w-full h-11 px-4 pt-2 text-xs font-semibold border-2 border-slate-100 rounded-xl bg-slate-50 focus:ring-0 focus:border-[#006573] outline-none transition-all" value="<%= new Date().toISOString().split('T')[0] %>">
            <label class="absolute left-3 -top-2 px-1 bg-white text-[9px] font-bold text-slate-400 uppercase">Data do Pagamento</label>
          </div>
        </div>
        <div class="relative">
          <textarea name="observacao" id="observacao" rows="2" class="w-full px-4 py-3 text-xs font-semibold border-2 border-slate-100 rounded-xl bg-slate-50 focus:ring-0 focus:border-[#006573] outline-none transition-all" placeholder="Observações adicionais..."></textarea>
          <label class="absolute left-3 -top-2 px-1 bg-white text-[9px] font-bold text-slate-400 uppercase">Observações</label>
        </div>
      </div>
    </div>

    <!-- Right Column: Cart & Totals -->
    <div class="lg:w-1/3 flex flex-col gap-6 min-h-0">
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 flex flex-col h-full overflow-hidden">
        <!-- Cart Header -->
        <div class="p-6 border-b border-slate-50 flex items-center justify-between bg-slate-50/50">
          <h2 class="font-bold text-slate-800 flex items-center gap-2">
            <span class="material-symbols-outlined text-[#006573]">shopping_basket</span>
            Carrinho
          </h2>
          <span id="cartCount" class="bg-[#006573] text-white text-[10px] font-bold px-2 py-1 rounded-lg">0 ITENS</span>
        </div>

        <!-- Cart Items List -->
        <div id="cartItems" class="flex-1 overflow-y-auto p-4 space-y-3 custom-scrollbar">
          <div id="emptyCartMsg" class="h-full flex flex-col items-center justify-center text-slate-300 py-12">
            <span class="material-symbols-outlined text-4xl mb-2">add_shopping_cart</span>
            <p class="text-xs font-bold uppercase tracking-widest">Carrinho Vazio</p>
          </div>
        </div>

        <!-- Totals Area -->
        <div class="p-6 bg-[#233454] text-white rounded-t-[2rem] space-y-6">
          <div class="space-y-2">
            <div class="flex justify-between text-[10px] text-slate-400 font-bold uppercase tracking-widest">
              <span>Subtotal</span>
              <span>R$ <span id="brutoDisplay">0.00</span></span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">Desconto</span>
              <div class="flex items-center gap-1 border-b border-slate-600 focus-within:border-[#50e1f9] transition-colors">
                <span class="text-[10px] font-bold text-slate-400">R$</span>
                <input type="number" id="descontoDisplay" step="0.01" class="w-20 text-right bg-transparent border-none focus:ring-0 p-0 text-sm font-bold text-[#50e1f9]" value="<%= valorDesconto || '0.00' %>">
              </div>
            </div>
            <div class="pt-4 border-t border-slate-700/50 flex justify-between items-center">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-300">Total Final</span>
              <span class="text-2xl font-black text-[#50e1f9]">R$ <span id="finalDisplay">0.00</span></span>
            </div>
          </div>

          <!-- Payment Grid -->
          <div class="space-y-3">
            <p class="text-[9px] font-bold text-slate-400 uppercase tracking-[0.2em]">Forma de Pagamento</p>
            <div class="grid grid-cols-2 gap-2">
              <% (typeof formasPagamento !== 'undefined' ? formasPagamento : []).forEach(function(f, idx){ 
                let icon = 'payments';
                if(f.toLowerCase().includes('pix')) icon = 'qr_code_2';
                if(f.toLowerCase().includes('cartão')) icon = 'credit_card';
                if(f.toLowerCase().includes('convênio')) icon = 'shield_health';
                const isActive = idx === 0;
              %>
                <button type="button" onclick="setFormaPagamento('<%= f %>', this)" class="pagamento-btn group flex flex-col items-center justify-center p-2 rounded-xl border-2 transition-all <%= isActive ? 'border-[#50e1f9] bg-[#50e1f9]/10 text-[#50e1f9]' : 'border-slate-700 bg-slate-800/50 text-slate-400' %> hover:border-[#50e1f9]/50">
                  <span class="material-symbols-outlined text-lg mb-1 transition-transform group-hover:scale-110"><%= icon %></span>
                  <span class="text-[9px] font-bold uppercase tracking-tighter"><%= f %></span>
                </button>
              <% }) %>
            </div>
          </div>

          <button type="submit" id="submitBtn" class="w-full py-4 bg-[#006573] hover:bg-[#005864] text-white rounded-xl font-black text-sm shadow-xl shadow-black/20 transition-all active:scale-95 flex items-center justify-center gap-2 disabled:opacity-30 disabled:grayscale disabled:cursor-not-allowed" disabled>
            FINALIZAR VENDA
            <span class="material-symbols-outlined text-sm">check_circle</span>
          </button>
        </div>
      </div>
    </div>
  </form>
</div>

<style>
  .custom-scrollbar::-webkit-scrollbar { width: 4px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
</style>

<script>
  // Dados do Backend
  const produtos = <%- JSON.stringify(produtos || []) %>;
  const servicos = <%- JSON.stringify(servicos || []) %>;
  let cart = [];

  // Funções Globais para UI
  function setTipoItem(valor, elemento) {
    document.getElementById('tipoItemValue').value = valor;
    document.querySelectorAll('.tipo-btn').forEach(btn => {
      btn.classList.remove('bg-white', 'text-[#006573]', 'shadow-sm');
      btn.classList.add('text-slate-500');
    });
    elemento.classList.add('bg-white', 'text-[#006573]', 'shadow-sm');
    elemento.classList.remove('text-slate-500');
    
    renderGrid();
  }

  function setFormaPagamento(valor, elemento) {
    document.getElementById('formaPagamentoValue').value = valor;
    document.querySelectorAll('.pagamento-btn').forEach(btn => {
      btn.classList.remove('border-[#50e1f9]', 'bg-[#50e1f9]/10', 'text-[#50e1f9]');
      btn.classList.add('border-slate-700', 'bg-slate-800/50', 'text-slate-400');
    });
    elemento.classList.replace('border-slate-700', 'border-[#50e1f9]');
    elemento.classList.replace('bg-slate-800/50', 'bg-[#50e1f9]/10');
    elemento.classList.replace('text-slate-400', 'text-[#50e1f9]');
  }

  function renderGrid() {
    const grid = document.getElementById('itemGrid');
    const tipo = document.getElementById('tipoItemValue').value;
    const search = document.getElementById('itemSearch').value.toLowerCase();
    const items = tipo === 'produto' ? produtos : servicos;
    
    grid.innerHTML = '';
    
    const filtered = items.filter(it => it.descricao.toLowerCase().includes(search));
    
    if (filtered.length === 0) {
      grid.innerHTML = '<div class="col-span-full py-12 text-center text-slate-400 text-xs font-bold uppercase">Nenhum item encontrado</div>';
      return;
    }

    filtered.forEach(it => {
      const id = tipo === 'produto' ? it.idProduto : it.idServico;
      const card = document.createElement('div');
      card.className = 'bg-slate-50 rounded-xl p-3 flex flex-col gap-2 border border-slate-100 hover:border-[#006573]/30 transition-all group cursor-pointer';
      card.onclick = () => addToCart(it, tipo);
      
      const imgPath = it.imagem && it.imagem !== 'null' ? it.imagem : '/img/placeholder-item.png';
      
      card.innerHTML = `
        <div class="h-24 bg-white rounded-lg overflow-hidden flex items-center justify-center relative mb-1">
          <img src="${imgPath}" class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-500" onerror="this.src='/img/placeholder-item.png'">
        </div>
        <div class="flex-1">
          <h4 class="text-[10px] font-bold text-slate-800 leading-tight mb-1 line-clamp-2">${it.descricao}</h4>
          <p class="text-[#006573] font-black text-xs">R$ ${parseFloat(it.valor).toFixed(2)}</p>
        </div>
        <button type="button" class="w-full py-1 bg-white text-[#006573] border border-[#006573]/20 rounded-lg text-[9px] font-bold hover:bg-[#006573] hover:text-white transition-colors">
          ADICIONAR
        </button>
      `;
      grid.appendChild(card);
    });
  }

  function filterGrid() {
    renderGrid();
  }

  function addToCart(item, tipo) {
    const id = tipo === 'produto' ? item.idProduto : item.idServico;
    
    // Check if already in cart to increment qty
    const existing = cart.find(it => it.id === id && it.tipo === tipo);
    if (existing) {
      existing.quantidade++;
    } else {
      const newItem = {
        id: id,
        descricao: item.descricao,
        valorUnitario: parseFloat(item.valor),
        quantidade: 1,
        tipo: tipo,
        imagem: item.imagem
      };
      
      // Fix for controller: set specific ID fields
      if (tipo === 'produto') newItem.produtoId = id;
      else newItem.servicoId = id;
      
      cart.push(newItem);
    }
    
    renderCart();
    recalc();
  }

  function removeFromCart(index) {
    cart.splice(index, 1);
    renderCart();
    recalc();
  }

  function updateQty(index, delta) {
    cart[index].quantidade += delta;
    if (cart[index].quantidade <= 0) {
      removeFromCart(index);
    } else {
      renderCart();
      recalc();
    }
  }

  function renderCart() {
    const list = document.getElementById('cartItems');
    const msg = document.getElementById('emptyCartMsg');
    const count = document.getElementById('cartCount');
    
    list.innerHTML = '';
    
    if (cart.length === 0) {
      list.appendChild(msg);
      count.textContent = '0 ITENS';
      return;
    }
    
    count.textContent = `${cart.length} ${cart.length === 1 ? 'ITEM' : 'ITENS'}`;
    
    cart.forEach((it, idx) => {
      const itemDiv = document.createElement('div');
      itemDiv.className = 'bg-slate-50 p-3 rounded-xl flex gap-3 group border border-transparent hover:border-slate-200 transition-all';
      
      const imgPath = it.imagem && it.imagem !== 'null' ? it.imagem : '/img/placeholder-item.png';
      
      itemDiv.innerHTML = `
        <div class="w-12 h-12 rounded-lg bg-white flex-shrink-0 overflow-hidden border border-slate-100">
          <img src="${imgPath}" class="w-full h-full object-contain" onerror="this.src='/img/placeholder-item.png'">
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex justify-between items-start gap-2">
            <h4 class="text-[10px] font-bold text-slate-800 truncate">${it.descricao}</h4>
            <button type="button" onclick="removeFromCart(${idx})" class="text-slate-300 hover:text-error transition-colors">
              <span class="material-symbols-outlined text-sm">close</span>
            </button>
          </div>
          <div class="flex items-center justify-between mt-1">
            <div class="flex items-center gap-2 bg-white px-2 py-1 rounded-lg border border-slate-100">
              <button type="button" onclick="updateQty(${idx}, -1)" class="text-slate-400 hover:text-[#006573] font-bold text-xs">-</button>
              <span class="text-[10px] font-bold text-slate-700 w-3 text-center">${it.quantidade}</span>
              <button type="button" onclick="updateQty(${idx}, 1)" class="text-slate-400 hover:text-[#006573] font-bold text-xs">+</button>
            </div>
            <span class="text-[11px] font-black text-[#006573]">R$ ${(it.valorUnitario * it.quantidade).toFixed(2)}</span>
          </div>
        </div>
      `;
      list.appendChild(itemDiv);
    });
  }

  function recalc() {
    const bruto = cart.reduce((total, item) => total + (item.valorUnitario * item.quantidade), 0);
    const desconto = parseFloat(document.getElementById('descontoDisplay').value) || 0;
    const final = Math.max(0, bruto - desconto);

    document.getElementById('brutoDisplay').textContent = bruto.toFixed(2);
    document.getElementById('finalDisplay').textContent = final.toFixed(2);
    
    document.getElementById('itemsField').value = JSON.stringify(cart);
    document.getElementById('valorBrutoField').value = bruto.toFixed(2);
    document.getElementById('valorFinalField').value = final.toFixed(2);
    document.getElementById('submitBtn').disabled = cart.length === 0;
  }

  document.addEventListener('DOMContentLoaded', () => {
    const parceiroSelect = document.getElementById('parceiroSelect');
    const parceiroIdField = document.getElementById('parceiroIdField');
    const descontoDisplay = document.getElementById('descontoDisplay');

    if (parceiroSelect) {
      parceiroSelect.addEventListener('change', () => {
        const selected = parceiroSelect.options[parceiroSelect.selectedIndex];
        const credito = parseFloat(selected.dataset.credito || 0) || 0;
        parceiroIdField.value = selected.value || '';
        descontoDisplay.value = credito.toFixed(2);
        recalc();
      });
    }

    descontoDisplay.addEventListener('input', recalc);
    
    renderGrid();
  });
</script>