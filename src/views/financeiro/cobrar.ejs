<div class="max-w-6xl mx-auto">
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="bg-medical-navy/90 p-6 flex justify-between items-center">
      <div>
        <h2 class="text-xl font-bold text-white flex items-center">
          <span class="material-symbols-outlined mr-2">point_of_sale</span>
          PDV / Checkout
        </h2>
        <p class="text-clinic-100 text-sm">Paciente: <%= paciente.nome %>
        <span class="mx-2 text-slate-300">|</span> 
        <span class="text-clinic-100 text-sm">Ficha <%= (paciente.anamneses && paciente.anamneses.length > 0) ? paciente.anamneses[0].nFicha : 'N/D' %> </span>
        </p>
      </div>
      <div class="text-white text-right">
        <span class="text-xs uppercase opacity-80 block">Data</span>
        <span class="font-bold"><%= new Date().toLocaleDateString('pt-BR') %></span>
      </div>
    </div>

    <form id="cobrarForm" action="/financeiro/registrar" method="POST" class="p-6 sm:p-8 space-y-8">
      <input type="hidden" name="pacienteId" value="<%= paciente.idPaciente %>">
      <input type="hidden" name="parceiroId" id="parceiroIdField" value="<%= (typeof parceiro !== 'undefined' && parceiro) ? parceiro.idParceiro : '' %>">
      <input type="hidden" name="items" id="itemsField" value="[]">
      <input type="hidden" name="valorBruto" id="valorBrutoField" value="0.00">
      <input type="hidden" name="valorFinal" id="valorFinalField" value="0.00">
      <input type="hidden" name="valorDesconto" id="valorDescontoField" value="<%= valorDesconto %>">
      
      <input type="hidden" name="tipoItem" id="tipoItemValue" value="servico">

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <div class="lg:col-span-8 space-y-6">
          
          <div class="space-y-3">
            <label class="text-xs font-extrabold text-slate-500 uppercase tracking-wider ml-1">Tipo de Item</label>
            <div class="flex gap-4">
              <button type="button" onclick="setTipoItem('servico', this)" class="tipo-btn flex-1 flex items-center justify-center p-4 rounded-xl border-2 transition-all shadow-sm border-clinic-500 bg-clinic-50 text-clinic-700 font-bold">
                <span class="material-symbols-outlined mr-2">medical_services</span>
                Serviço
              </button>
              <button type="button" onclick="setTipoItem('produto', this)" class="tipo-btn flex-1 flex items-center justify-center p-4 rounded-xl border-2 transition-all shadow-sm border-slate-100 bg-slate-50 text-slate-600 hover:bg-white font-bold">
                <span class="material-symbols-outlined mr-2">inventory_2</span>
                Produto
              </button>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
            <div class="md:col-span-8 relative">
              <select id="itemSelect" class="peer w-full h-12 px-4 pt-2 text-sm font-semibold border-2 border-slate-200 rounded-xl bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-500 outline-none transition-all appearance-none">
                <option value="">Selecione...</option>
              </select>
              <label class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-500 rounded-full">Item</label>
              <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400">
                <span class="material-symbols-outlined">expand_more</span>
              </div>
            </div>
            <div class="md:col-span-2 relative">
              <input type="number" id="itemQuantidade" class="peer w-full h-12 px-4 text-sm font-semibold border-2 border-slate-200 rounded-xl bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-500 outline-none transition-all" value="1" min="1">
              <label class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-500 rounded-full">Qtd</label>
            </div>
            <div class="md:col-span-2">
              <button type="button" id="addItemBtn" class="w-full h-12 bg-clinic-500 text-white rounded-xl font-bold hover:bg-clinic-600 shadow-md transition-all flex items-center justify-center">
                <span class="material-symbols-outlined">add_shopping_cart</span>
              </button>
            </div>
          </div>
          <!-- Seleciona Parceiro -->
            <div class="relative mb-6">
              <select id="parceiroSelect" class="peer w-full h-12 px-4 pt-2 text-sm font-semibold border-2 border-slate-200 rounded-xl bg-white focus:ring-0 focus:border-clinic-500 outline-none transition-all appearance-none">
                <option value="">Nenhum</option>
                <% (parceiros || []).forEach(function(p){ %>
                  <option value="<%= p.idParceiro %>" data-credito="<%= p.credito || 0 %>"><%= p.nome %></option>
                <% }) %>
              </select>
              <label class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-500 rounded-full">Parceiro</label>
              <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400">
                <span class="material-symbols-outlined">expand_more</span>
              </div>
            </div>
            <div class="space-y-4">
            <label class="text-xs font-extrabold text-slate-500 uppercase tracking-wider ml-1">Informações Adicionais</label>
            <div class="space-y-4">
              <div class="relative">
                <input type="date" name="dataPagamento" id="dataPagamento" class="peer w-full h-12 px-4 pt-2 text-sm font-semibold border-2 border-slate-200 rounded-xl bg-white focus:ring-0 focus:border-clinic-500 outline-none transition-all" value="<%= new Date().toISOString().split('T')[0] %>">
                <label class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-500 rounded-full">Data do Pagamento</label>
              </div>
              <div class="relative">
                <textarea name="observacao" id="observacao" rows="2" class="peer w-full px-4 py-3 text-sm font-semibold border-2 border-slate-200 rounded-xl bg-white focus:ring-0 focus:border-clinic-500 outline-none transition-all placeholder-transparent" placeholder="Observações"></textarea>
                <label for="observacao" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-500 rounded-full">Observações</label>
              </div>
            </div>
          </div>
          <!-- tabela do itens adicionados -->
          <div class="border border-slate-200 rounded-xl overflow-hidden shadow-sm bg-white">
            <table class="w-full text-left border-collapse" id="cartTable">
              <thead>
                <tr class="bg-slate-50 border-b border-slate-200">
                  <th class="px-4 py-3 text-xs font-extrabold text-slate-500 uppercase">Descrição</th>
                  <th class="px-4 py-3 text-xs font-extrabold text-slate-500 uppercase text-center">Tipo</th>
                  <th class="px-4 py-3 text-xs font-extrabold text-slate-500 uppercase text-center">Qtd</th>
                  <th class="px-4 py-3 text-xs font-extrabold text-slate-500 uppercase text-right">Unit R$</th>
                  <th class="px-4 py-3 text-xs font-extrabold text-slate-500 uppercase text-right">Total R$</th>
                  <th class="px-4 py-3 w-10"></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100"></tbody>
            </table>
            <div id="emptyCartMsg" class="p-8 text-center text-slate-400">
              <span class="material-symbols-outlined text-4xl block mb-2">shopping_basket</span>
              Seu carrinho está vazio
            </div>
          </div>
        </div>

        <div class="lg:col-span-4 space-y-6">
          <div id="imagePreview" class="bg-slate-50 border-2 border-dashed border-slate-200 rounded-2xl h-48 flex items-center justify-center overflow-hidden relative group">
            <img id="produtoImage" src="" class="max-w-full max-h-full object-contain p-4 hidden transition-transform group-hover:scale-105" />
            <div id="noImageText" class="text-slate-400 text-center p-4">
              <span class="material-symbols-outlined text-4xl block mb-2">image</span>
              <p class="text-xs font-bold uppercase tracking-widest">Visualização</p>
            </div>
          </div>

          <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 space-y-4">
            <div class="pt-4 space-y-2">
              <div class="flex justify-between items-center text-slate-600">
                <span class="text-sm font-bold uppercase">Subtotal</span>
                <span class="font-mono font-bold">R$ <span id="brutoDisplay">0.00</span></span>
              </div>
              <div class="flex justify-between items-center text-clinic-600">
                <span class="text-sm font-bold uppercase">Desconto</span>
                <input type="number" id="descontoDisplay" step="0.01" class="w-24 text-right bg-transparent border-b-2 border-clinic-200 focus:border-clinic-500 outline-none font-mono font-bold" value="<%= valorDesconto || '0.00' %>">
              </div>
              <div class="pt-4 border-t border-slate-200 flex justify-between items-center">
                <span class="text-lg font-black text-slate-800 uppercase">Total Final</span>
                <span class="text-2xl font-black text-clinic-600 font-mono">R$ <span id="finalDisplay">0.00</span></span>
              </div>
            </div>
          </div>

          <div class="space-y-4">
            <label class="text-xs font-extrabold text-slate-500 uppercase tracking-wider ml-1">Forma de Pagamento</label>
            <input type="hidden" name="formaPagamento" id="formaPagamentoValue" value="<%= (typeof formasPagamento !== 'undefined' && formasPagamento.length > 0) ? formasPagamento[0] : '' %>">
            <div class="grid grid-cols-2 gap-2">
              <% (typeof formasPagamento !== 'undefined' ? formasPagamento : []).forEach(function(f, idx){ 
                let icon = 'payments';
                if(f.toLowerCase().includes('pix')) icon = 'qr_code_2';
                if(f.toLowerCase().includes('cartão')) icon = 'credit_card';
                const activeClass = idx === 0 ? 'border-clinic-500 bg-clinic-50 text-clinic-700' : 'border-slate-100 bg-slate-50 text-slate-600';
              %>
                <button type="button" onclick="setFormaPagamento('<%= f %>', this)" class="pagamento-btn flex items-center p-3 rounded-xl border-2 transition-all text-xs font-bold <%= activeClass %>">
                  <span class="material-symbols-outlined text-lg mr-2"><%= icon %></span>
                  <%= f %>
                </button>
              <% }) %>
            </div>
          </div>

          <button type="submit" id="submitBtn" class="w-full py-4 bg-clinic-500 text-white rounded-xl font-black text-lg hover:bg-clinic-600 shadow-xl transition-all flex items-center justify-center disabled:bg-slate-300" disabled>
            FINALIZAR VENDA
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
  // Dados vindos do Backend
  const produtos = <%- JSON.stringify(produtos || []) %>;
  const servicos = <%- JSON.stringify(servicos || []) %>;
  let cart = [];

  // --- FUNÇÕES GLOBAIS (Devem ficar fora do DOMContentLoaded para o 'onclick' funcionar) ---

  function setTipoItem(valor, elemento) {
    document.getElementById('tipoItemValue').value = valor;
    document.querySelectorAll('.tipo-btn').forEach(btn => {
      btn.classList.replace('border-clinic-500', 'border-slate-100');
      btn.classList.replace('bg-clinic-50', 'bg-slate-50');
      btn.classList.replace('text-clinic-700', 'text-slate-600');
    });
    elemento.classList.replace('border-slate-100', 'border-clinic-500');
    elemento.classList.replace('bg-slate-50', 'bg-clinic-50');
    elemento.classList.replace('text-slate-600', 'text-clinic-700');
    
    // Recarrega a lista de itens (função definida abaixo)
    if (typeof window.populateItemSelect === "function") window.populateItemSelect();
  }

  function setFormaPagamento(valor, elemento) {
    document.getElementById('formaPagamentoValue').value = valor;
    document.querySelectorAll('.pagamento-btn').forEach(btn => {
      btn.classList.remove('border-clinic-500', 'bg-clinic-50', 'text-clinic-700');
      btn.classList.add('border-slate-100', 'bg-slate-50', 'text-slate-600');
    });
    elemento.classList.replace('border-slate-100', 'border-clinic-500');
    elemento.classList.replace('bg-slate-50', 'bg-clinic-50');
    elemento.classList.replace('text-slate-600', 'text-clinic-700');
  }

  // --- LÓGICA DO CARRINHO ---

  document.addEventListener('DOMContentLoaded', () => {
    const itemSelect = document.getElementById('itemSelect');
    const itemQuantidade = document.getElementById('itemQuantidade');
    const addItemBtn = document.getElementById('addItemBtn');
    const cartTableBody = document.querySelector('#cartTable tbody');
    const emptyCartMsg = document.getElementById('emptyCartMsg');
    const brutoDisplay = document.getElementById('brutoDisplay');
    const descontoDisplay = document.getElementById('descontoDisplay');
    const finalDisplay = document.getElementById('finalDisplay');
    const itemsField = document.getElementById('itemsField');
    const valorBrutoField = document.getElementById('valorBrutoField');
    const valorFinalField = document.getElementById('valorFinalField');
    const submitBtn = document.getElementById('submitBtn');
//acho que é aqui
    const parceiroSelect = document.getElementById('parceiroSelect');
    const parceiroIdField = document.getElementById('parceiroIdField');

    if (parceiroSelect) {
      parceiroSelect.addEventListener('change', () => {
        const selected = parceiroSelect.options[parceiroSelect.selectedIndex];
        
        // Pega o valor do crédito do atributo data que colocamos no HTML
        const credito = parseFloat(selected.dataset.credito || 0) || 0;
        
        // Atualiza o ID do parceiro para o envio do formulário
        parceiroIdField.value = selected.value || '';
        
        // Define o valor do desconto e recalcula o total final
        descontoDisplay.value = credito.toFixed(2);
        
        // Chama a função de recalcular que já criamos
        recalc();
      });
    }
    //definiçoes de parceiro fim
    
    window.populateItemSelect = function() {
      const currentTipo = document.getElementById('tipoItemValue').value;
      const list = currentTipo === 'produto' ? produtos : servicos;
      
      itemSelect.innerHTML = '<option value="">Selecione...</option>';
      list.forEach(it => {
        const id = currentTipo === 'produto' ? it.idProduto : it.idServico;
        const opt = document.createElement('option');
        opt.value = id;
        opt.dataset.valor = it.valor;
        opt.dataset.imagem = it.imagem || '';
        opt.textContent = `${it.descricao} - R$ ${parseFloat(it.valor).toFixed(2)}`;
        itemSelect.appendChild(opt);
      });
      showPreview();
    };

    function showPreview() {
      const sel = itemSelect.options[itemSelect.selectedIndex];
      const img = document.getElementById('produtoImage');
      const txt = document.getElementById('noImageText');
      if (sel && sel.dataset.imagem && sel.dataset.imagem !== 'null') {
        img.src = sel.dataset.imagem;
        img.classList.remove('hidden');
        txt.classList.add('hidden');
      } else {
        img.classList.add('hidden');
        txt.classList.remove('hidden');
      }
    }

    function recalc() {
      const bruto = cart.reduce((total, item) => total + (item.valorUnitario * item.quantidade), 0);
      const desconto = parseFloat(descontoDisplay.value) || 0;
      const final = Math.max(0, bruto - desconto);

      brutoDisplay.textContent = bruto.toFixed(2);
      finalDisplay.textContent = final.toFixed(2);
      
      itemsField.value = JSON.stringify(cart);
      valorBrutoField.value = bruto.toFixed(2);
      valorFinalField.value = final.toFixed(2);
      submitBtn.disabled = cart.length === 0;
    }

    addItemBtn.addEventListener('click', () => {
      const selectedOption = itemSelect.options[itemSelect.selectedIndex];
      if (!selectedOption.value) return;

      const tipo = document.getElementById('tipoItemValue').value;
      cart.push({
        descricao: selectedOption.textContent.split(' - ')[0],
        quantidade: parseInt(itemQuantidade.value),
        valorUnitario: parseFloat(selectedOption.dataset.valor),
        tipo: tipo,
        id: selectedOption.value
      });

      renderCart();
      recalc();
      itemSelect.selectedIndex = 0;
      showPreview();
    });

    window.removeCartItem = (idx) => {
      cart.splice(idx, 1);
      renderCart();
      recalc();
    };

    function renderCart() {
      cartTableBody.innerHTML = '';
      emptyCartMsg.classList.toggle('hidden', cart.length > 0);
      cart.forEach((it, idx) => {
        cartTableBody.innerHTML += `
          <tr>
            <td class="px-4 py-3">${it.descricao}</td>
            <td class="text-center"><span class="px-2 py-1 rounded-full text-[10px] font-bold uppercase ${it.tipo === 'produto' ? 'bg-amber-100' : 'bg-blue-100'}">${it.tipo}</span></td>
            <td class="text-center">${it.quantidade}</td>
            <td class="text-right">${it.valorUnitario.toFixed(2)}</td>
            <td class="text-right">${(it.quantidade * it.valorUnitario).toFixed(2)}</td>
            <td class="text-right"><button type="button" onclick="removeCartItem(${idx})">X</button></td>
          </tr>`;
      });
    }

    itemSelect.addEventListener('change', showPreview);
    descontoDisplay.addEventListener('input', recalc);
    window.populateItemSelect();
  });
</script>