  <title>Ficha do Paciente - <%= paciente?.nome || 'Paciente' %></title>

  <div class="header">
    <h1>Ficha do Paciente</h1>
    <div class="small">Ficha em tamanho A5 - Impressão</div>
  </div>

  <div class="section">
    <div class="row"><span class="label">Ficha:</span> <%= paciente?.nFicha || 'N/D' %></div>
    <div class="row"><span class="label">Nome:</span> <%= paciente?.nome || 'N/D' %></div>
    <div class="row"><span class="label">CPF:</span> <%= paciente?.cpf || 'N/D' %></div>
    <div class="row"><span class="label">Nascimento:</span> <%= paciente?.dataNascFormatada || 'N/D' %> <span class="small">(<%= typeof idadePaciente !== 'undefined' && idadePaciente !== null ? idadePaciente + ' anos' : 'N/D' %>)</span></div>
    <div class="row"><span class="label">Endereço:</span> <%= [paciente?.endereco, paciente?.numero].filter(Boolean).join(', ') || 'N/D' %></div>
    <div class="row"><span class="label">Bairro / Cidade:</span> <%= [paciente?.bairro, paciente?.cidade].filter(Boolean).join(' / ') || 'N/D' %></div>
    <div class="row"><span class="label">Contato:</span> <%= paciente?.celular || 'N/D' %></div>
  </div>

  <div class="section">
    <h3 style="margin:6px 0">Anamnese</h3>
    <% const ultimaAnamnese = anamneses && anamneses.length > 0 ? anamneses[0] : null; %>
    <% if (ultimaAnamnese) { %>
      <div class="row"><span class="label">Motivo:</span> <%= ultimaAnamnese.motivo || 'N/D' %></div>
      <div class="row"><span class="label">Último Exame:</span> <%= ultimaAnamnese.ultimoExame || 'N/D' %></div>
      <div class="row"><span class="label">Sintomas:</span> <%= ultimaAnamnese.sintomas || 'N/D' %></div>
      <div class="row"><span class="label">Trauma/Cirurgia:</span> <%= ultimaAnamnese.trauma || 'N/D' %></div>
      <div class="two-col">
        <div class="col">
          <div class="row"><span class="label">Usa Óculos:</span> <%= ultimaAnamnese.usuarioOculos ? 'Sim' : 'Não' %></div>
          <div class="row"><span class="label">Usou LC:</span> <%= ultimaAnamnese.usuarioLC ? 'Sim' : 'Não' %></div>
          <div class="row"><span class="label">Diabetes:</span> <%= ultimaAnamnese.dm ? 'Sim' : 'Não' %></div>
          <div class="row"><span class="label">HAS:</span> <%= ultimaAnamnese.has ? 'Sim' : 'Não' %></div>
        </div>
        <div class="col">
          <div class="row"><span class="label">Glaucoma:</span> <%= ultimaAnamnese.glauc ? 'Sim' : 'Não' %></div>
          <div class="row"><span class="label">DM na Família:</span> <%= ultimaAnamnese.dmFam || 'N/D' %></div>
          <div class="row"><span class="label">HAS na Família:</span> <%= ultimaAnamnese.hasFam || 'N/D' %></div>
          <div class="row"><span class="label">Glaucoma Família:</span> <%= ultimaAnamnese.glaucFam || 'N/D' %></div>
        </div>
      </div>

      <div class="row"><span class="label">Remédios:</span> <%= ultimaAnamnese.remedio || 'N/D' %></div>

      <h4 style="margin:8px 0">Exames / Medidas</h4>
      <div class="two-col small">
        <div class="col">
          <div class="row"><span class="label">Esf OD:</span> <%= ultimaAnamnese.esfOD || 'N/D' %></div>
          <div class="row"><span class="label">Cil OD:</span> <%= ultimaAnamnese.cilOD || 'N/D' %></div>
          <div class="row"><span class="label">Eixo OD:</span> <%= ultimaAnamnese.eixoOD || 'N/D' %></div>
          <div class="row"><span class="label">AV s/ correção OD:</span> <%= ultimaAnamnese.avSCOD || 'N/D' %></div>
        </div>
        <div class="col">
          <div class="row"><span class="label">Esf OE:</span> <%= ultimaAnamnese.esfOE || 'N/D' %></div>
          <div class="row"><span class="label">Cil OE:</span> <%= ultimaAnamnese.cilOE || 'N/D' %></div>
          <div class="row"><span class="label">Eixo OE:</span> <%= ultimaAnamnese.eixoOE || 'N/D' %></div>
          <div class="row"><span class="label">AV s/ correção OE:</span> <%= ultimaAnamnese.avSCOE || 'N/D' %></div>
        </div>
      </div>

      <div class="row"><span class="label">Adição:</span> <%= ultimaAnamnese.adicao || 'N/D' %></div>
      <div class="row obs"><span class="label">Observações:</span> <div style="display:inline-block; width:72%"><%= ultimaAnamnese.obsGerais || 'N/D' %></div></div>
    <% } else { %>
      <div class="row">Nenhuma anamnese registrada para este paciente.</div>
    <% } %>
  </div>

  <div style="margin-top:12px; font-size:10px; color:#666">Gerado em <%= new Date().toLocaleString('pt-BR') %></div>

    <style>
    @page { size: A5; margin: 10mm; }
  </style>
