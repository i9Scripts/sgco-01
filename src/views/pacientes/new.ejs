<div>
  <form action="/pacientes" method="post">
    <input type="hidden" name="idConsultorio" value="<%= consultorio && consultorio.idConsultorio %>" />
    <div class="row form-group">
      <div class="col-md-3 mb-3">
        <input
          type="number"
          class="form-control"
          id="nFicha"
          name="nFicha"
          value="<%= formData && formData.nFicha %>"
          maxlength="20"
          autofocus
        />
        <label for="nFicha">Nº da Ficha</label>
      </div>
      <div class="col-md-3 mb-3">
        <input
          type="text"
          class="form-control"
          id="dataAtend"
          name="dataAtend"
          value="<%= formData && formData.dataAtend %>"
          oninput="mascaraData(this)"
          maxlength="20"
        /> 
        <label for="dataAtend">Data Atendimento</label>
      </div>
    </div>
    <div class="row form-group">
      <div class="col-md-3 mb-3">
        <input
          type="text"
          class="form-control <%= messages.errors && messages.errors.cpf ? 'is-invalid' : '' %>"
          id="cpf"
          oninput="mascaraCpf(this)"
          name="cpf"
          value="<%= formData && formData.cpf %>"
          maxlength="14"
        />
        <label for="cpf">CPF</label>
      </div>
      <div class="col-md-7 mb-3">
        <input
          type="text"
          class="form-control <%= messages.errors && messages.errors.nome ? 'is-invalid' : '' %>"
          id="nome"
          name="nome"
          value="<%= formData && formData.nome %>"
          required
          maxlength="60"
        />
        <label for="nome">Nome</label>
      </div>
      <div class="col-md-2 mb-3">
        <input
          type="text"
          class="form-control <%= messages.errors && messages.errors.profissao ? 'is-invalid' : '' %>"
          id="profissao"
          name="profissao"
          value="<%= formData && formData.profissao %>"
          required
          maxlength="30"
        />
        <label for="profissao">Profissão</label>
      </div>
    </div>
    <div class="row form-group">
      <div class="col-md-3 mb-3">
        <input
          type="text"
          class="form-control <%= messages.errors && messages.errors.dataNasc ? 'is-invalid' : '' %>"
          id="dataNasc"
          name="dataNasc"
          value="<%= formData && formData.dataNasc %>"
          oninput="mascaraData(this); this.value = this.value.replace(/[^0-9/]/g, '')"
          onblur="calcularIdadeFrontend(this)"
          maxlength="10"
        />
        <label for="dataNasc">Data Nascimento</label>
      </div>
      <div class="col-md-2 mb-3">
        <input
          type="number"
          class="form-control <%= messages.errors && messages.errors.idade ? 'is-invalid' : '' %>"
          id="idade"
          name="idade"
          value="<%= formData && formData.idade %>"
          readonly
          required
          min="1"
        />
        <label for="idade">Idade</label>
      </div>
      <div class="col-md-7 mb-3">
        <input
          type="text"
          class="form-control <%= messages.errors && messages.errors.responsavel ? 'is-invalid' : '' %>"
          id="responsavel"
          name="responsavel"
          value="<%= formData && formData.responsavel %>"
          maxlength="60"
        />
        <label for="responsavel">Responsável</label>
      </div>
    </div>

    <div class="row form-group">
      <div class="col-md-2 mb-3">
        <input
          type="text"
          class="form-control <%= messages.errors && messages.errors.cep ? 'is-invalid' : '' %>"
          id="cep"
          oninput="mascaraCep(this)"
          onblur="encontraCep(this)"
          name="cep"
          value="<%= formData && formData.cep %>"
          maxlength="9"
        />
        <label for="cep">CEP</label>
      </div>
      <div class="col-md-5 mb-3">
        <input
          type="text"
          class="form-control <%= messages.errors && messages.errors.endereco ? 'is-invalid' : '' %>"
          id="endereco"
          name="endereco"
          value="<%= formData && formData.endereco %>"
          required
          maxlength="60"
        />
        <label for="endereco">Endereço</label>
      </div>
      <div class="col-md-2 mb-3">
        <input
          type="number"
          class="form-control <%= messages.errors && messages.errors.numero ? 'is-invalid' : '' %>"
          id="numero"
          name="numero"
          value="<%= formData && formData.numero %>"
          required
          min="1"
        />
        <label for="numero">Número</label>
      </div>
      <div class="col-md-3 mb-3">
        <input
          type="text"
          class="form-control <%= messages.errors && messages.errors.complemento ? 'is-invalid' : '' %>"
          id="complemento"
          name="complemento"
          value="<%= formData && formData.complemento %>"
          maxlength="30"
        />
        <label for="complemento">Complemento</label>
      </div>
    </div>

    <div class="row form-group">
      <div class="col-md-4 mb-3">
        <input
          type="text"
          class="form-control <%= messages.errors && messages.errors.bairro ? 'is-invalid' : '' %>"
          id="bairro"
          name="bairro"
          value="<%= formData && formData.bairro %>"
          required
          maxlength="60"
        />
        <label for="bairro">Bairro</label>
      </div>
      <div class="col-md-5 mb-3">
        <input
          type="text"
          class="form-control <%= messages.errors && messages.errors.cidade ? 'is-invalid' : '' %>"
          id="cidade"
          name="cidade"
          value="<%= formData && formData.cidade %>"
          required
          maxlength="30"
        />
        <label for="cidade">Cidade</label>
      </div>
      <div class="col-md-3 mb-3">
        <input
          type="text"
          class="form-control <%= messages.errors && messages.errors.celular ? 'is-invalid' : '' %>"
          oninput="mascaraCelular(this)"
          id="celular"
          name="celular"
          value="<%= formData && formData.celular %>"
          required
          maxlength="15"
        />
        <label for="celular">Celular</label>
      </div>
    </div>

    <div class="fixed-buttons">
      <button class="btn btn-success btn-hover-outline" type="submit" title="Salvar alterações">
        <span class="material-symbols-outlined icon-btn">save</span> Salvar
      </button>
    </div>
  </form>
<!-- Cadastrar novo parceiro ou procurar na lista para vincular o parceiro ao paciente -->
</div>
<!-- inserir data de hoje -->
 <script>
  window.addEventListener('load', function() {
    const inputData = document.getElementById('dataAtend');
    
    // Só preenche se o campo estiver vazio (evita sobrescrever dados do banco)
    if (!inputData.value || inputData.value === "undefined") {
      const hoje = new Date();
      const dia = String(hoje.getDate()).padStart(2, '0');
      const mes = String(hoje.getMonth() + 1).padStart(2, '0'); // Janeiro é 0
      const ano = hoje.getFullYear();
      
      const dataFormatada = `${dia}/${mes}/${ano}`;
      inputData.value = dataFormatada;
    }
  });
</script>

