<div class="max-w-5xl mx-auto">
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">

    <form action="/pacientes" method="post" class="p-6 sm:p-8 space-y-6">
      <input type="hidden" name="idConsultorio" value="<%= consultorio && consultorio.idConsultorio %>" />

      <!-- Ficha e Data -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
        <div class="md:col-span-3 relative">
          <input
            type="text"
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent"
            id="dataAtend"
            name="dataAtend"
            placeholder="Data Atendimento"
            value="<%= formData && formData.dataAtend %>"
            oninput="mascaraData(this)"
            maxlength="20"
            autofocus
          />
          <label for="dataAtend" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
            Data Atendimento
          </label>
        </div>
      </div>

      <!-- CPF, Nome, Profissão -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
        <div class="md:col-span-3 relative">
          <input
            type="text"
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent <%= messages.errors && messages.errors.cpf ? 'border-red-500' : '' %>"
            id="cpf"
            oninput="mascaraCpf(this)"
            name="cpf"
            placeholder="CPF"
            value="<%= formData && formData.cpf %>"
            maxlength="14"
          />
          <label for="cpf" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
            CPF
          </label>
        </div>
        <div class="md:col-span-6 relative">
          <input
            type="text"
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent <%= messages.errors && messages.errors.nome ? 'border-red-500' : '' %>"
            id="nome"
            name="nome"
            placeholder="Nome Completo"
            value="<%= formData && formData.nome %>"
            required
            maxlength="60"
          />
          <label for="nome" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
            Nome Completo
          </label>
        </div>
        <div class="md:col-span-3 relative">
          <input
            type="text"
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent <%= messages.errors && messages.errors.profissao ? 'border-red-500' : '' %>"
            id="profissao"
            name="profissao"
            placeholder="Profissão"
            value="<%= formData && formData.profissao %>"
            required
            maxlength="30"
          />
          <label for="profissao" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
            Profissão
          </label>
        </div>
      </div>

      <!-- Data Nasc, Idade, Responsável -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
        <div class="md:col-span-3 relative">
          <input
            type="text"
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent <%= messages.errors && messages.errors.dataNasc ? 'border-red-500' : '' %>"
            id="dataNasc"
            name="dataNasc"
            placeholder="Data Nascimento"
            value="<%= formData && formData.dataNasc %>"
            oninput="mascaraData(this); this.value = this.value.replace(/[^0-9/]/g, '')"
            onblur="calcularIdadeFrontend(this)"
            maxlength="10"
          />
          <label for="dataNasc" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
            Data Nascimento
          </label>
        </div>
        <div class="md:col-span-2 relative">
          <input
            type="number"
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-200 outline-none cursor-not-allowed placeholder-transparent"
            id="idade"
            name="idade"
            placeholder="Idade"
            value="<%= formData && formData.idade %>"
            readonly
            required
            min="1"
          />
          <label for="idade" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
            Idade
          </label>
        </div>
        <div class="md:col-span-7 relative">
          <input
            type="text"
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent"
            id="responsavel"
            name="responsavel"
            placeholder="Responsável"
            value="<%= formData && formData.responsavel %>"
            maxlength="60"
          />
          <label for="responsavel" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
            Responsável
          </label>
        </div>
      </div>

      <!-- CEP, Endereço, Número, Complemento -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
        <div class="md:col-span-2 relative">
          <input
            type="text"
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent"
            id="cep"
            oninput="mascaraCep(this)"
            onblur="encontraCep(this)"
            name="cep"
            placeholder="CEP"
            value="<%= formData && formData.cep %>"
            maxlength="9"
          />
          <label for="cep" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
            CEP
          </label>
        </div>
        <div class="md:col-span-5 relative">
          <input
            type="text"
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent"
            id="endereco"
            name="endereco"
            placeholder="Endereço"
            value="<%= formData && formData.endereco %>"
            required
            maxlength="60"
          />
          <label for="endereco" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
            Endereço
          </label>
        </div>
        <div class="md:col-span-2 relative">
          <input
            type="number"
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent"
            id="numero"
            name="numero"
            placeholder="Nº"
            value="<%= formData && formData.numero %>"
            required
            min="1"
          />
          <label for="numero" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
            Nº
          </label>
        </div>
        <div class="md:col-span-3 relative">
          <input
            type="text"
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent"
            id="complemento"
            name="complemento"
            placeholder="Complemento"
            value="<%= formData && formData.complemento %>"
            maxlength="30"
          />
          <label for="complemento" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
            Complemento
          </label>
        </div>
      </div>

      <!-- Bairro, Cidade, Celular -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
        <div class="md:col-span-4 relative">
          <input
            type="text"
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent"
            id="bairro"
            name="bairro"
            placeholder="Bairro"
            value="<%= formData && formData.bairro %>"
            required
            maxlength="60"
          />
          <label for="bairro" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
            Bairro
          </label>
        </div>
        <div class="md:col-span-5 relative">
          <input
            type="text"
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent"
            id="cidade"
            name="cidade"
            placeholder="Cidade"
            value="<%= formData && formData.cidade %>"
            required
            maxlength="30"
          />
          <label for="cidade" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
            Cidade
          </label>
        </div>
        <div class="md:col-span-3 relative">
          <input
            type="text"
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent"
            oninput="mascaraCelular(this)"
            id="celular"
            name="celular"
            placeholder="Celular"
            value="<%= formData && formData.celular %>"
            required
            maxlength="15"
          />
          <label for="celular" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full border border-clinic-500 md:border-none">
            Celular
          </label>
        </div>
      </div>

      <div class="pt-6 flex justify-end space-x-4">
        <a href="/pacientes" class="px-6 py-2 rounded-lg border-2 border-slate-300 text-slate-600 font-bold hover:bg-slate-100 transition-all no-underline">
          Cancelar
        </a>
        <button class="px-8 py-2 bg-clinic-500 text-white rounded-lg font-bold hover:bg-clinic-600 shadow-md transition-all flex items-center" type="submit">
          <span class="material-symbols-outlined mr-2">save</span> Salvar Paciente
        </button>
      </div>
    </form>
  </div>
</div>

<script defer src="/js/validaNficha.js"></script>
