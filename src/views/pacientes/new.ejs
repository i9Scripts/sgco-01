<div>
  <form action="/pacientes" method="post">
    <input type="hidden" name="idConsultorio" value="<%= consultorio && consultorio.idConsultorio %>" />
    <div class="row form-group">
      <div class="row">
        <div class="col-md-6 mb-3">
          <input type="text" class="form-control <%= messages.errors && messages.errors.nome ? 'is-invalid' : '' %>" id="nome" name="nome" value="<%= formData && formData.nome %>" tabindex="1" autofocus required maxlength="60" />
          <label for="nome">Nome</label>
        </div>
        <div class="col-md-3 mb-3">
          <input type="text" class="form-control <%= messages.errors && messages.errors.dataNasc ? 'is-invalid' : '' %>" id="dataNasc" name="dataNasc" value="<%= formData && formData.dataNasc %>" tabindex="2" onkeyup="mascaraData(this, event)" onblur="calcularIdadeFrontend(this)" maxlength="10" />
          <label for="dataNasc">Data Nascimento</label>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-md-2 mb-3">
        <input type="number" class="form-control <%= messages.errors && messages.errors.idade ? 'is-invalid' : '' %>" id="idade" name="idade" value="<%= formData && formData.idade %>" readonly required min="1" />
        <label for="idade">Idade</label>
      </div>
      <div class="col-md-10 mb-3">
        <input type="text" class="form-control <%= messages.errors && messages.errors.responsavel ? 'is-invalid' : '' %>" id="responsavel" name="responsavel" value="<%= formData && formData.responsavel %>" tabindex="3" maxlength="60" />
        <label for="responsavel">Responsável</label>
      </div>
    </div>
    <div class="row form-group">
      <div class="col-md-3 mb-3">
        <input type="text" class="form-control <%= messages.errors && messages.errors.celular ? 'is-invalid' : '' %>" oninput="mascaraCelular(this)" id="celular" name="celular" value="<%= formData && formData.celular %>" tabindex="4" required maxlength="15" />
        <label for="celular">Celular</label>
      </div>
      <div class="col-md-2 mb-3">
        <input type="text" class="form-control <%= messages.errors && messages.errors.cep ? 'is-invalid' : '' %>" id="cep" oninput="mascaraCep(this)" onblur="encontraCep(this)" name="cep" value="<%= formData && formData.cep %>" tabindex="5" maxlength="9" />
        <label for="cep">CEP</label>
      </div>
      <div class="col-md-7 mb-3">
        <input type="text" class="form-control <%= messages.errors && messages.errors.endereco ? 'is-invalid' : '' %>" id="endereco" name="endereco" value="<%= formData && formData.endereco %>" tabindex="6" required maxlength="60" />
        <label for="endereco">Endereço</label>
      </div>
      <div class="col-md-2 mb-3">
        <input type="number" class="form-control <%= messages.errors && messages.errors.numero ? 'is-invalid' : '' %>" id="numero" name="numero" value="<%= formData && formData.numero %>" tabindex="7" required min="1" />
        <label for="numero">Número</label>
      </div>
      <div class="col-md-4 mb-3">
        <input type="text" class="form-control <%= messages.errors && messages.errors.bairro ? 'is-invalid' : '' %>" id="bairro" name="bairro" value="<%= formData && formData.bairro %>" tabindex="8" required maxlength="60" />
        <label for="bairro">Bairro</label>
      </div>
      <div class="col-md-6 mb-3">
        <input type="text" class="form-control <%= messages.errors && messages.errors.cidade ? 'is-invalid' : '' %>" id="cidade" name="cidade" value="<%= formData && formData.cidade %>" tabindex="9" required maxlength="30" />
        <label for="cidade">Cidade</label>
      </div>
    </div>

    <div class="row form-group">
      <div class="col-md-3 mb-3">
        <input type="text" class="form-control <%= messages.errors && messages.errors.cpf ? 'is-invalid' : '' %>" id="cpf" oninput="mascaraCpf(this)" name="cpf" value="<%= formData && formData.cpf %>" tabindex="10" maxlength="14" />
        <label for="cpf">CPF</label>
      </div>
      <div class="col-md-2 mb-3">
        <input type="text" class="form-control <%= messages.errors && messages.errors.profissao ? 'is-invalid' : '' %>" id="profissao" name="profissao" value="<%= formData && formData.profissao %>" tabindex="11" required maxlength="30" />
        <label for="profissao">Profissão</label>
      </div>
    </div>

    <div class="form-group mb-2">
      <button class="btn btn-outline-primary" type="submit" tabindex="12">Adicionar Paciente</button>
    </div>
  </form>
</div>