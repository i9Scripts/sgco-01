<div>
  <form action="/pacientes/<%= paciente.idPaciente %>?_method=PUT" method="post">
    <div class="row form-group">
      <div class="row">
        <div class="col-md-6 mb-3">
          <input
            type="text"
            class="form-control <%= messages.errors && messages.errors.nome ? 'is-invalid' : '' %>"
            id="nome"
            name="nome"
            value="<%= paciente.nome %>"
            tabindex="1"
            autofocus
            required
            maxlength="60"
          />
          <label for="nome">Nome</label>
        </div>
        <div class="col-md-3 mb-3">
          <input
            type="text"
            class="form-control <%= messages.errors && messages.errors.dataNasc ? 'is-invalid' : '' %>"
            id="dataNasc"
            name="dataNasc"
            value="<%= paciente.dataNasc %>"
            tabindex="2"
            onkeyup="mascaraData(this, event)"
            onblur="calcularIdadeFrontend()"
            maxlength="10"
          />
          <label for="dataNasc">Data Nascimento</label>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-md-2 mb-3">
        <input
          type="number"
          class="form-control <%= messages.errors && messages.errors.idade ? 'is-invalid' : '' %>"
          id="idade"
          name="idade"
          value="<%= paciente.idade %>"
          required
          min="1"
        />
        <label for="idade">Idade</label>
      </div>
      <div class="col-md-10 mb-3">
        <input
          type="text"
          class="form-control <%= messages.errors && messages.errors.responsavel ? 'is-invalid' : '' %>"
          id="responsavel"
          name="responsavel"
          value="<%= paciente.responsavel %>"
          tabindex="3"
          maxlength="60"
        />
        <label for="responsavel">Responsável</label>
      </div>
    </div>
    <div class="row form-group">
      <div class="col-md-3 mb-3">
        <input
          type="text"
          class="form-control <%= messages.errors && messages.errors.celular ? 'is-invalid' : '' %>"
          oninput="mascaraCelular(this)"
          id="celular"
          name="celular"
          value="<%= paciente.celular %>"
          tabindex="4"
          required
          maxlength="15"
        />
        <label for="celular">Celular</label>
      </div>
      <div class="col-md-2 mb-3">
        <input
          type="text"
          class="form-control <%= messages.errors && messages.errors.cep ? 'is-invalid' : '' %>"
          id="cep"
          oninput="mascaraCep(this)"
          onblur="encontraCep(this)"
          name="cep"
          value="<%= paciente.cep %>"
          tabindex="5"
          maxlength="9"
        />
        <label for="cep">CEP</label>
      </div>
      <div class="col-md-7 mb-3">
        <input
          type="text"
          class="form-control <%= messages.errors && messages.errors.endereco ? 'is-invalid' : '' %>"
          id="endereco"
          name="endereco"
          value="<%= paciente.endereco %>"
          tabindex="6"
          required
          maxlength="60"
        />
        <label for="endereco">Endereço</label>
      </div>
      <div class="col-md-2 mb-3">
        <input
          type="number"
          class="form-control <%= messages.errors && messages.errors.numero ? 'is-invalid' : '' %>"
          id="numero"
          name="numero"
          value="<%= paciente.numero %>"
          tabindex="7"
          required
          min="1"
        />
        <label for="numero">Número</label>
      </div>
      <div class="col-md-4 mb-3">
        <input
          type="text"
          class="form-control <%= messages.errors && messages.errors.bairro ? 'is-invalid' : '' %>"
          id="bairro"
          name="bairro"
          value="<%= paciente.bairro %>"
          tabindex="8"
          required
          maxlength="30"
        />
        <label for="bairro">Bairro</label>
      </div>
      <div class="col-md-6 mb-3">
        <input
          type="text"
          class="form-control <%= messages.errors && messages.errors.cidade ? 'is-invalid' : '' %>"
          id="cidade"
          name="cidade"
          value="<%= paciente.cidade %>"
          tabindex="9"
          required
          maxlength="30"
        />
        <label for="cidade">Cidade</label>
      </div>
    </div>

    <div class="row form-group">
      <div class="col-md-3 mb-3">
        <input
          type="text"
          class="form-control <%= messages.errors && messages.errors.cpf ? 'is-invalid' : '' %>"
          id="cpf"
          oninput="mascaraCpf(this)"
          name="cpf"
          value="<%= paciente.cpf %>"
          tabindex="10"
          maxlength="14"
        />
        <label for="cpf">CPF</label>
      </div>
      <div class="col-md-2 mb-3">
        <input
          type="text"
          class="form-control <%= messages.errors && messages.errors.profissao ? 'is-invalid' : '' %>"
          id="profissao"
          name="profissao"
          value="<%= paciente.profissao %>"
          tabindex="11"
          required
          maxlength="30"
        />
        <label for="profissao">Profissão</label>
      </div>
    </div>

    <div class="form-group mb-2">
      <button type="submit" class="btn btn-primary">Salvar</button>
    </div>
  </form>
</div>
