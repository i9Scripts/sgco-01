<div class="max-w-6xl mx-auto">
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <form class="p-6 sm:p-8 space-y-8" action="/pacientes/<%= paciente.idPaciente %>?_method=PUT" method="post">
      
      <!-- Seção: Identificação da Ficha -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-slate-50 p-6 rounded-xl border border-slate-200">
        <div class="relative">
          <input 
            type="number" 
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-slate-300 rounded-lg bg-white focus:border-clinic-500 focus:ring-0 outline-none transition-all placeholder-transparent" 
            id="nFicha" 
            name="nFicha" 
            value="<%= paciente.nFicha %>" 
            placeholder="Nº Ficha"
            autofocus 
          />
          <label for="nFicha" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-500 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
            Nº Ficha
          </label>
        </div>
        <div class="relative">
          <input 
            type="text" 
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-slate-300 rounded-lg bg-white focus:border-clinic-500 focus:ring-0 outline-none transition-all placeholder-transparent" 
            id="dataAtend" 
            name="dataAtend" 
            value="<%= paciente.dataAtend %>" 
            placeholder="Data de Atendimento"
          />
          <label for="dataAtend" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-500 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
            Data de Atendimento
          </label>
        </div>
      </div>

      <!-- Seção: Dados Pessoais -->
      <div class="space-y-6">
        <h3 class="text-lg font-bold text-slate-800 flex items-center gap-2">
          <span class="material-symbols-outlined text-clinic-600">person</span>
          Dados Pessoais
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
          <div class="md:col-span-3 relative">
            <input 
              type="text" 
              class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
              id="cpf" 
              oninput="mascaraCpf(this)" 
              name="cpf" 
              value="<%= paciente.cpf %>" 
              placeholder="CPF"
              maxlength="14" 
            />
            <label for="cpf" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
              CPF
            </label>
          </div>
          <div class="md:col-span-6 relative">
            <input 
              type="text" 
              class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
              id="nome" 
              name="nome" 
              value="<%= paciente.nome %>" 
              placeholder="Nome Completo"
              required 
              maxlength="60" 
            />
            <label for="nome" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
              Nome Completo
            </label>
          </div>
          <div class="md:col-span-3 relative">
            <input 
              type="text" 
              class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
              id="profissao" 
              name="profissao" 
              value="<%= paciente.profissao %>" 
              placeholder="Profissão"
              required 
              maxlength="30" 
            />
            <label for="profissao" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
              Profissão
            </label>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
          <div class="md:col-span-3 relative">
            <input 
              type="text" 
              class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
              id="dataNasc" 
              name="dataNasc" 
              value="<%= paciente.dataNascFormatada %>" 
              onkeyup="mascaraData(this, event)" 
              onblur="calcularIdadeFrontend(this)" 
              placeholder="Data Nascimento"
              maxlength="10" 
            />
            <label for="dataNasc" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
              Data Nascimento
            </label>
          </div>
          <div class="md:col-span-2 relative">
            <input 
              type="number" 
              class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
              id="idade" 
              name="idade" 
              value="<%= idadePaciente %>" 
              placeholder="Idade"
              required 
              min="1" 
            />
            <label for="idade" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
              Idade
            </label>
          </div>
          <div class="md:col-span-7 relative">
            <input 
              type="text" 
              class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
              id="responsavel" 
              name="responsavel" 
              value="<%= paciente.responsavel %>" 
              placeholder="Responsável"
              maxlength="60" 
            />
            <label for="responsavel" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
              Responsável (se menor)
            </label>
          </div>
        </div>
      </div>

      <!-- Seção: Endereço e Contato -->
      <div class="space-y-6">
        <h3 class="text-lg font-bold text-slate-800 flex items-center gap-2">
          <span class="material-symbols-outlined text-clinic-600">location_on</span>
          Endereço e Contato
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
          <div class="md:col-span-3 relative">
            <input 
              type="text" 
              class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
              id="cep" 
              oninput="mascaraCep(this)" 
              onblur="encontraCep(this)" 
              name="cep" 
              value="<%= paciente.cep %>" 
              placeholder="CEP"
              maxlength="9" 
            />
            <label for="cep" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
              CEP
            </label>
          </div>
          <div class="md:col-span-6 relative">
            <input 
              type="text" 
              class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
              id="endereco" 
              name="endereco" 
              value="<%= paciente.endereco %>" 
              placeholder="Endereço"
              required 
              maxlength="60" 
            />
            <label for="endereco" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
              Endereço
            </label>
          </div>
          <div class="md:col-span-3 relative">
            <input 
              type="number" 
              class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
              id="numero" 
              name="numero" 
              value="<%= paciente.numero %>" 
              placeholder="Número"
              required 
              min="1" 
            />
            <label for="numero" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
              Número
            </label>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
          <div class="md:col-span-4 relative">
            <input 
              type="text" 
              class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
              id="complemento" 
              name="complemento" 
              value="<%= paciente.complemento %>" 
              placeholder="Complemento"
            />
            <label for="complemento" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
              Complemento
            </label>
          </div>
          <div class="md:col-span-4 relative">
            <input 
              type="text" 
              class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
              id="bairro" 
              name="bairro" 
              value="<%= paciente.bairro %>" 
              placeholder="Bairro"
              required 
              maxlength="30" 
            />
            <label for="bairro" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
              Bairro
            </label>
          </div>
          <div class="md:col-span-4 relative">
            <input 
              type="text" 
              class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
              id="cidade" 
              name="cidade" 
              value="<%= paciente.cidade %>" 
              placeholder="Cidade"
              required 
              maxlength="30" 
            />
            <label for="cidade" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
              Cidade
            </label>
          </div>
        </div>

        <div class="relative max-w-md">
          <input 
            type="text" 
            class="peer w-full h-10 px-4 text-sm font-semibold border-2 border-clinic-500 rounded-lg bg-slate-50 focus:bg-white focus:ring-0 focus:border-clinic-600 outline-none transition-all placeholder-transparent" 
            oninput="mascaraCelular(this)" 
            id="celular" 
            name="celular" 
            value="<%= paciente.celular %>" 
            placeholder="Celular"
            required 
            maxlength="15" 
          />
          <label for="celular" class="absolute left-3 -top-2.5 px-2 bg-white text-xs font-extrabold text-slate-700 transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:text-slate-700 peer-placeholder-shown:top-2.5 peer-focus:-top-2.5 peer-focus:text-xs peer-focus:text-clinic-600 rounded-full">
            Celular (WhatsApp)
          </label>
        </div>
      </div>

      <div class="pt-8 flex justify-end">
        <button class="px-8 py-3 bg-clinic-500 text-white rounded-lg font-bold hover:bg-clinic-600 shadow-lg shadow-clinic-200 transition-all flex items-center gap-2" type="submit">
          <span class="material-symbols-outlined">save</span> 
          Salvar Alterações
        </button>
      </div>
    </form>
  </div>
</div>
