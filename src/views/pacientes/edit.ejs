<div>
  <form action="/pacientes/<%= paciente.idPaciente %>?_method=PUT" method="post">
    <div class="row form-group">
      <div class="col-md-3 mb-3">
        <input type="text" class="form-control <%= messages.errors && messages.errors.cpf ? 'is-invalid' : '' %>" id="cpf" oninput="mascaraCpf(this)" name="cpf" value="<%= paciente.cpf %>" autofocus maxlength="14" />
        <label for="cpf">CPF</label>
      </div>
      <div class="col-md-7 mb-3">
        <input type="text" class="form-control <%= messages.errors && messages.errors.nome ? 'is-invalid' : '' %>" id="nome" name="nome" value="<%= paciente.nome %>" required maxlength="60" />
        <label for="nome">Nome</label>
      </div>
      <div class="col-md-2 mb-3">
        <input type="text" class="form-control <%= messages.errors && messages.errors.profissao ? 'is-invalid' : '' %>" id="profissao" name="profissao" value="<%= paciente.profissao %>" required maxlength="30" />
        <label for="profissao">Profissão</label>
      </div>
    </div>

    <div class="row form-group">
      <div class="col-md-3 mb-3">
        <input type="text" class="form-control <%= messages.errors && messages.errors.dataNasc ? 'is-invalid' : '' %>" id="dataNasc" name="dataNasc" value="<%= paciente.dataNascFormatada %>" readonly onkeyup="mascaraData(this, event)" onblur="calcularIdadeFrontend()" maxlength="10" />
        <label for="dataNasc">Data Nascimento</label>
      </div>
      <div class="col-md-2 mb-3">
        <input type="number" class="form-control <%= messages.errors && messages.errors.idade ? 'is-invalid' : '' %>" id="idade" name="idade" value="<%= paciente.idade %>" required min="1" />
        <label for="idade">Idade</label>
      </div>
      <div class="col-md-7 mb-3">
        <input type="text" class="form-control <%= messages.errors && messages.errors.responsavel ? 'is-invalid' : '' %>" id="responsavel" name="responsavel" value="<%= paciente.responsavel %>" maxlength="60" />
        <label for="responsavel">Responsável</label>
      </div>
    </div>
    <div class="row form-group">
      <div class="col-md-2 mb-3">
        <input type="text" class="form-control <%= messages.errors && messages.errors.cep ? 'is-invalid' : '' %>" id="cep" oninput="mascaraCep(this)" onblur="encontraCep(this)" name="cep" value="<%= paciente.cep %>" Maxlength="9" />
        <label for="cep">CEP</label>
      </div>
      <div class="col-md-5 mb-3">
        <input type="text" class="form-control <%= messages.errors && messages.errors.endereco ? 'is-invalid' : '' %>" id="endereco" name="endereco" value="<%= paciente.endereco %>" required maxlength="60" />
        <label for="endereco">Endereço</label>
      </div>
      <div class="col-md-2 mb-3">
        <input type="number" class="form-control <%= messages.errors && messages.errors.numero ? 'is-invalid' : '' %>" id="numero" name="numero" value="<%= paciente.numero %>" required min="1" />
        <label for="numero">Número</label>
      </div>
      <div class="col-md-3 mb-3">
        <input type="text" class="form-control <%= messages.errors && messages.errors.complemento? 'is-invalid' : '' %>" id="complemento" name="complemento" value="<%= paciente.complemento%>" min="1" />
        <label for="complemento">Complemento</label>
      </div>
    </div>
    <div class="row form-group">
      <div class="col-md-4 mb-3">
        <input type="text" class="form-control <%= messages.errors && messages.errors.bairro ? 'is-invalid' : '' %>" id="bairro" name="bairro" value="<%= paciente.bairro %>" required maxlength="30" />
        <label for="bairro">Bairro</label>
      </div>
      <div class="col-md-5 mb-3">
        <input type="text" class="form-control <%= messages.errors && messages.errors.cidade ? 'is-invalid' : '' %>" id="cidade" name="cidade" value="<%= paciente.cidade %>" required maxlength="30" />
        <label for="cidade">Cidade</label>
      </div>
      <div class="col-md-3 mb-3">
        <input type="text" class="form-control <%= messages.errors && messages.errors.celular ? 'is-invalid' : '' %>" oninput="mascaraCelular(this)" id="celular" name="celular" value="<%= paciente.celular %>" required maxlength="15" />
        <label for="celular">Celular</label>
      </div>
    </div>

    <div class="fixed-buttons">
      <button class="btn btn-success btn-hover-outline" type="submit" title="Salvar alterações">
        <span class="material-symbols-outlined icon-btn">save</span> Salvar
      </button>
    </div>
  </form>
</div>