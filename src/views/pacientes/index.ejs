<div>
  <!-- Formulário de busca -->
  <form action="/pacientes/search" method="get" class="mb-3">
    <div class="input-group">
      <input type="text" name="query" class="form-control" placeholder="Buscar por nome ou CPF" required />
      <button class="btn btn-outline-secondary" type="submit">Buscar</button>
    </div>
  </form>
  <!-- Lista de pacientes -->
  <% if (pacientes && pacientes.length > 0) { %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Nome</th>
        <th>Responsável</th>
        <th>Ações</th>
        <th>Anamnese</th>
      </tr>
    </thead>
    <tbody>
      <% pacientes.forEach(paciente => { %>
      <tr>
        <td><%= paciente.nome %></td>
        <td><%= paciente.responsavel %></td>
        <td>
          <!-- Botão para adicionar novo paciente -->
          <a href="/pacientes/new" class="btn btn-sm btn-primary btn-hover-outline" title="Adicionar Novo Paciente">
            <span class="material-symbols-outlined icon-btn">person_add</span>
          </a>
          <!-- Botão para visualizar paciente -->
          <a href="/pacientes/<%= paciente.idPaciente %>" class="btn btn-sm btn-info" title="Ver Paciente">
            <span class="material-symbols-outlined icon-btn">visibility</span>
          </a>
          <!-- Botão para editar paciente -->
          <a href="/pacientes/<%= paciente.idPaciente %>/edit" class="btn btn-sm btn-warning" title="Editar paciente">
            <span class="material-symbols-outlined icon-btn">edit</span>
          </a>
          <!-- Botão para excluir paciente -->
          <form action="/pacientes/<%= paciente.idPaciente %>?_method=DELETE" method="post" class="d-inline" title="Excluir paciente">
            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Tem certeza que deseja excluir?')">
              <span class="material-symbols-outlined icon-btn">delete</span>
            </button>
          </form>
        </td>

        <!-- Anamnese -->
        <td>
          <% if (paciente.anamneses && paciente.anamneses.length > 0) { 
            const anamnese = paciente.anamneses[0]; %>
          <span class="badge bg-success">Registrada</span>
          <a href="/pacientes/<%= paciente.idPaciente %>/selecionar" class="btn btn-sm btn-success" title="Nova anamnese">
            <span class="material-symbols-outlined icon-btn">check</span>
          </a>
          <a href="/anamneses/<%= anamnese.idAnam %>" class="btn btn-sm btn-info" title="Ver anamnese">
            <span class="material-symbols-outlined icon-btn">visibility</span>
          </a>
          <a href="/anamneses/<%= anamnese.idAnam %>/edit" class="btn btn-sm btn-warning" title="Editar anamnese">
            <span class="material-symbols-outlined icon-btn">edit</span>
          </a>
          <% } else { %>
          <span class="badge bg-secondary">Não registrada</span>
          <a href="/pacientes/<%= paciente.idPaciente %>/selecionar" class="btn btn-sm btn-primary" title="Criar nova anamnese">
            <span class="material-symbols-outlined icon-btn">add</span>
          </a>
          <% } %>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } else { %>
  <p class="text-white">Nenhum Paciente encontrado.</p>
  <a class="btn btn-secondary btn-hover-outline" href="/pacientes/new" title="Voltar">
    <span class="material-symbols-outlined icon-btn">arrow_back</span> Voltar
  </a>
  <% } %>
</div>