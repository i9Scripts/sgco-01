
  <!-- Cabeçalho e Busca -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="flex-1 max-w-2xl">
      <form action="/pacientes/search" method="get" class="relative group">
        <input
          type="text"
          name="query"
          placeholder="Buscar por nome ou CPF (3 primeiros números)..."
          class="w-full h-12 pl-12 pr-4 text-sm font-semibold border-2 border-slate-200 rounded-xl bg-white focus:ring-0 focus:border-clinic-500 outline-none transition-all shadow-sm"
        />
        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-clinic-500 transition-colors">
          search
        </span>
        <button type="submit" class="hidden">Buscar</button>
      </form>
    </div>

    <div class="flex items-center gap-3">
      <a
        href="/pacientes/new"
        class="h-12 px-6 bg-clinic-500 text-white rounded-xl font-bold hover:bg-clinic-600 shadow-lg shadow-clinic-100 transition-all flex items-center justify-center whitespace-nowrap group"
      >
        <span class="material-symbols-outlined mr-2 group-hover:scale-110 transition-transform">person_add</span>
        Novo Paciente
      </a>
    </div>
  </div>

  <!-- Lista de Pacientes -->
  <div class="bg-white/80 rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <% if (pacientes && pacientes.length > 0) { %>
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200">
            <th class="px-6 py-4 text-xs font-extrabold text-slate-500 uppercase tracking-wider">Ficha</th>
            <th class="px-6 py-4 text-xs font-extrabold text-slate-500 uppercase tracking-wider">Paciente</th>
            <th class="px-6 py-4 text-xs font-extrabold text-slate-500 uppercase tracking-wider">Responsável</th>
            <th class="px-6 py-4 text-xs font-extrabold text-slate-500 uppercase tracking-wider text-center">Ações</th>
            <th class="px-6 py-4 text-xs font-extrabold text-slate-500 uppercase tracking-wider text-center">Anamnese</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% pacientes.forEach(paciente => { %>
          <tr class="hover:bg-slate-50/50 transition-colors">
            <td class="px-6 py-4">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-black bg-slate-100 text-slate-600 border border-slate-200">
                <%= (paciente.anamneses && paciente.anamneses.length > 0) ? paciente.anamneses[0].nFicha : 'N/D' %>
              </span>
            </td>
            <td class="px-6 py-4">
              <p class="text-sm font-bold text-slate-800"><%= paciente.nome %></p>
            </td>
            <td class="px-6 py-4">
              <p class="text-sm text-slate-600 font-medium"><%= paciente.responsavel || '---' %></p>
            </td>
            <td class="px-6 py-4">
              <div class="flex items-center justify-center gap-2">
                <!-- Visualizar -->
                <button
                  onclick="abrirModalGenerico('/pacientes/<%= paciente.idPaciente %>', 'Dados do Paciente')"
                  class="p-2 text-slate-400 hover:text-clinic-600 hover:bg-clinic-50 rounded-lg transition-all"
                  title="Ver Paciente"
                >
                  <span class="material-symbols-outlined text-[20px]">visibility</span>
                </button>
                <!-- Editar -->
                <button
                  onclick="abrirModalGenerico('/pacientes/<%= paciente.idPaciente %>/edit', 'Editar Paciente')"
                  class="p-2 text-slate-400 hover:text-amber-600 hover:bg-amber-50 rounded-lg transition-all"
                  title="Editar Paciente"
                >
                  <span class="material-symbols-outlined text-[20px]">edit</span>
                </button>
                <!-- Fila de Espera -->
                <form action="/pacientes/<%= paciente.idPaciente %>/adicionar-fila?_method=PUT" method="post" class="inline">
                  <button
                    type="submit"
                class="p-2 text-slate-400 hover:text-emerald-600 hover:bg-emerald-50 rounded-lg transition-all"
                    title="Adicionar à Fila"
                  >
                    <span class="material-symbols-outlined text-[20px]">playlist_add</span>
                  </button>
                </form>
              </div>
            </td>

            <td class="px-6 py-4">
              <div class="flex items-center justify-center gap-2">
                <% if (paciente.anamneses && paciente.anamneses.length > 0) { const anamnese = paciente.anamneses[0]; %>
                <span class="hidden md:inline-flex items-center px-2 py-1 rounded-md text-[10px] font-black uppercase bg-emerald-100 text-emerald-700 border border-emerald-200">
                  Registrada
                </span>
                <div class="flex gap-1">
                  <% if (userRole === 'profissional') { %>
                  <button
                    onclick="abrirModalGenerico('/anamneses/<%= anamnese.idAnam %>', 'Ver Anamnese')"
                    class="p-1.5 text-emerald-600 hover:bg-emerald-50 rounded-md transition-colors"
                    title="Ver Anamnese"
                  >
                    <span class="material-symbols-outlined text-[18px]">visibility</span>
                  </button>
                  <button
                    onclick="abrirModalGenerico('/anamneses/<%= anamnese.idAnam %>/edit', 'Editar Anamnese')"
                    class="p-1.5 text-amber-600 hover:bg-amber-50 rounded-md transition-colors"
                    title="Editar Anamnese"
                  >
                    <span class="material-symbols-outlined text-[18px]">edit</span>
                  </button>
                  <% } %>
                  <!-- Todos os perfis podem cadastrar nova anamnese -->
                  <button
                    onclick="abrirModalGenerico('/anamneses/new?idPaciente=<%= paciente.idPaciente %>', 'Nova Anamnese')"
                    class="p-1.5 text-clinic-600 hover:bg-clinic-50 rounded-md transition-colors"
                    title="Nova Anamnese"
                  >
                    <span class="material-symbols-outlined text-[18px]">add_circle</span>
                  </button>
                </div>
                <% } else { %>
                <span class="hidden md:inline-flex items-center px-2 py-1 rounded-md text-[10px] font-black uppercase bg-slate-100 text-slate-500 border border-slate-200">
                  Pendente
                </span>
                <a
                  href="/anamneses/new?idPaciente=<%= paciente.idPaciente %>"
                  class="p-1.5 text-clinic-600 hover:bg-clinic-50 rounded-md transition-colors"
                  title="Criar Nova Anamnese"
                >
                  <span class="material-symbols-outlined text-[18px]">add_circle</span>
                </a>
                <% } %>
              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="p-12 text-center">
      <div class="bg-slate-50 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
        <span class="material-symbols-outlined text-3xl text-slate-300">person_search</span>
      </div>
      <h3 class="text-lg font-bold text-slate-800">Nenhum paciente encontrado</h3>
      <p class="text-slate-500 text-sm mb-6">Tente ajustar sua busca ou cadastre um novo paciente.</p>
      <button
        onclick="abrirModalGenerico('/pacientes/new','Novo Paciente')"
        class="inline-flex items-center px-6 py-2.5 bg-clinic-500 text-white rounded-xl font-bold hover:bg-clinic-600 shadow-lg shadow-clinic-100 transition-all"
      >
        <span class="material-symbols-outlined mr-2">person_add</span>
        Cadastrar Primeiro Paciente
      </button>
    </div>
    <% } %>
  </div>

<%- include('../partials/_modal') %>
