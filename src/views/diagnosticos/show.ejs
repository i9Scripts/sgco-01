<link rel="stylesheet" href="/css/receita.css">
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script src="/js/style.js"></script>
<div>
  <div class="print-container">
    <div class="pagina">
      <div class="container">
        <div class="cabeca">
          <div class="logos">
            <img src="/img/LogotipoAC.png" alt="Logotipo Consultório" class="logo-consultorio" style="height: auto; width: 80px;"/>
          </div>
          <div class="header-info">
            <p>Cuidados Primários da Visão</p>
          </div>
        </div>

        <div class="main">
          <div class="patient-details">
            <div class="dados">
              <div class="nome"><strong>Paciente:</strong> <span class="nome-val"><%= diagnostico.paciente?.nome || 'N/D' %></span></div>
              <div class="dados-row">
                <div class="idade"><strong>Idade:</strong> <%= diagnostico.paciente?.idade || 'N/D' %></div>
                <div class="data"><strong>Data:</strong> <%= diagnostico && diagnostico.paciente && diagnostico.paciente.dataAtend ? (new Date(diagnostico.paciente.dataAtend)).toLocaleDateString() : (new Date()).toLocaleDateString() %></div>
              </div>
            </div>
          </div>

          <div class="prescription">
            <img src="/img/receita_eixo.jpg">
            <h3>Prescrição de Lentes</h3>
            <table>
              <thead>
                <tr>
                  <th></th>
                  <th>ESF</th>
                  <th>CIL</th>
                  <th>EIXO</th>
                  <th>ADIÇÃO</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Longe OD</strong></td>
                  <td><%= diagnostico.esfOD || '0,00' %></td>
                  <td><%= diagnostico.cilOD || '0,00' %></td>
                  <td><%= diagnostico.eixoOD || '000' %></td>
                  <td><%= diagnostico.adicao || '0,00'  %></td>
                  <!-- espaço para dnp -->
                </tr>
                <tr>
                  <td><strong>Longe OE</strong></td>
                  <td><%= diagnostico.esfOE || '0,00' %></td>
                  <td><%= diagnostico.cilOE || '0,00' %></td>
                  <td><%= diagnostico.eixoOE || '000' %></td>
                  <td></td>
                </tr>
                <tr>
                  <td><strong>Perto OD</strong></td>
                  <td>|______|</td>
                  <td>|______|</td>
                  <td>|______|</td>
                  <td></td>
                </tr>
                <tr>
                  <td><strong>Perto OE</strong></td>
                  <td>|______|</td>
                  <td>|______|</td>
                  <td>|______|</td>
                  <td></td>
                </tr>
              </tbody>
            </table>
            <p style="min-height:140px;"><strong><%= diagnostico ? diagnostico.descricao : '' %> </strong></p>
          </div>
          <div class="assinatura">
            <hr />
            <p></strong> <%= diagnostico.profissional?.nome || 'N/D' %> </p>
          </div>
        </div>
        <div class="rodape">
          <div>
            <img src="/img/optometria_simbolo-420x420.png" alt="Logotipo Optometria" class="logo-optometria" />
          </div>
          <div>
            <p><strong><%= diagnostico.consultorio?.nome || 'N/D' %> | Whatsapp </strong> <%= diagnostico.consultorio?.celular || 'N/D' %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Botões de Ação (fora do print-container) -->
  <div class="pt-6 border-t border-slate-100 flex flex-wrap justify-start no-print gap-3 bg-white p-4">
    <a href="/profissionais/dashboard" class="px-6 py-2 bg-medical-navy text-white rounded-lg font-bold hover:bg-slate-300 transition-all flex items-center whitespace-nowrap">
      <span style="margin-right:8px">◀</span> Voltar
    </a>

    <button type="button" onclick="window.print()" class="px-6 py-2 bg-medical-navy text-white rounded-lg font-bold hover:bg-slate-300 transition-all flex items-center whitespace-nowrap">
      <span style="margin-right:8px">🖨️</span> Imprimir
    </button>

    <a href="/diagnosticos/<%= diagnostico.idDiagnostico %>/edit" class="px-6 py-2 bg-medical-navy text-white rounded-lg font-bold hover:bg-slate-300 transition-all flex items-center whitespace-nowrap">
      <span style="margin-right:8px">✏️</span> Editar
    </a>
  </div>
</div>