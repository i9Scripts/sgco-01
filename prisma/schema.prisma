generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Agendamento {
  id            Int      @id @default(autoincrement())
  dataHora      DateTime
  pacienteId    Int?
  nome          String?  @db.VarChar(60)
  parceiroId    Int?
  consultorioId Int
  status        String   @default("Agendado") @db.VarChar(191)
  observacao    String?  @db.VarChar(255)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  paciente    Paciente?   @relation(fields: [pacienteId], references: [idPaciente])
  parceiro    Parceiro?   @relation(fields: [parceiroId], references: [idParceiro])
  consultorio Consultorio @relation(fields: [consultorioId], references: [idConsultorio])

  @@index([pacienteId])
  @@index([parceiroId])
  @@index([consultorioId])
}

model Consultorio {
  idConsultorio Int           @id @default(autoincrement())
  nome          String        @db.VarChar(60)
  endereco      String        @db.VarChar(60)
  cpf           String?       @db.VarChar(15)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  bairro        String        @db.VarChar(60)
  celular       String        @db.VarChar(15)
  cep           String?       @db.VarChar(9)
  cidade        String        @db.VarChar(30)
  numero        Int
  profissao     String        @db.VarChar(30)
  responsavel   String?       @db.VarChar(60)
  numeroSerie   String        @unique @db.VarChar(36)
  complemento   String?       @db.VarChar(30)
  agendamentos  Agendamento[]
  anamneses     Anamnese[]
  consultas     Consulta[]
  diagnosticos  Diagnostico[]
  pacientes     Paciente[]
  pagamentos    Pagamento[]
  parceiros     Parceiro[]
  produtos      Produto[]
  servicos      Servico[]
  profissionais Profissional[]
  usuarios      User[]
  lancamentos   LancamentoFinanceiro[]
  lancamentoItems LancamentoItem[]

  @@index([cpf])
  @@index([nome])
  @@index([responsavel])
}

model User {
  idUser            Int           @id @default(autoincrement())
  nome              String        @db.VarChar(60)
  email             String        @unique @db.VarChar(30)
  celular           String        @db.VarChar(15)
  password          String        @db.VarChar(255)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  isActive          Boolean       @default(true)
  consultorioId     Int
  email_verified_at DateTime?     @db.Timestamp(0)
  remember_token    String?       @db.VarChar(100)
  consultorio       Consultorio   @relation(fields: [consultorioId], references: [idConsultorio])
  profissional      Profissional?

  @@index([consultorioId], map: "User_consultorioId_fkey")
}

model Paciente {
  idPaciente    Int                    @id @default(autoincrement())
  dataAtend     String?                @db.VarChar(10)
  nome          String                 @db.VarChar(60)
  responsavel   String?                @db.VarChar(60)
  dataNasc      DateTime               @db.Date
  idade         Int
  celular       String                 @db.VarChar(15)
  cep           String?                @db.VarChar(9)
  endereco      String                 @db.VarChar(60)
  numero        Int
  bairro        String                 @db.VarChar(60)
  cidade        String                 @db.VarChar(30)
  cpf           String?                @db.VarChar(15)
  profissao     String                 @db.VarChar(30)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  consultorioId Int
  complemento   String?                @db.VarChar(30)
  agendamentos  Agendamento[]
  anamneses     Anamnese[]
  consultas     Consulta[]
  diagnosticos  Diagnostico[]
  consultorio   Consultorio            @relation(fields: [consultorioId], references: [idConsultorio])
  lancamentos   LancamentoFinanceiro[]
  parceiro      Parceiro?              @relation(fields: [parceiroId], references: [idParceiro])
  parceiroId    Int?
  status        String?                @db.VarChar(20)

  @@index([nome])
  @@index([cpf])
  @@index([responsavel])
  @@index([celular])
  @@index([dataAtend])
  @@index([createdAt])
  @@index([consultorioId], map: "Paciente_consultorioId_fkey")
  @@index([parceiroId])
}

model Profissional {
  idProfissional Int           @id @default(autoincrement())
  nome           String        @db.VarChar(60)
  especialidade  String        @db.VarChar(30)
  celular        String?       @db.VarChar(15)
  consultorioId  Int
  userId         Int?          @unique
  user           User?         @relation(fields: [userId], references: [idUser])
  cboo           String        @db.VarChar(10)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  consultas      Consulta[]
  consultorio    Consultorio   @relation(fields: [consultorioId], references: [idConsultorio])
  diagnosticos   Diagnostico[]

  @@index([nome])
  @@index([celular])
  @@index([userId])
  @@index([cboo])
  @@index([consultorioId], map: "Profissional_consultorioId_fkey")
}

model Parceiro {
  idParceiro        Int                    @id @default(autoincrement())
  nome              String                 @db.VarChar(60)
  endereco          String?                @db.VarChar(60)
  telefone          String                 @db.VarChar(15)
  contato           String?                @db.VarChar(30)
  credito           Decimal?
  desconto          Decimal                @default(0.00) @db.Decimal(10, 2)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  consultorioId     Int
  agendamentos      Agendamento[]
  consultasParceiro Consulta[]             @relation("ParceiroConsulta")
  consultorio       Consultorio            @relation(fields: [consultorioId], references: [idConsultorio])
  lancamentos       LancamentoFinanceiro[]
  pacientes         Paciente[]

  @@index([nome])
  @@index([consultorioId], map: "Parceiro_consultorioId_fkey")
}

enum TipoLancamento {
  RECEITA
  DESPESA
}

enum StatusFinanceiro {
  PAGO
  PENDENTE
  CANCELADO
  ATRASADO
}

model LancamentoFinanceiro {
  idLancamento   Int              @id @default(autoincrement())
  tipo           TipoLancamento
  status         StatusFinanceiro @default(PENDENTE)
  valorTotal     Decimal          @db.Decimal(10, 2)
  dataVencimento DateTime         @default(now())
  categoria      String?          @db.VarChar(50)
  observacao     String?          @db.VarChar(255)
  
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  consultaId     Int?             @unique
  consulta       Consulta?        @relation(fields: [consultaId], references: [idConsulta])
  
  pacienteId     Int?
  paciente       Paciente?        @relation(fields: [pacienteId], references: [idPaciente])

  parceiroId     Int?
  parceiro       Parceiro?        @relation(fields: [parceiroId], references: [idParceiro])

  consultorioId  Int
  consultorio    Consultorio      @relation(fields: [consultorioId], references: [idConsultorio])

  items          LancamentoItem[]
  pagamentos     Pagamento[]
  
  produto          Produto?       @relation(fields: [produtoIdProduto], references: [idProduto])
  produtoIdProduto Int?

  @@index([pacienteId])
  @@index([parceiroId])
  @@index([consultorioId])
}

model Anamnese {
  idAnam               Int         @id @default(autoincrement())
  nFicha               Int?
  motivo               String      @db.VarChar(100)
  ultimoExame          String      @db.VarChar(20)
  usuarioOculos        Boolean
  usuarioLC            Boolean
  trauma               String?     @db.VarChar(50)
  dm                   Boolean
  has                  Boolean
  glauc                Boolean
  dmFam                String?     @db.VarChar(50)
  hasFam               String?     @db.VarChar(50)
  glaucFam             String?     @db.VarChar(50)
  sintomas             String?     @db.VarChar(50)
  remedio              String?     @db.VarChar(50)
  cefaleia             String?     @db.VarChar(100)
  antecedentesPessoais String?     @db.VarChar(100)
  obsGerais            String?     @db.VarChar(255)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  pacienteId           Int
  consultorioId        Int
  adicao               String?     @db.VarChar(6)
  cilOD                String?     @db.VarChar(6)
  cilOE                String?     @db.VarChar(6)
  eixoOD               String?     @db.VarChar(4)
  avSCOD               String?     @db.VarChar(8)
  eixoOE               String?     @db.VarChar(4)
  esfOD                String?     @db.VarChar(6)
  esfOE                String?     @db.VarChar(6)
  avSCOE               String?     @db.VarChar(8)
  consultorio          Consultorio @relation(fields: [consultorioId], references: [idConsultorio])
  paciente             Paciente    @relation(fields: [pacienteId], references: [idPaciente])
  consultas            Consulta[]

  @@index([consultorioId], map: "Anamnese_consultorioId_fkey")
  @@index([pacienteId], map: "Anamnese_pacienteId_fkey")
}

model Diagnostico {
  idDiagnostico  Int          @id @default(autoincrement())
  esfOD          String       @db.VarChar(6)
  cilOD          String?      @db.VarChar(6)
  eixoOD         String?      @db.VarChar(4)
  avFinalOD      String?      @db.VarChar(8)
  esfOE          String       @db.VarChar(6)
  cilOE          String?      @db.VarChar(6)
  eixoOE         String?      @db.VarChar(4)
  avFinalOE      String?      @db.VarChar(8)
  adicao         String?      @db.VarChar(6)
  descricao      String?      @db.VarChar(255)
  minhasOBS      String?      @db.VarChar(255)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  pacienteId     Int
  profissionalId Int
  consultorioId  Int
  consultas      Consulta[]
  consultorio    Consultorio  @relation(fields: [consultorioId], references: [idConsultorio])
  paciente       Paciente     @relation(fields: [pacienteId], references: [idPaciente])
  profissional   Profissional @relation(fields: [profissionalId], references: [idProfissional])

  @@index([consultorioId], map: "Diagnostico_consultorioId_fkey")
  @@index([pacienteId], map: "Diagnostico_pacienteId_fkey")
  @@index([profissionalId], map: "Diagnostico_profissionalId_fkey")
}

model Consulta {
  idConsulta           Int              @id @default(autoincrement())
  statusConsulta       StatusConsulta   @default(Agendada)
  
  naFila               Boolean          @default(false)
  statusFila           String?

  dataVenciPagParceiro DateTime?        @db.Date
  valorAPagarParceiro  Decimal?
  
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  
  pacienteId           Int
  profissionalId       Int?
  anamneseId           Int              @unique
  diagnosticoId        Int?             @unique
  parceiroId           Int?
  consultorioId        Int
  
  anamnese             Anamnese         @relation(fields: [anamneseId], references: [idAnam])
  consultorio          Consultorio      @relation(fields: [consultorioId], references: [idConsultorio])
  diagnostico          Diagnostico?     @relation(fields: [diagnosticoId], references: [idDiagnostico])
  paciente             Paciente         @relation(fields: [pacienteId], references: [idPaciente])
  parceiro             Parceiro?        @relation("ParceiroConsulta", fields: [parceiroId], references: [idParceiro])
  profissional         Profissional?    @relation(fields: [profissionalId], references: [idProfissional])
  
  lancamentoFinanceiro LancamentoFinanceiro?

  @@index([pacienteId])
  @@index([profissionalId])
  @@index([parceiroId])
  @@index([naFila])
  @@index([consultorioId], map: "Consulta_consultorioId_fkey")
}

model Pagamento {
  idPagamento      Int             @id @default(autoincrement())
  valorPago        Decimal         @db.Decimal(10, 2)
  dataPagamento    DateTime        @default(now())
  formaPagamento   FormaPagamento
  observacao       String?         @db.VarChar(255)
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  
  lancamentoId     Int
  consultorioId    Int
  
  lancamento       LancamentoFinanceiro @relation(fields: [lancamentoId], references: [idLancamento])
  consultorio      Consultorio          @relation(fields: [consultorioId], references: [idConsultorio])
  
  lancamentoItem   LancamentoItem? @relation(fields: [lancamentoItemId], references: [idLancamentoItem])
  lancamentoItemId Int?

  @@index([lancamentoId], map: "Pagamento_lancamentoId_fkey")
  @@index([consultorioId], map: "Pagamento_consultorioId_fkey")
}

model Produto {
  idProduto             Int                    @id @default(autoincrement())
  descricao             String                 @db.VarChar(100)
  valor                 Decimal                @db.Decimal(10, 2)
  imagem                String?
  quantidade            Int
  consultorioId         Int
  consultorio           Consultorio            @relation(fields: [consultorioId], references: [idConsultorio])
  lancamentos           LancamentoItem[]
  lancamentoFinanceiros LancamentoFinanceiro[]

  @@index([consultorioId], map: "Produto_consultorioId_fkey")
}

model Servico {
  idServico     Int      @id @default(autoincrement())
  descricao     String   @db.VarChar(100)
  valor         Decimal  @db.Decimal(10, 2)
  imagem        String?
  consultorioId Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  consultorio   Consultorio      @relation(fields: [consultorioId], references: [idConsultorio])
  lancamentos   LancamentoItem[]

  @@index([consultorioId])
}

model LancamentoItem {
  idLancamentoItem Int      @id @default(autoincrement())
  quantidade       Int      @default(1)
  valorUnitario    Decimal  @db.Decimal(10, 2)
  produtoId        Int?
  servicoId        Int?
  lancamentoId     Int
  consultorioId    Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  produto     Produto?             @relation(fields: [produtoId], references: [idProduto])
  servico     Servico?             @relation(fields: [servicoId], references: [idServico])
  lancamento  LancamentoFinanceiro @relation(fields: [lancamentoId], references: [idLancamento])
  consultorio Consultorio          @relation(fields: [consultorioId], references: [idConsultorio])
  pagamentos  Pagamento[]

  @@index([produtoId])
  @@index([servicoId])
  @@index([lancamentoId])
  @@index([consultorioId])
}

model migrations {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  migration String @db.VarChar(255)
  batch     Int
}

enum StatusConsulta {
  Agendada
  EmAtendimento
  Finalizada
  Cancelada
  NaoCompareceu
  Reagendado
}

enum StatusPagamento {
  Pago
  Pendente
  Cancelado
}

enum FormaPagamento {
  Dinheiro
  CartaoCredito
  CartaoDebito
  PIX
  Cheque
  Convenio
  Voucher
}
